FUNCTION ZCORE_FM_GET_PROFILE.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_NUMBER)
*"     REFERENCE(I_KIND)
*"     REFERENCE(I_BUKRS) TYPE  BUKRS OPTIONAL
*"     REFERENCE(I_BELNR) TYPE  BELNR_D OPTIONAL
*"     REFERENCE(I_GJAHR) TYPE  GJAHR OPTIONAL
*"     REFERENCE(I_ONCECUS) TYPE  CHAR01 OPTIONAL
*"     REFERENCE(I_NATION) TYPE  AD_NATION OPTIONAL
*"  EXPORTING
*"     REFERENCE(E_NAME)
*"     REFERENCE(E_ADDRESS)
*"     REFERENCE(E_TAX)
*"     REFERENCE(E_TEL_NUMBER)
*"     REFERENCE(E_FAX_NUMBER)
*"     REFERENCE(E_EMAIL)
*"     REFERENCE(E_NAME_N_TITLE)
*"     REFERENCE(E_NAME1)
*"     REFERENCE(E_TITLE)
*"     REFERENCE(E_KTOKL)
*"     REFERENCE(E_KTOKL_NAME)
*"     REFERENCE(E_REMARK)
*"     REFERENCE(E_ADDRESS_EN)
*"     REFERENCE(E_ONECUS)
*"     REFERENCE(E_WEB)
*"     REFERENCE(E_PARTNER)
*"     REFERENCE(E_STREET1)
*"     REFERENCE(E_STREET2)
*"----------------------------------------------------------------------

  CASE I_KIND.
    WHEN 'C'.
      PERFORM GET_CC_ADDRESS
      USING
            I_NUMBER
            I_NATION
      CHANGING  E_NAME
        E_NAME_N_TITLE
        E_ADDRESS
        E_ADDRESS_EN
        E_TAX
        E_TEL_NUMBER
        E_FAX_NUMBER
        E_EMAIL
        E_REMARK.
    WHEN 'P'.
      PERFORM GET_PLANT_ADDRESS
      USING
            I_NUMBER
      CHANGING  E_NAME
        E_NAME_N_TITLE
        E_ADDRESS
        E_ADDRESS_EN
        E_TAX
        E_TEL_NUMBER
        E_FAX_NUMBER
        E_EMAIL
        E_REMARK.
    WHEN 'K'.
      PERFORM GET_VEN_ADDRESS
      USING
            I_NUMBER
            I_BUKRS
            I_BELNR
            I_GJAHR
            I_ONCECUS
      CHANGING  E_NAME
        E_NAME_N_TITLE
        E_NAME1
        E_ADDRESS
        E_ADDRESS_EN
        E_TAX
        E_TEL_NUMBER
        E_FAX_NUMBER
        E_EMAIL
        E_TITLE
        E_KTOKL
        E_KTOKL_NAME
        E_ONECUS
        E_PARTNER
        E_WEB.
    WHEN 'D'.
      PERFORM GET_CUS_ADDRESS
      USING
            I_NUMBER
            I_BUKRS
            I_BELNR
            I_GJAHR
            I_ONCECUS
      CHANGING  E_NAME
        E_NAME_N_TITLE
        E_NAME1
        E_ADDRESS
        E_ADDRESS_EN
        E_TAX
        E_TEL_NUMBER
        E_FAX_NUMBER
        E_EMAIL
        E_TITLE
        E_KTOKL
        E_KTOKL_NAME
        E_PARTNER
        E_ONECUS.
    WHEN 'S'."Shipping point
      PERFORM GET_SHIPPING_ADDRESS
      USING
            I_NUMBER
      CHANGING  E_NAME
        E_NAME_N_TITLE
        E_ADDRESS
        E_ADDRESS_EN
        E_TEL_NUMBER
        E_FAX_NUMBER
        E_REMARK.
    WHEN OTHERS.
  ENDCASE.

ENDFUNCTION.


*&---------------------------------------------------------------------*
*&      Form GET_CC_ADDRESS
*&---------------------------------------------------------------------*
FORM GET_CC_ADDRESS
  USING
        P_NUMBER
        P_NATION
CHANGING  E_NAME
          E_NAME_N_TITLE
          E_ADDRESS
          E_ADDRESS_EN
          E_TAX
          E_TEL_NUMBER
          E_FAX_NUMBER
          E_EMAIL
          E_REMARK        .

  DATA: LW_ADRNR        TYPE T001-ADRNR,
        LW_TITLE        TYPE ADRC-TITLE,
        LW_NAME1        TYPE ADRC-NAME1,
        LW_NAME2        TYPE ADRC-NAME2,
        LW_NAME3        TYPE ADRC-NAME3,
        LW_NAME4        TYPE ADRC-NAME4,
        LW_HOUSE_NUM1   TYPE ADRC-HOUSE_NUM1,
        LW_HOUSE_NUM2   TYPE ADRC-HOUSE_NUM2,
        LW_HOUSE_NUM3   TYPE ADRC-HOUSE_NUM3,
        LW_STREET       TYPE ADRC-STREET,
        LW_STR_SUPPL1   TYPE AD_STRSPP1,
        LW_STR_SUPPL2   TYPE AD_STRSPP1,
        LW_STR_SUPPL3   TYPE AD_STRSPP1,
        LW_CITY1        TYPE ADRC-CITY1,
        LW_CITY2        TYPE ADRC-CITY2,
        LW_COUNTRY      TYPE ADRC-COUNTRY,
        LW_COUNTRY_DESC TYPE T005T-LANDX,
        LW_TAX          TYPE T001-STCEG,
        LW_TEL_NUMBER   TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER   TYPE ADRC-FAX_NUMBER,
        LW_EMAIL        TYPE ADR6-SMTP_ADDR,
        LW_REMARK       TYPE AD_REMARK1,
        LW_NAME_CO      TYPE AD_NAME_CO,
        LW_LOCATION     TYPE AD_LCTN,
        LW_HOME_CITY    TYPE AD_CITY3.
  " Lay Thong Tin Company Code
  SELECT SINGLE
    T001~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    T001~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    ADRCT~REMARK
    ADRC~NAME_CO
    ADRC~LOCATION
    ADRC~HOME_CITY
  INTO
    (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_REMARK,
    LW_NAME_CO,
    LW_LOCATION,
    LW_HOME_CITY)
  FROM T001 INNER JOIN ADRC ON ADRC~ADDRNUMBER = T001~ADRNR AND ADRC~NATION EQ ''
  LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = T001~ADRNR
  LEFT JOIN ADRCT ON ADRCT~ADDRNUMBER = T001~ADRNR AND ADRCT~NATION EQ ''
  WHERE BUKRS EQ P_NUMBER.
  IF SY-SUBRC EQ 0.

    " Ten Cong ty/Don vi tieng Viet
    CLEAR: E_NAME.
    CONCATENATE LW_NAME1 LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    CONDENSE E_NAME.

    " Dia chi tieng Viet : house number + Street + Street 2 + Street 3 + City
    CLEAR: E_ADDRESS.
    CONCATENATE LW_HOUSE_NUM1 LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_CITY1 INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.

    " Tel, Fax, Tax, Email
    E_TAX = LW_TAX.
    E_TEL_NUMBER = LW_TEL_NUMBER.
    E_FAX_NUMBER = LW_FAX_NUMBER.
    E_EMAIL = LW_EMAIL.
  ENDIF.


  " Lay Thong Tin Company Code
  SELECT SINGLE
    T001~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    T001~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    ADRCT~REMARK
    ADRC~NAME_CO
    ADRC~LOCATION
    ADRC~HOME_CITY
  INTO
    (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_REMARK,
    LW_NAME_CO,
    LW_LOCATION,
    LW_HOME_CITY)
  FROM T001 INNER JOIN ADRC ON ADRC~ADDRNUMBER = T001~ADRNR AND ADRC~NATION EQ P_NATION
  LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = T001~ADRNR
  LEFT JOIN ADRCT ON ADRCT~ADDRNUMBER = T001~ADRNR AND ADRCT~NATION EQ P_NATION
  WHERE BUKRS EQ P_NUMBER.
  IF SY-SUBRC EQ 0.

    " Ten Cong ty/Don vi tieng Viet
    CLEAR: E_NAME_N_TITLE.
    CONCATENATE LW_NAME1 LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
    CONDENSE E_NAME_N_TITLE.

    " Dia chi tieng Viet : house number + Street + Street 2 + Street 3
    CLEAR: E_ADDRESS_EN.
    CONCATENATE LW_HOUSE_NUM1 LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_CITY1 INTO E_ADDRESS_EN SEPARATED BY SPACE.
    CONDENSE E_ADDRESS_EN.
  ENDIF.

  IF LW_COUNTRY IS NOT INITIAL
    AND P_NATION IS INITIAL.
    SELECT SINGLE
      LANDX
      INTO LW_COUNTRY_DESC
      FROM T005T
      WHERE SPRAS EQ SY-LANGU
        AND LAND1 EQ LW_COUNTRY.
    IF SY-SUBRC EQ 0.
      CONCATENATE E_ADDRESS_EN `, ` LW_COUNTRY_DESC INTO E_ADDRESS_EN.
    ENDIF.
  ENDIF.

  "Comment
  E_REMARK = LW_REMARK.
ENDFORM.                    "GET_CC_ADDRESS

*&---------------------------------------------------------------------*
*&      Form GET_CC_ADDRESS
*&---------------------------------------------------------------------*
FORM GET_PLANT_ADDRESS
  USING     P_NUMBER
CHANGING  E_NAME
          E_NAME_N_TITLE
          E_ADDRESS
          E_ADDRESS_EN
          E_TAX
          E_TEL_NUMBER
          E_FAX_NUMBER
          E_EMAIL
          E_REMARK         .

  DATA: LW_ADRNR      TYPE T001-ADRNR,
        LW_TITLE      TYPE ADRC-TITLE,
        LW_NAME1      TYPE ADRC-NAME1,
        LW_NAME2      TYPE ADRC-NAME2,
        LW_NAME3      TYPE ADRC-NAME3,
        LW_NAME4      TYPE ADRC-NAME4,
        LW_HOUSE_NUM1 TYPE ADRC-HOUSE_NUM1,
        LW_HOUSE_NUM2 TYPE ADRC-HOUSE_NUM2,
        LW_HOUSE_NUM3 TYPE ADRC-HOUSE_NUM3,
        LW_STREET     TYPE ADRC-STREET,
        LW_STR_SUPPL1 TYPE AD_STRSPP1,
        LW_STR_SUPPL2 TYPE AD_STRSPP1,
        LW_STR_SUPPL3 TYPE AD_STRSPP1,
        LW_CITY1      TYPE ADRC-CITY1,
        LW_CITY2      TYPE ADRC-CITY2,
        LW_COUNTRY    TYPE ADRC-COUNTRY,
        LW_TAX        TYPE T001-STCEG,
        LW_TEL_NUMBER TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER TYPE ADRC-FAX_NUMBER,
        LW_EMAIL      TYPE ADR6-SMTP_ADDR,
        LW_REMARK     TYPE AD_REMARK1,
        LW_NAME_CO    TYPE AD_NAME_CO,
        LW_LOCATION   TYPE AD_LCTN,
        LW_HOME_CITY  TYPE AD_CITY3.
  " Lay Thong Tin Company Code
  SELECT SINGLE
    T001W~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    ADRCT~REMARK
    ADRC~NAME_CO
    ADRC~LOCATION
    ADRC~HOME_CITY
  INTO
    (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_REMARK,
    LW_NAME_CO,
    LW_LOCATION,
    LW_HOME_CITY)
  FROM T001W INNER JOIN ADRC ON ADRC~ADDRNUMBER = T001W~ADRNR AND ADRC~NATION EQ ''
  LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = T001W~ADRNR
  LEFT JOIN ADRCT ON ADRCT~ADDRNUMBER = T001W~ADRNR AND ADRCT~NATION EQ ''
  WHERE WERKS EQ P_NUMBER.
  IF SY-SUBRC EQ 0.

    " Ten Cong ty/Don vi tieng Viet
    CLEAR: E_NAME.
    IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
      E_NAME = LW_NAME1.
    ELSE.
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    ENDIF.
    CONDENSE E_NAME.

    " Dia chi tieng Viet : Street + Street 4 + Street 5
    CLEAR: E_ADDRESS.
    CONCATENATE LW_STREET LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.

    " Tel, Fax, Tax, Email
    E_TAX = LW_TAX.
    E_TEL_NUMBER = LW_TEL_NUMBER.
    E_FAX_NUMBER = LW_FAX_NUMBER.
    E_EMAIL = LW_EMAIL.
  ENDIF.




  " Lay Thong Tin Company Code
  SELECT SINGLE
    T001W~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    ADRCT~REMARK
    ADRC~NAME_CO
    ADRC~LOCATION
    ADRC~HOME_CITY
  INTO
    (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_REMARK,
    LW_NAME_CO,
    LW_LOCATION,
    LW_HOME_CITY)
  FROM T001W INNER JOIN ADRC ON ADRC~ADDRNUMBER = T001W~ADRNR AND ADRC~NATION EQ 'I'
  LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = T001W~ADRNR
  LEFT JOIN ADRCT ON ADRCT~ADDRNUMBER = T001W~ADRNR AND ADRCT~NATION EQ 'I'
  WHERE WERKS EQ P_NUMBER.
  IF SY-SUBRC EQ 0.

    " Ten Cong ty/Don vi tieng Anh
    CLEAR: E_NAME_N_TITLE.
    IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
      E_NAME_N_TITLE = LW_NAME1.
    ELSE.
      CONCATENATE  LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
    ENDIF.
    CONDENSE E_NAME_N_TITLE.

    " Dia chi tieng Anh : Street + Street 4 + Street 5
    CLEAR: E_ADDRESS_EN.
    CONCATENATE LW_STREET LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS_EN SEPARATED BY SPACE.
    CONDENSE E_ADDRESS_EN.
  ENDIF.

  "Comment
  E_REMARK = LW_REMARK.
ENDFORM.                    "GET_CC_ADDRESS

*&---------------------------------------------------------------------*
*&      Form GET_VEN_ADDRESS
*&---------------------------------------------------------------------*
FORM GET_VEN_ADDRESS USING    P_NUMBER
      P_BUKRS         TYPE BUKRS
      P_BELNR         TYPE BELNR_D
      P_GJAHR         TYPE GJAHR
      P_ONECUS        TYPE CHAR1
CHANGING   E_NAME
           E_NAME_N_TITLE
           E_NAME1
           E_ADDRESS
           E_ADDRESS_EN
           E_TAX
           E_TEL_NUMBER
           E_FAX_NUMBER
           E_EMAIL
           E_TITLE
           E_KTOKL
           E_KTOKL_NAME
           E_ONECUS
           E_PARTNER
           E_WEB           .

  DATA: LW_XCPDK      TYPE LFA1-XCPDK,
        LW_KTOKL      TYPE KTOKL_077T,
        LW_KTOKL_NAME TYPE TXT30_077T.

  DATA: LW_ADRNR        TYPE T001-ADRNR,
        LW_LOCATION     TYPE AD_LCTN,
        LW_TITLE        TYPE ADRC-TITLE,
        LW_NAME1        TYPE ADRC-NAME1,
        LW_NAME2        TYPE ADRC-NAME2,
        LW_NAME3        TYPE ADRC-NAME3,
        LW_NAME4        TYPE ADRC-NAME4,
        LW_HOUSE_NUM1   TYPE ADRC-HOUSE_NUM1,
        LW_HOUSE_NUM2   TYPE ADRC-HOUSE_NUM2,
        LW_HOUSE_NUM3   TYPE ADRC-HOUSE_NUM3,
        LW_STR_SUPPL1   TYPE AD_STRSPP1,
        LW_STR_SUPPL2   TYPE AD_STRSPP1,
        LW_STR_SUPPL3   TYPE AD_STRSPP1,
        LW_STREET       TYPE ADRC-STREET,
        LW_CITY1        TYPE ADRC-CITY1,
        LW_CITY2        TYPE ADRC-CITY2,
        LW_COUNTRY      TYPE ADRC-COUNTRY,
        LW_COUNTRY_NAME TYPE T005T-LANDX,
        LW_TAX          TYPE T001-STCEG,
        LW_TEL_NUMBER   TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER   TYPE ADRC-FAX_NUMBER,
        LW_EMAIL        TYPE ADR6-SMTP_ADDR,
        LW_WEB          TYPE URL,
        LW_E_TITLE      TYPE TEXT15.

  DATA: LW_STRAS TYPE BSEC-STRAS,
        LW_ORT01 TYPE BSEC-ORT01,
        LW_LAND1 TYPE BSEC-LAND1,
        LW_STCD1 TYPE BSEC-STCD1.

  " Kiem Tra Loai Vendor
  SELECT SINGLE XCPDK KTOKK
  INTO (LW_XCPDK, LW_KTOKL)
  FROM LFA1
  WHERE LIFNR EQ P_NUMBER.

  E_ONECUS = LW_XCPDK.

  SELECT SINGLE TXT30
  INTO LW_KTOKL_NAME
  FROM T077Y
  WHERE KTOKK = LW_KTOKL
    AND SPRAS = SY-LANGU.

  E_KTOKL = LW_KTOKL.
  E_KTOKL_NAME = LW_KTOKL_NAME.
  " Neu khong phai One Time Vendor Hoac la One Time Vendor nhung khong lay thong tin theo chung tu
  IF LW_XCPDK NE 'X' OR P_BUKRS IS INITIAL OR P_BELNR IS INITIAL OR P_GJAHR IS INITIAL OR P_ONECUS = 'X'.
    " Lay Thong Tin Vendor
    SELECT  SINGLE
    LFA1~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    LFA1~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    LFA1~ANRED
    ADRC~LOCATION
    LFA1~LFURL
    INTO (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_E_TITLE,
    LW_LOCATION,
    LW_WEB
    )
    FROM LFA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = LFA1~ADRNR AND ADRC~NATION EQ ''
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = LFA1~ADRNR
    WHERE LIFNR EQ P_NUMBER.
    IF SY-SUBRC EQ 0.
      E_WEB = LW_WEB.
      "TITLE
      E_TITLE = LW_TITLE.
      CONDENSE E_TITLE.

      " Ten Vendor
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
      IF E_NAME IS INITIAL.
        E_NAME = LW_NAME1.
      ENDIF.

      E_NAME1 = LW_NAME1.
      CONDENSE: E_NAME, E_NAME1.

      " Dia chi
*      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.

      IF LW_COUNTRY IS NOT INITIAL.
        SELECT SINGLE LANDX
          INTO LW_COUNTRY_NAME
          FROM T005T
          WHERE SPRAS EQ SY-LANGU
            AND LAND1 EQ LW_COUNTRY.
      ENDIF.

      " Dia chi
      CLEAR: E_ADDRESS.
      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE. "tri.nguyen2 - Update Vendor Address - 07.01.2026
      CONDENSE E_ADDRESS.

      " Tel, Fax, Tax, Email
      E_TAX = LW_TAX.
      E_TEL_NUMBER = LW_TEL_NUMBER.
      E_FAX_NUMBER = LW_FAX_NUMBER.

    ENDIF.

    "tieng anh

    " Lay Thong Tin Vendor
    SELECT  SINGLE
    LFA1~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    LFA1~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    LFA1~ANRED
    ADRC~LOCATION
    LFA1~LFURL
    INTO (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_E_TITLE,
    LW_LOCATION,
    LW_WEB
    )
    FROM LFA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = LFA1~ADRNR AND ADRC~NATION EQ 'I'
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = LFA1~ADRNR
    WHERE LIFNR EQ P_NUMBER.
    IF SY-SUBRC EQ 0.

      " Ten Vendor
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
      IF E_NAME_N_TITLE IS INITIAL.
        E_NAME_N_TITLE = LW_NAME1.
      ENDIF.

      E_NAME1 = LW_NAME1.
      CONDENSE: E_NAME, E_NAME1.

      " Dia chi
*      CLEAR: E_ADDRESS_EN.
*      CONCATENATE LW_STREET LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS_EN SEPARATED BY SPACE.
      IF LW_COUNTRY IS NOT INITIAL.
        SELECT SINGLE LANDX
          INTO LW_COUNTRY_NAME
          FROM T005T
          WHERE SPRAS EQ SY-LANGU
            AND LAND1 EQ LW_COUNTRY.
      ENDIF.

      " Dia chi
      CLEAR: E_ADDRESS.
      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS_EN.
    ENDIF.

    LW_EMAIL = E_EMAIL.
    PERFORM GET_EMAIL_BP_VEND
      USING P_NUMBER
      CHANGING LW_EMAIL
               E_PARTNER.

  ELSE.
    SELECT  SINGLE
    ANRED AS TITLE
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    INTAD
    INTO (LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STRAS,
    LW_ORT01,
    LW_LAND1,
    LW_STCD1,
    LW_E_TITLE,
    LW_EMAIL)
    FROM  BSEC
    WHERE BUKRS = P_BUKRS
    AND GJAHR = P_GJAHR
    AND BELNR = P_BELNR.

    SELECT  SINGLE
    ANRED AS TITLE
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    INTAD
    INTO (LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STRAS,
    LW_ORT01,
    LW_LAND1,
    LW_STCD1,
    LW_E_TITLE,
    LW_EMAIL)
    FROM  VBSEC
    WHERE AUSBK = P_BUKRS
    AND GJAHR = P_GJAHR
    AND BELNR = P_BELNR.

    "TITLE
    E_TITLE = LW_E_TITLE.
    CONDENSE E_TITLE.

    " Ten Vendor One time Name = Name 1 + Name 2 + Name 3 + Name 4
    CLEAR: E_NAME.
    CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    IF E_NAME IS INITIAL.
      E_NAME = LW_NAME1 .
    ENDIF.
    E_NAME1 = LW_NAME1.
    CONDENSE: E_NAME, E_NAME1.

    " Dia chi

*    CLEAR: E_ADDRESS.
*    CONCATENATE LW_STREET LW_CITY1 INTO E_ADDRESS SEPARATED BY SPACE.
    IF LW_LAND1 IS NOT INITIAL.
      SELECT SINGLE LANDX
        INTO LW_COUNTRY_NAME
        FROM T005T
        WHERE SPRAS EQ SY-LANGU
          AND LAND1 EQ LW_LAND1.
    ENDIF.

    " Dia chi
    CLEAR: E_ADDRESS.
    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.
*
    IF LW_XCPDK EQ 'X'.
      CLEAR: E_ADDRESS.
      CONCATENATE LW_STRAS LW_ORT01 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS.
    ENDIF.

    " Tel, Fax, Tax, Email
    E_TAX = LW_STCD1.
    E_TEL_NUMBER = ''.
    E_FAX_NUMBER = ''.
  ENDIF.

  E_EMAIL = LW_EMAIL.

ENDFORM.                    "GET_VEN_ADDRESS


*&---------------------------------------------------------------------*
*&      Form GET_CUS_ADDRESS
*&---------------------------------------------------------------------*
FORM GET_CUS_ADDRESS USING    P_NUMBER
      P_BUKRS         TYPE BUKRS
      P_BELNR         TYPE BELNR_D
      P_GJAHR         TYPE GJAHR
      P_ONCECUS       TYPE CHAR01
CHANGING  E_NAME
          E_NAME_N_TITLE
          E_NAME1
          E_ADDRESS
          E_ADDRESS_EN
          E_TAX
          E_TEL_NUMBER
          E_FAX_NUMBER
          E_EMAIL
          E_TITLE
          E_KTOKL
          E_KTOKL_NAME
          E_PARTNER
          E_ONECUS        .

  DATA: LW_XCPDK      TYPE KNA1-XCPDK,
        LW_KTOKL      TYPE KTOKL_077T,
        LW_KTOKL_NAME TYPE TXT30_077T.

  DATA: LW_ADRNR        TYPE T001-ADRNR,
        LW_LOCATION     TYPE AD_LCTN,
        LW_TITLE        TYPE ADRC-TITLE,
        LW_NAME1        TYPE ADRC-NAME1,
        LW_NAME2        TYPE ADRC-NAME2,
        LW_NAME3        TYPE ADRC-NAME3,
        LW_NAME4        TYPE ADRC-NAME4,
        LW_HOUSE_NUM1   TYPE ADRC-HOUSE_NUM1,
        LW_HOUSE_NUM2   TYPE ADRC-HOUSE_NUM2,
        LW_HOUSE_NUM3   TYPE ADRC-HOUSE_NUM3,
        LW_STR_SUPPL1   TYPE AD_STRSPP1,
        LW_STR_SUPPL2   TYPE AD_STRSPP1,
        LW_STR_SUPPL3   TYPE AD_STRSPP1,
        LW_STREET       TYPE ADRC-STREET,
        LW_CITY1        TYPE ADRC-CITY1,
        LW_CITY2        TYPE ADRC-CITY2,
        LW_COUNTRY      TYPE ADRC-COUNTRY,
        LW_COUNTRY_NAME TYPE T005T-LANDX,
        LW_TAX          TYPE T001-STCEG,
        LW_TEL_NUMBER   TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER   TYPE ADRC-FAX_NUMBER,
        LW_EMAIL        TYPE ADR6-SMTP_ADDR,
        LW_E_TITLE      TYPE TEXT15.

  DATA: LW_STRAS TYPE BSEC-STRAS,
        LW_ORT01 TYPE BSEC-ORT01,
        LW_LAND1 TYPE BSEC-LAND1,
        LW_STCD1 TYPE BSEC-STCD1.
*  DATA: LW_ADRNR       TYPE ADRNR.
  " Kiem Tra Loai Customer
  SELECT SINGLE XCPDK KTOKD
  INTO (LW_XCPDK, LW_KTOKL)
  FROM KNA1
  WHERE KUNNR EQ P_NUMBER.

  E_ONECUS = LW_XCPDK.

  SELECT SINGLE TXT30
  INTO LW_KTOKL_NAME
  FROM T077X
  WHERE KTOKD = LW_KTOKL
    AND SPRAS = SY-LANGU.

  E_KTOKL = LW_KTOKL.
  E_KTOKL_NAME = LW_KTOKL_NAME.

  " Neu khong phai One Time Customer Hoac la One Time Customer nhung khong lay thong tin theo chung tu
  IF LW_XCPDK NE 'X' OR P_BUKRS IS INITIAL OR P_BELNR IS INITIAL OR P_GJAHR IS INITIAL OR P_ONCECUS = 'X'.
    " Lay Thong Tin Customer
    SELECT  SINGLE
    KNA1~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
*    KNA1~STCEG

    TAX~TAXNUM  AS TAX
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    KNA1~ANRED
    ADRC~LOCATION
    INTO (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_E_TITLE,
    LW_LOCATION)
    FROM KNA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = KNA1~ADRNR AND ADRC~NATION EQ ''
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = KNA1~ADRNR
    LEFT JOIN DFKKBPTAXNUM AS TAX
    ON  TAX~PARTNER      = KNA1~KUNNR
    AND TAX~TAXTYPE      = 'VN0'
    WHERE KUNNR EQ P_NUMBER.
    IF SY-SUBRC EQ 0.

      "TITLE
      E_TITLE = LW_TITLE.
      CONDENSE E_TITLE.

      " Ten Customer
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
      IF E_NAME IS INITIAL.
        E_NAME = LW_NAME1.
      ENDIF.

      E_NAME1 = LW_NAME1.
      CONDENSE: E_NAME, E_NAME1.

      " Dia chi
*      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
      IF LW_COUNTRY IS NOT INITIAL.
        SELECT SINGLE LANDX
          INTO LW_COUNTRY_NAME
          FROM T005T
          WHERE SPRAS EQ SY-LANGU
            AND LAND1 EQ LW_COUNTRY.
      ENDIF.

      " Dia chi
      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
      "thay đổi cách lấy street của Customer không có lấy thêm trường city + description của Country
      "Binh.Tran
      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS.

      " Tel, Fax, Tax, Email
      E_TAX = LW_TAX.
      E_TEL_NUMBER = LW_TEL_NUMBER.
      E_FAX_NUMBER = LW_FAX_NUMBER.
    ENDIF.


    " Lay Thong Tin Customer
    "tên tieng Anh
    SELECT  SINGLE
    KNA1~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    TAX~TAXNUM  AS TAX
*    KNA1~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    KNA1~ANRED
    ADRC~LOCATION
    INTO (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_E_TITLE,
    LW_LOCATION)
    FROM KNA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = KNA1~ADRNR AND ADRC~NATION EQ 'I'
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = KNA1~ADRNR
    LEFT JOIN DFKKBPTAXNUM AS TAX
    ON  TAX~PARTNER      = KNA1~KUNNR
    AND TAX~TAXTYPE      = 'VN0'
    WHERE KUNNR EQ P_NUMBER.

    IF SY-SUBRC EQ 0.
      " Ten Vendor
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
      IF E_NAME_N_TITLE IS INITIAL.
        E_NAME_N_TITLE = LW_NAME1.
      ENDIF.

      E_NAME1 = LW_NAME1.
      CONDENSE: E_NAME, E_NAME1.

      " Dia chi
*      CLEAR: E_ADDRESS_EN.
*      CONCATENATE LW_STREET LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS_EN SEPARATED BY SPACE.
      IF LW_COUNTRY IS NOT INITIAL.
        SELECT SINGLE LANDX
          INTO LW_COUNTRY_NAME
          FROM T005T
          WHERE SPRAS EQ SY-LANGU
            AND LAND1 EQ LW_COUNTRY.
      ENDIF.

      " Dia chi
      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS_EN.
    ENDIF.

    LW_EMAIL = E_EMAIL.
    PERFORM GET_EMAIL_BP_CUST
      USING P_NUMBER
      CHANGING LW_EMAIL
               E_PARTNER.
  ELSE.
    SELECT  SINGLE
    ANRED AS TITLE
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    ADRNR
    INTAD
    INTO (LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STRAS,
    LW_ORT01,
    LW_LAND1,
    LW_STCD1,
    LW_E_TITLE,
    LW_ADRNR,
    LW_EMAIL)
    FROM  BSEC
    WHERE BUKRS = P_BUKRS
    AND GJAHR = P_GJAHR
    AND BELNR = P_BELNR.
    IF SY-SUBRC <> 0.
      SELECT  SINGLE
            ADRC~TITLE
            ADRC~NAME1
            ADRC~NAME2
            ADRC~NAME3
            ADRC~NAME4
            ADRC~HOUSE_NUM1
            ADRC~HOUSE_NUM2
            ADRC~HOUSE_NUM3
            ADRC~STR_SUPPL1
            ADRC~STR_SUPPL2
            ADRC~STR_SUPPL3
            ADRC~STREET
            ADRC~CITY1
            ADRC~CITY2
            ADRC~COUNTRY
            ADRC~TEL_NUMBER
            ADRC~FAX_NUMBER
            ADR6~SMTP_ADDR
            INTO (LW_TITLE,
            LW_NAME1,
            LW_NAME2,
            LW_NAME3,
            LW_NAME4,
            LW_HOUSE_NUM1,
            LW_HOUSE_NUM2,
            LW_HOUSE_NUM3,
            LW_STR_SUPPL1,
            LW_STR_SUPPL2,
            LW_STR_SUPPL3,
            LW_STREET,
            LW_CITY1,
            LW_CITY2,
            LW_COUNTRY,
            LW_TEL_NUMBER,
            LW_FAX_NUMBER,
            LW_EMAIL)
         FROM ADRC "ON ADRC~ADDRNUMBER = BSEC~ADRNR
         LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = ADRC~ADDRNUMBER
         WHERE ADRC~ADDRNUMBER = LW_ADRNR.
    ENDIF.


    SELECT  SINGLE
    ANRED AS TITLE
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    INTAD
    INTO (LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STRAS,
    LW_ORT01,
    LW_LAND1,
    LW_STCD1,
    LW_E_TITLE,
    LW_EMAIL)
    FROM  VBSEC
    WHERE AUSBK = P_BUKRS
    AND GJAHR = P_GJAHR
    AND BELNR = P_BELNR.

    "TITLE
    E_TITLE = LW_E_TITLE.
    CONDENSE E_TITLE.

    " Ten Customer One time Name = Name 1 + Name 2 + Name 3 + Name 4
    CLEAR: E_NAME.
    CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    IF E_NAME IS INITIAL.
      E_NAME = LW_NAME1 .
    ENDIF.
    E_NAME1 = LW_NAME1.
    CONDENSE: E_NAME, E_NAME1.

    " Dia chi
*
*    CLEAR: E_ADDRESS.
*    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
    IF LW_LAND1 IS NOT INITIAL.
      SELECT SINGLE LANDX
        INTO LW_COUNTRY_NAME
        FROM T005T
        WHERE SPRAS EQ SY-LANGU
          AND LAND1 EQ LW_LAND1.
    ENDIF.

    " Dia chi
    CLEAR: E_ADDRESS.
*    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.
*
    IF LW_XCPDK EQ 'X'.
      CLEAR: E_ADDRESS.
      CONCATENATE LW_STRAS LW_ORT01 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS.
    ENDIF.

    " Tel, Fax, Tax, Email
    E_TAX = LW_STCD1.
    E_TEL_NUMBER = ''.
    E_FAX_NUMBER = ''.
  ENDIF.

  E_EMAIL = LW_EMAIL.
ENDFORM.                    "GET_CUS_ADDRESS

*&---------------------------------------------------------------------*
*&      Form GET_CC_ADDRESS
*&---------------------------------------------------------------------*
FORM GET_SHIPPING_ADDRESS
  USING
        P_NUMBER
CHANGING  E_NAME
          E_NAME_N_TITLE
          E_ADDRESS
          E_ADDRESS_EN
          E_TEL_NUMBER
          E_FAX_NUMBER
          E_REMARK        .

  CHECK P_NUMBER IS NOT INITIAL.

  DATA: LW_ADRNR      TYPE T001-ADRNR,
        LW_TITLE      TYPE ADRC-TITLE,
        LW_NAME1      TYPE ADRC-NAME1,
        LW_NAME2      TYPE ADRC-NAME2,
        LW_NAME3      TYPE ADRC-NAME3,
        LW_NAME4      TYPE ADRC-NAME4,
        LW_STREET     TYPE ADRC-STREET,
        LW_STR_SUPPL1 TYPE AD_STRSPP1,
        LW_STR_SUPPL2 TYPE AD_STRSPP1,
        LW_STR_SUPPL3 TYPE AD_STRSPP1,
        LW_CITY1      TYPE ADRC-CITY1,
        LW_CITY2      TYPE ADRC-CITY2,
        LW_COUNTRY    TYPE ADRC-COUNTRY,
        LW_TAX        TYPE T001-STCEG,
        LW_TEL_NUMBER TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER TYPE ADRC-FAX_NUMBER,
        LW_EMAIL      TYPE ADR6-SMTP_ADDR,
        LW_REMARK     TYPE AD_REMARK1,
        LW_NAME_CO    TYPE AD_NAME_CO,
        LW_LOCATION   TYPE AD_LCTN,
        LW_HOME_CITY  TYPE AD_CITY3.
  " Lay Thong Tin Company Code
  SELECT SINGLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~STREET
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~LOCATION
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
  INTO
    (LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STREET,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_LOCATION,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER)
  FROM TVST INNER JOIN ADRC ON ADRC~ADDRNUMBER   = TVST~ADRNR AND ADRC~NATION EQ ''
  WHERE VSTEL EQ P_NUMBER.

  " Ten shipping point tieng Viet
  CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
  IF E_NAME IS INITIAL.
    E_NAME = LW_NAME1.
  ENDIF.
  CONDENSE: E_NAME.

  " Dia chi
  CLEAR: E_ADDRESS.
  CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
  CONDENSE E_ADDRESS.

  " Tel
  CLEAR E_TEL_NUMBER.
  E_TEL_NUMBER = LW_TEL_NUMBER.
  CONDENSE LW_TEL_NUMBER.

  " Fax
  CLEAR E_FAX_NUMBER.
  E_FAX_NUMBER = LW_FAX_NUMBER.
  CONDENSE LW_FAX_NUMBER.

  " Lay Thong Tin Company Code
  SELECT SINGLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~STREET
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~LOCATION
    ADRCT~REMARK
  INTO
    (LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STREET,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_LOCATION,
    LW_REMARK)
  FROM TVST INNER JOIN ADRC ON ADRC~ADDRNUMBER  = TVST~ADRNR AND ADRC~NATION EQ 'I'
            LEFT JOIN ADRCT ON ADRCT~ADDRNUMBER = TVST~ADRNR AND ADRCT~NATION EQ 'I'
  WHERE VSTEL EQ P_NUMBER.

  " Ten shipping point tieng Viet
  CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
  IF E_NAME_N_TITLE IS INITIAL.
    E_NAME_N_TITLE = LW_NAME1.
  ENDIF.
  CONDENSE: E_NAME_N_TITLE.

  " Dia chi
  CLEAR: E_ADDRESS_EN.
  CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS_EN SEPARATED BY SPACE.
  CONDENSE E_ADDRESS_EN.

  CLEAR E_REMARK.
  E_REMARK = LW_REMARK.
ENDFORM.                    "GET_SHIPPING_ADDRESS


