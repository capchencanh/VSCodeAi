FUNCTION ZCORE_FM_EXPORT_EXCEL_XML.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(REPORT_NAME) TYPE  ZDE_REPORT_NAME
*"     REFERENCE(STRUCT_NAME) TYPE  STRUKNAME
*"     REFERENCE(IW_PARAMETER) TYPE  ZCORE_ST_PARAMETER
*"     REFERENCE(FIELD_COMPARE) TYPE  CHAR20 DEFAULT 'LEVEL'
*"     VALUE(IW_DISPLAY_ZERO) TYPE  CHAR1 OPTIONAL
*"  TABLES
*"      IT_TABLE_DETAIL TYPE  STANDARD TABLE
*"--------------------------------------------------------------------
DATA: LS_READ_EXCEL_HEADER  TYPE ZTB_READ_EXCEL,
        LT_READ_EXCEL_HEADER  TYPE TABLE OF ZTB_READ_EXCEL,
        LS_READ_EXCEL_DETAIL  TYPE ZTB_READ_EXCEL,
        LT_READ_EXCEL_DETAIL  TYPE TABLE OF ZTB_READ_EXCEL,
        LS_READ_EXCEL_WIDTH   TYPE ZTB_READ_EXCEL,
        LT_READ_EXCEL_WIDTH   TYPE TABLE OF ZTB_READ_EXCEL,
        LS_READ_EXCEL_FOOTER  TYPE ZTB_READ_EXCEL,
        LT_READ_EXCEL_FOOTER  TYPE TABLE OF ZTB_READ_EXCEL.

  DATA: LW_SY_ABCDE TYPE CHAR80,
        LW_IW_TYPE TYPE CHAR1.

  FIELD-SYMBOLS:
        <TABLE_DETAIL>        TYPE STANDARD TABLE,
        <FIELD_LEVEL>,
        <FIELD_DETAIL> ,
        <WA_TABLE_DETAIL> .

  " Excel parameter
  DATA: GT_EXCEL                  TYPE TABLE OF STRING,
        GW_ROW                    TYPE P,
        LW_STR                    TYPE CHAR100,
        LW_MAX_ROW_DETAIL         TYPE INT2,
        LW_MIN_ROW_DETAIL         TYPE INT2,
        LW_MIN_ROW_FOOTER         TYPE INT2,
        LW_COUNT_ROW_DETAIL       TYPE INT2,
        LW_NUM_ROW_FOOTER_DETAIL  TYPE INT2.

  " Tham so truyen vao ham Excel
  DATA: LW_CUR_ROW                TYPE P,
        LW_CUR_COL                TYPE P,
        LW_CUR_BEGIN_FOOTER       TYPE P,
        LW_CUR_MERGE_NGANG        TYPE INT1,
        LW_CUR_MERGE_DOC          TYPE INT1,
        LW_CUR_COL_STR            TYPE STRING,
        LW_FIELD_VALUE            TYPE CHAR255,
        LW_FIELD_VALUE_STR        TYPE STRING,
        LW_FIELD_STR              TYPE CHAR100,
        LW_OUT_STR                TYPE CHAR100,
        LW_WIDTH_STR              TYPE CHAR10,
        LW_INDEX_WIDTH            TYPE I,
        LW_SEARCH_STR             TYPE CHAR100,
        LW_FLAG                   TYPE C,
        LW_STRING                 TYPE CHAR100.

  " Tham so dung de loc du lieu tu table vao control
  DATA: DESC_TABLE                TYPE REF TO CL_ABAP_STRUCTDESCR,
        LT_TABDESCR               TYPE ABAP_COMPDESCR_TAB,
        LS_TABDESCR               TYPE ABAP_COMPDESCR,
        DESC_STRUC                TYPE REF TO CL_ABAP_STRUCTDESCR.

  DATA: LW_TABLE(30) TYPE C .
  FIELD-SYMBOLS: <P_COMPONENT> TYPE ABAP_COMPDESCR.

  DATA: DYN_TABLE    TYPE REF TO DATA,
        DYN_LINE     TYPE REF TO DATA,
        LS_FIELDCAT  TYPE LVC_S_FCAT,
        LT_FIELDCAT  TYPE LVC_T_FCAT.
  DATA: LT_STYLE        TYPE TABLE OF ZTB_READ_EXCEL WITH HEADER LINE."HIEUTP2 UPDATE 13.06.2014
  GW_HEADER_FLG     = 1.
  GW_STYLE_FLG      = 1.
  GW_TABLE_FLG      = 1.
  GW_COLWIDTH_FLG   = 1.
  " Fill data of width
  SELECT *
  INTO TABLE LT_READ_EXCEL_WIDTH
  FROM ZTB_READ_EXCEL
  WHERE
    ZTB_READ_EXCEL~LEVEL_NUM = 0
    AND ZTB_READ_EXCEL~ROW_NUM = 1
    AND ZTB_READ_EXCEL~REPORT_NAME = REPORT_NAME
  ORDER BY ROW_NUM COL_NUM.

  CLEAR : GT_EXCEL.

  " Fill data of detail
  SELECT *
  INTO TABLE LT_READ_EXCEL_DETAIL
  FROM ZTB_READ_EXCEL
  WHERE
    ZTB_READ_EXCEL~LEVEL_NUM > 0
    AND ZTB_READ_EXCEL~ROW_NUM > 1
    AND ZTB_READ_EXCEL~COL_NUM > 1
    AND ZTB_READ_EXCEL~REPORT_NAME = REPORT_NAME
  ORDER BY ROW_NUM COL_NUM.

  " Get max row detail and min row of detail
  SELECT  MAX( ROW_NUM )
          MIN( ROW_NUM )
    INTO (lw_max_row_detail,
          lw_min_row_detail )
  FROM ZTB_READ_EXCEL
  WHERE
    ZTB_READ_EXCEL~LEVEL_NUM > 0
    AND ZTB_READ_EXCEL~REPORT_NAME = REPORT_NAME.

  " Get dong nho nhat cua footer
  SELECT MIN( ROW_NUM )
  INTO LW_MIN_ROW_FOOTER
  FROM ZTB_READ_EXCEL
  WHERE
    ZTB_READ_EXCEL~LEVEL_NUM < 1
    AND ZTB_READ_EXCEL~ROW_NUM > LW_MAX_ROW_DETAIL
    AND ZTB_READ_EXCEL~REPORT_NAME = REPORT_NAME.

  " Get khoang cach giua row va detail
  LW_NUM_ROW_FOOTER_DETAIL = LW_MIN_ROW_FOOTER - LW_MAX_ROW_DETAIL.
  IF LT_READ_EXCEL_DETAIL IS INITIAL.
    LW_MIN_ROW_DETAIL = 100.
  ENDIF.

  " Fill data of header
  SELECT *
  INTO TABLE LT_READ_EXCEL_HEADER
  FROM ZTB_READ_EXCEL
  WHERE
    ZTB_READ_EXCEL~LEVEL_NUM < 1
    AND ZTB_READ_EXCEL~ROW_NUM > 1
    AND ZTB_READ_EXCEL~ROW_NUM < LW_MIN_ROW_DETAIL
    AND ZTB_READ_EXCEL~COL_NUM > 1
    AND ZTB_READ_EXCEL~REPORT_NAME = REPORT_NAME
  ORDER BY ROW_NUM COL_NUM.

  " Fill data of footer
  SELECT *
  INTO TABLE LT_READ_EXCEL_FOOTER
  FROM ZTB_READ_EXCEL
  WHERE
    ZTB_READ_EXCEL~LEVEL_NUM < 1
    AND ZTB_READ_EXCEL~ROW_NUM > LW_MAX_ROW_DETAIL
    AND ZTB_READ_EXCEL~COL_NUM > 1
    AND ZTB_READ_EXCEL~REPORT_NAME = REPORT_NAME
  ORDER BY ROW_NUM COL_NUM.

  IF LT_READ_EXCEL_DETAIL IS INITIAL AND LT_READ_EXCEL_HEADER IS INITIAL AND LT_READ_EXCEL_FOOTER IS INITIAL
    AND LT_READ_EXCEL_WIDTH IS INITIAL.
    MESSAGE 'Template was not found ! ' TYPE 'S'.
    EXIT.
  ENDIF.

  " Fill header
  CALL FUNCTION 'ZCORE_FM_EXCEL_HEADER'
    TABLES
      T_DATA = GT_EXCEL.
*  get used style export "HIEUTP2 UPDATE 13.06.2014
  LOOP AT LT_READ_EXCEL_HEADER INTO LS_READ_EXCEL_HEADER WHERE STYLE NE ''.
    LT_STYLE-STYLE = LS_READ_EXCEL_HEADER-STYLE.
    APPEND LT_STYLE TO LT_STYLE.
  ENDLOOP.
  LOOP AT LT_READ_EXCEL_DETAIL INTO LS_READ_EXCEL_DETAIL WHERE STYLE NE ''.
    LT_STYLE-STYLE = LS_READ_EXCEL_DETAIL-STYLE.
    APPEND LT_STYLE TO LT_STYLE.
  ENDLOOP.
  LOOP AT LT_READ_EXCEL_FOOTER INTO LS_READ_EXCEL_FOOTER WHERE STYLE NE ''.
    LT_STYLE-STYLE = LS_READ_EXCEL_FOOTER-STYLE.
    APPEND LT_STYLE TO LT_STYLE.
  ENDLOOP.
  LT_STYLE-STYLE = 'NN10CC'.
  APPEND LT_STYLE TO LT_STYLE.
  SORT LT_STYLE BY STYLE.
  DELETE ADJACENT DUPLICATES FROM LT_STYLE COMPARING STYLE.
  "Fill style
  CALL FUNCTION 'ZCORE_FM_EXCEL_STYLE_EXPORT'
    EXPORTING
      I_REPORT_NAME = REPORT_NAME
    TABLES
      T_DATA        = GT_EXCEL
      T_STYLE       = LT_STYLE.
* END OF UPDATE HIEUTP2
  " Field Data
  LW_CUR_ROW = 1.
  LW_CUR_COL = 1.
  LOOP AT LT_READ_EXCEL_HEADER INTO LS_READ_EXCEL_HEADER.
    " Phan header
    CLEAR: LW_OUT_STR, LW_SEARCH_STR,  LW_FIELD_VALUE, LW_CUR_MERGE_NGANG, LW_CUR_MERGE_DOC .
    LW_FIELD_VALUE = LS_READ_EXCEL_HEADER-VALUE.
    LW_CUR_ROW = LS_READ_EXCEL_HEADER-ROW_NUM.
    LW_CUR_COL = LS_READ_EXCEL_HEADER-COL_NUM.
    IF LS_READ_EXCEL_HEADER-MERGE_DOC IS NOT INITIAL.
      LW_CUR_MERGE_DOC = LS_READ_EXCEL_HEADER-MERGE_DOC.
    ELSE.
      LW_CUR_MERGE_DOC = 0.
    ENDIF.
    IF LS_READ_EXCEL_HEADER-MERGE_NGANG IS NOT INITIAL.
      LW_CUR_MERGE_NGANG = LS_READ_EXCEL_HEADER-MERGE_NGANG.
    ELSE.
      LW_CUR_MERGE_NGANG = 0.
    ENDIF.
    WHILE LW_OUT_STR NE '-9999'.
      CALL FUNCTION 'ZCORE_FM_STRING_SPLIT'
        EXPORTING
          STRING_VALUE = LW_FIELD_VALUE
          SEARCH_START = '<'
          SEARCH_END   = '>'
        IMPORTING
          OUT_STRING   = LW_OUT_STR.
      IF LW_OUT_STR IS NOT INITIAL.
        CONCATENATE 'IW_PARAMETER-' LW_OUT_STR INTO LW_STR.
        ASSIGN (LW_STR) TO <FIELD_DETAIL>.
        CLEAR : LW_FIELD_VALUE_STR.
        LW_FIELD_VALUE_STR = <FIELD_DETAIL>.
        IF LW_FIELD_VALUE_STR IS NOT INITIAL.
          REPLACE ALL OCCURRENCES OF '<' IN LW_FIELD_VALUE_STR WITH '&#60;'.
          REPLACE ALL OCCURRENCES OF '>' IN LW_FIELD_VALUE_STR WITH '&#62;'.
        ENDIF.
        CLEAR: LW_SEARCH_STR.
        CONCATENATE '<' LW_OUT_STR '>' INTO LW_SEARCH_STR.
        REPLACE ALL OCCURRENCES OF LW_SEARCH_STR IN LW_FIELD_VALUE WITH LW_FIELD_VALUE_STR.
      ELSE.
        LW_OUT_STR = '-9999'.
      ENDIF.
    ENDWHILE.

    CALL FUNCTION 'ZCORE_FM_EXCEL_TABLE'
      EXPORTING
        I_ROWINDEX    = LW_CUR_ROW
        I_COLINDEX    = LW_CUR_COL
        I_STYLEID     = LS_READ_EXCEL_HEADER-STYLE
        I_CONTENT     = LW_FIELD_VALUE
        I_MERGEACROSS = LW_CUR_MERGE_NGANG
        I_MERGEDOWN   = LW_CUR_MERGE_DOC
        I_TYPEDATA    = 'S'
        I_HEIGHT      = '12.75'
        I_SHEET_NAME  = 'Sheet1'
      TABLES
        T_DATA        = GT_EXCEL.
  ENDLOOP.

  " Doc du lieu table dong, build field struct cho con tro, do du lieu vao table,
  " inser dong detail truoc
  LW_TABLE = STRUCT_NAME.
  DESC_TABLE ?= CL_ABAP_TABLEDESCR=>DESCRIBE_BY_NAME( LW_TABLE ).
  LT_TABDESCR[] = DESC_TABLE->COMPONENTS[].

  LOOP AT LT_TABDESCR INTO LS_TABDESCR.
    CLEAR LS_FIELDCAT.
    LS_FIELDCAT-FIELDNAME = LS_TABDESCR-NAME .
    LS_FIELDCAT-DATATYPE  = LS_TABDESCR-TYPE_KIND.
    LS_FIELDCAT-INTTYPE   = LS_TABDESCR-TYPE_KIND.
    LS_FIELDCAT-INTLEN    = LS_TABDESCR-LENGTH + 10.
    LS_FIELDCAT-DECIMALS  = LS_TABDESCR-DECIMALS.
    APPEND LS_FIELDCAT TO LT_FIELDCAT.
  ENDLOOP.

* Create dynamic internal table and assign to Field-Symbol
  CALL METHOD CL_ALV_TABLE_CREATE=>CREATE_DYNAMIC_TABLE
    EXPORTING
      IT_FIELDCATALOG = LT_FIELDCAT
    IMPORTING
      EP_TABLE        = DYN_TABLE.
  ASSIGN DYN_TABLE->* TO <TABLE_DETAIL>.
* Create dynamic work area and assign to Field Symbol
  CREATE DATA DYN_LINE LIKE LINE OF <TABLE_DETAIL>.
  ASSIGN DYN_LINE->* TO <WA_TABLE_DETAIL>.

  "XUAT RA EXCEL DU LIEU DETAIL.
  LW_CUR_ROW = LW_MIN_ROW_DETAIL.

  LW_SY_ABCDE = SY-ABCDE.
  TRANSLATE LW_SY_ABCDE TO LOWER CASE.
  LOOP AT IT_TABLE_DETAIL.
    CLEAR: LW_OUT_STR, LW_SEARCH_STR, LW_FIELD_VALUE.
    CLEAR : <WA_TABLE_DETAIL>.
    MOVE-CORRESPONDING IT_TABLE_DETAIL TO <WA_TABLE_DETAIL>.
    APPEND <WA_TABLE_DETAIL> TO <TABLE_DETAIL>.
*    LW_STR = '<WA_TABLE_DETAIL>-LEVEL'.
    CONCATENATE '<WA_TABLE_DETAIL>-' FIELD_COMPARE INTO LW_STR.
    "Get level
    ASSIGN (LW_STR) TO <FIELD_LEVEL>.

    LOOP AT LT_READ_EXCEL_DETAIL INTO LS_READ_EXCEL_DETAIL WHERE LEVEL_NUM = <FIELD_LEVEL>.

      CLEAR: LW_OUT_STR, LW_FIELD_VALUE.
      LW_IW_TYPE = 'S'.
*      LW_FLAG = 'X'.
      LW_FIELD_VALUE = LS_READ_EXCEL_DETAIL-VALUE.
      WHILE LW_OUT_STR NE '-9999'.
        CALL FUNCTION 'ZCORE_FM_STRING_SPLIT'
          EXPORTING
            STRING_VALUE = LW_FIELD_VALUE
            SEARCH_START = '<'
            SEARCH_END   = '>'
          IMPORTING
            OUT_STRING   = LW_OUT_STR.
        IF LW_OUT_STR IS NOT INITIAL.
          CONCATENATE '<WA_TABLE_DETAIL>-' LW_OUT_STR INTO LW_STR.
          ASSIGN (LW_STR) TO <FIELD_DETAIL>.
          " Doc table Fieldcat lay ra loai , neu Int la I, D, C
          CLEAR: LW_SEARCH_STR.
          CONCATENATE '<' LW_OUT_STR '>' INTO LW_SEARCH_STR.
          CLEAR : LW_FIELD_VALUE_STR.
          LW_FIELD_VALUE_STR = <FIELD_DETAIL>.
          IF LW_FIELD_VALUE_STR IS NOT INITIAL.
            REPLACE ALL OCCURRENCES OF '<' IN LW_FIELD_VALUE_STR WITH '&#60;'.
            REPLACE ALL OCCURRENCES OF '>' IN LW_FIELD_VALUE_STR WITH '&#62;'.
          ENDIF.
          IF LW_FIELD_VALUE = LW_FIELD_VALUE.
            READ TABLE LT_FIELDCAT INTO LS_FIELDCAT WITH KEY FIELDNAME = LW_OUT_STR .
            LW_IW_TYPE = LS_FIELDCAT-DATATYPE.
            IF LW_IW_TYPE = 'P'.
              LW_IW_TYPE = 'N'.
            ELSEIF LW_IW_TYPE = 'D'.
              LW_IW_TYPE = 'D'.
            ELSE.
              LW_IW_TYPE = 'S'.
            ENDIF.
          ELSE.
            LW_IW_TYPE = 'S'.
          ENDIF.
          REPLACE ALL OCCURRENCES OF LW_SEARCH_STR IN LW_FIELD_VALUE WITH LW_FIELD_VALUE_STR.
        ELSE.
          LW_OUT_STR = '-9999'.
        ENDIF.
      ENDWHILE.
      LW_CUR_COL = LS_READ_EXCEL_DETAIL-COL_NUM.
      IF LS_READ_EXCEL_DETAIL-MERGE_DOC IS NOT INITIAL.
        LW_CUR_MERGE_DOC = LS_READ_EXCEL_DETAIL-MERGE_DOC.
      ELSE.
        LW_CUR_MERGE_DOC = 0.
      ENDIF.
      IF LS_READ_EXCEL_DETAIL-MERGE_NGANG IS NOT INITIAL.
        LW_CUR_MERGE_NGANG = LS_READ_EXCEL_DETAIL-MERGE_NGANG.
      ELSE.
        LW_CUR_MERGE_NGANG = 0.
      ENDIF.

      " NhanNH Fix Ky Tu Dat Biet 20/07/2012
*      REPLACE ALL OCCURRENCES OF '<' IN LW_FIELD_VALUE WITH '&#60;'.
*      REPLACE ALL OCCURRENCES OF '>' IN LW_FIELD_VALUE WITH '&#62;'.
      " End NhanNH

      CALL FUNCTION 'ZCORE_FM_EXCEL_TABLE'
        EXPORTING
          I_ROWINDEX     = LW_CUR_ROW
          I_COLINDEX     = LW_CUR_COL
          I_STYLEID      = LS_READ_EXCEL_DETAIL-STYLE
          I_CONTENT      = LW_FIELD_VALUE
          I_MERGEACROSS  = LW_CUR_MERGE_NGANG
          I_MERGEDOWN    = LW_CUR_MERGE_DOC
          I_TYPEDATA     = LW_IW_TYPE
          I_DISPLAY_ZERO = IW_DISPLAY_ZERO
          I_HEIGHT       = '12.75'
          I_SHEET_NAME   = 'Sheet1'
        TABLES
          T_DATA         = GT_EXCEL.
    ENDLOOP.
    " Xuat ra Excel nhe
*    IF LW_FLAG = 'X'.
    LW_CUR_ROW = LW_CUR_ROW + 1.
*      CLEAR: LW_FLAG.
*    ENDIF.
  ENDLOOP.

  LW_CUR_BEGIN_FOOTER = LW_CUR_ROW - 1.
  LW_CUR_COL = 1.
  LOOP AT LT_READ_EXCEL_FOOTER INTO LS_READ_EXCEL_FOOTER.
    " Phan header
    CLEAR: LW_OUT_STR, LW_SEARCH_STR,  LW_FIELD_VALUE, LW_CUR_MERGE_NGANG, LW_CUR_MERGE_DOC .
    LW_FIELD_VALUE = LS_READ_EXCEL_FOOTER-VALUE.
    LW_CUR_ROW = ( LS_READ_EXCEL_FOOTER-ROW_NUM - LW_MAX_ROW_DETAIL ) + LW_CUR_BEGIN_FOOTER.
    LW_CUR_COL = LS_READ_EXCEL_FOOTER-COL_NUM.
    IF LS_READ_EXCEL_FOOTER-MERGE_DOC IS NOT INITIAL.
      LW_CUR_MERGE_DOC = LS_READ_EXCEL_FOOTER-MERGE_DOC.
    ELSE.
      LW_CUR_MERGE_DOC = 0.
    ENDIF.
    IF LS_READ_EXCEL_FOOTER-MERGE_NGANG IS NOT INITIAL.
      LW_CUR_MERGE_NGANG = LS_READ_EXCEL_FOOTER-MERGE_NGANG.
    ELSE.
      LW_CUR_MERGE_NGANG = 0.
    ENDIF.
    WHILE LW_OUT_STR NE '-9999'.
      CALL FUNCTION 'ZCORE_FM_STRING_SPLIT'
        EXPORTING
          STRING_VALUE = LW_FIELD_VALUE
          SEARCH_START = '<'
          SEARCH_END   = '>'
        IMPORTING
          OUT_STRING   = LW_OUT_STR.

      IF LW_OUT_STR IS NOT INITIAL.
        CONCATENATE 'IW_PARAMETER-' LW_OUT_STR INTO LW_STR.
        ASSIGN (LW_STR) TO <FIELD_DETAIL>.
        CLEAR : LW_FIELD_VALUE_STR.
        LW_FIELD_VALUE_STR = <FIELD_DETAIL>.
        IF LW_FIELD_VALUE_STR IS NOT INITIAL.
          REPLACE ALL OCCURRENCES OF '<' IN LW_FIELD_VALUE_STR WITH '&#60;'.
          REPLACE ALL OCCURRENCES OF '>' IN LW_FIELD_VALUE_STR WITH '&#62;'.
        ENDIF.
        CLEAR: LW_SEARCH_STR.
        CONCATENATE '<' LW_OUT_STR '>' INTO LW_SEARCH_STR.
        REPLACE ALL OCCURRENCES OF LW_SEARCH_STR IN LW_FIELD_VALUE WITH LW_FIELD_VALUE_STR.
      ELSE.
        LW_OUT_STR = '-9999'.
      ENDIF.
    ENDWHILE.

    CALL FUNCTION 'ZCORE_FM_EXCEL_TABLE'
      EXPORTING
        I_ROWINDEX    = LW_CUR_ROW
        I_COLINDEX    = LW_CUR_COL
        I_STYLEID     = LS_READ_EXCEL_FOOTER-STYLE
        I_CONTENT     = LW_FIELD_VALUE
        I_MERGEACROSS = LW_CUR_MERGE_NGANG
        I_MERGEDOWN   = LW_CUR_MERGE_DOC
        I_TYPEDATA    = 'S'
        I_HEIGHT      = '12.75'
        I_SHEET_NAME  = 'Sheet1'
      TABLES
        T_DATA        = GT_EXCEL.
  ENDLOOP.

  LW_INDEX_WIDTH = 1.
  SORT LT_READ_EXCEL_WIDTH BY COL_NUM.
  LOOP AT LT_READ_EXCEL_WIDTH INTO LS_READ_EXCEL_WIDTH.
    LW_CUR_COL_STR = LS_READ_EXCEL_WIDTH-COL_NUM.
    LW_WIDTH_STR = LS_READ_EXCEL_WIDTH-VALUE.
    CONDENSE LW_CUR_COL_STR NO-GAPS.
    CALL FUNCTION 'ZCORE_FM_EXCEL_COLUMN_WIDTH'
      EXPORTING
        I_SHEET_NAME = 'Sheet1'
        I_INDEX      = LW_CUR_COL_STR
        I_WIDTH      = LW_WIDTH_STR
        I_ORDER      = LW_INDEX_WIDTH
      TABLES
        T_DATA       = GT_EXCEL.
    LW_INDEX_WIDTH = LW_INDEX_WIDTH + 1.
  ENDLOOP.

  " Fill footer
  CALL FUNCTION 'ZCORE_FM_EXCEL_FOOTER'
    TABLES
      T_DATA = GT_EXCEL.

  " Generate excel file from xml internal table
  CALL FUNCTION 'ZCORE_FM_EXCEL_GENERATE_FILE'
    EXPORTING
      IW_INPUT_FILE_NAME = REPORT_NAME
    TABLES
      IT_XML_DATA        = GT_EXCEL.
  COMMIT WORK.
*************  FREE DATA
  CLEAR :
  GW_HEADER_FLG,
  GW_STYLE_FLG,
  GW_TABLE_FLG,
  GW_COLWIDTH_FLG,
  GW_ROWINDEX,
  GW_COLINDEX,
  GO_CONTAINER,
  GO_CONTROL,
  GO_DOCUMENT,
  GO_SPREADSHEET,
  GO_ERROR,
  GS_OLE_EXCEL,
  GS_OLE_WORKBOOK,
  GS_OLE_RANGE,
  GS_OLE_CELL,
  GS_DEFAULTS.
  REFRESH :
  GT_EXCEL,
  GT_SHEETS.





ENDFUNCTION.


*Messages
*----------------------------------------------------------
*
* Message class: 00
*001   &1&2&3&4&5&6&7&8
*398   & & & &
*
* Message class: Hard coded
*   Template was not found !
*
* Message class: VZ
*000   & & & &

*
*
