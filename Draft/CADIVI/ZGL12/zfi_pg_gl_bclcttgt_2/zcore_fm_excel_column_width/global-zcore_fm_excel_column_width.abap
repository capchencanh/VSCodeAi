FUNCTION-POOL ZCORE_FG_EXCEL_FUNCTION.      "MESSAGE-ID ..

* INCLUDE LZCORE_FG_EXCEL_FUNCTIOND...       " Local class definition

" XML
DATA: GW_HEADER_FLG(1)    VALUE 1, " flag begin header
      GW_STYLE_FLG(1)     VALUE 1, " flag begin end of style
      GW_TABLE_FLG(1)     VALUE 1, " flag begin end of table.
      GW_COLWIDTH_FLG(1)  VALUE 1, " flag begin column setup.
      GW_ROWINDEX         TYPE P,
      GW_COLINDEX         TYPE P.

DATA: GT_EXCEL TYPE TABLE OF STRING.

