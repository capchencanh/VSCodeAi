      IF E_NAME IS INITIAL.
        E_NAME = LW_NAME1.
      ENDIF.

      E_NAME1 = LW_NAME1.
      CONDENSE: E_NAME, E_NAME1.

      " Dia chi
*      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
      IF LW_COUNTRY IS NOT INITIAL.
        SELECT SINGLE LANDX
          INTO LW_COUNTRY_NAME
          FROM T005T
          WHERE SPRAS EQ SY-LANGU
            AND LAND1 EQ LW_COUNTRY.
      ENDIF.

      " Dia chi
      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
      "thay đổi cách lấy street của Customer không có lấy thêm trường city + description của Country
      "Binh.Tran
      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS.

      " Tel, Fax, Tax, Email
*      E_TAX = LW_TAX.
      PERFORM GET_TAX_BP_CUST USING P_NUMBER
                              CHANGING E_TAX.

      E_TEL_NUMBER = LW_TEL_NUMBER.
      E_FAX_NUMBER = LW_FAX_NUMBER.
    ENDIF.


    " Lay Thong Tin Customer
    "tên tieng Anh
    SELECT  SINGLE
    KNA1~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    KNA1~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    KNA1~ANRED
    ADRC~LOCATION
    INTO (LW_ADRNR,
    LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_HOUSE_NUM1,
    LW_HOUSE_NUM2,
    LW_HOUSE_NUM3,
    LW_STR_SUPPL1,
    LW_STR_SUPPL2,
    LW_STR_SUPPL3,
    LW_STREET,
    LW_CITY1,
    LW_CITY2,
    LW_COUNTRY,
    LW_TAX,
    LW_TEL_NUMBER,
    LW_FAX_NUMBER,
    LW_EMAIL,
    LW_E_TITLE,
    LW_LOCATION)
    FROM KNA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = KNA1~ADRNR AND ADRC~NATION EQ 'I'
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = KNA1~ADRNR
    WHERE KUNNR EQ P_NUMBER.

    IF SY-SUBRC EQ 0.
      " Ten Vendor
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
      IF E_NAME_N_TITLE IS INITIAL.
        E_NAME_N_TITLE = LW_NAME1.
      ENDIF.

      E_NAME1 = LW_NAME1.
      CONDENSE: E_NAME, E_NAME1.

      " Dia chi
*      CLEAR: E_ADDRESS_EN.
*      CONCATENATE LW_STREET LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS_EN SEPARATED BY SPACE.
      IF LW_COUNTRY IS NOT INITIAL.
        SELECT SINGLE LANDX
          INTO LW_COUNTRY_NAME
          FROM T005T
          WHERE SPRAS EQ SY-LANGU
            AND LAND1 EQ LW_COUNTRY.
      ENDIF.

      " Dia chi
      CLEAR: E_ADDRESS.
*      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
      CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS_EN.
    ENDIF.

    E_EMAIL1 = LW_EMAIL.
    LW_EMAIL = E_EMAIL.
    PERFORM GET_EMAIL_BP_CUST
      USING P_NUMBER
      CHANGING LW_EMAIL
               E_PARTNER.
  ELSE.
    SELECT  SINGLE
    ANRED AS TITLE
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    ADRNR
    INTAD
    INTO (LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STRAS,
    LW_ORT01,
    LW_LAND1,
    LW_STCD1,
    LW_E_TITLE,
    LW_ADRNR,
    LW_EMAIL)
    FROM  BSEC
    WHERE BUKRS = P_BUKRS
    AND GJAHR = P_GJAHR
    AND BELNR = P_BELNR.
    IF SY-SUBRC <> 0.
      SELECT  SINGLE
            ADRC~TITLE
            ADRC~NAME1
            ADRC~NAME2
            ADRC~NAME3
            ADRC~NAME4
            ADRC~HOUSE_NUM1
            ADRC~HOUSE_NUM2
            ADRC~HOUSE_NUM3
            ADRC~STR_SUPPL1
            ADRC~STR_SUPPL2
            ADRC~STR_SUPPL3
            ADRC~STREET
            ADRC~CITY1
            ADRC~CITY2
            ADRC~COUNTRY
            ADRC~TEL_NUMBER
            ADRC~FAX_NUMBER
            ADR6~SMTP_ADDR
            INTO (LW_TITLE,
            LW_NAME1,
            LW_NAME2,
            LW_NAME3,
            LW_NAME4,
            LW_HOUSE_NUM1,
            LW_HOUSE_NUM2,
            LW_HOUSE_NUM3,
            LW_STR_SUPPL1,
            LW_STR_SUPPL2,
            LW_STR_SUPPL3,
            LW_STREET,
            LW_CITY1,
            LW_CITY2,
            LW_COUNTRY,
            LW_TEL_NUMBER,
            LW_FAX_NUMBER,
            LW_EMAIL)
         FROM ADRC "ON ADRC~ADDRNUMBER = BSEC~ADRNR
         LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = ADRC~ADDRNUMBER
         WHERE ADRC~ADDRNUMBER = LW_ADRNR.
    ENDIF.


    SELECT  SINGLE
    ANRED AS TITLE
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    INTAD
    INTO (LW_TITLE,
    LW_NAME1,
    LW_NAME2,
    LW_NAME3,
    LW_NAME4,
    LW_STRAS,
    LW_ORT01,
    LW_LAND1,
    LW_STCD1,
    LW_E_TITLE,
    LW_EMAIL)
    FROM  VBSEC
    WHERE AUSBK = P_BUKRS
    AND GJAHR = P_GJAHR
    AND BELNR = P_BELNR.

    "TITLE
    E_TITLE = LW_E_TITLE.
    CONDENSE E_TITLE.

    " Ten Customer One time Name = Name 1 + Name 2 + Name 3 + Name 4
    CLEAR: E_NAME.
    CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    IF E_NAME IS INITIAL.
      E_NAME = LW_NAME1 .
    ENDIF.
    E_NAME1 = LW_NAME1.
    CONDENSE: E_NAME, E_NAME1.

    " Dia chi
*
*    CLEAR: E_ADDRESS.
*    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
    IF LW_LAND1 IS NOT INITIAL.
      SELECT SINGLE LANDX
        INTO LW_COUNTRY_NAME
        FROM T005T
        WHERE SPRAS EQ SY-LANGU
          AND LAND1 EQ LW_LAND1.
    ENDIF.

    " Dia chi
    CLEAR: E_ADDRESS.
*    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.
*
    IF LW_XCPDK EQ 'X'.
      CLEAR: E_ADDRESS.
      CONCATENATE LW_STRAS LW_ORT01 INTO E_ADDRESS SEPARATED BY SPACE.
      CONDENSE E_ADDRESS.
    ENDIF.

    " Tel, Fax, Tax, Email
    E_TAX = LW_STCD1.
    E_TEL_NUMBER = ''.
    E_FAX_NUMBER = ''.
  ENDIF.

  E_EMAIL = LW_EMAIL.
  REPLACE 'VN' IN E_TAX WITH ''.
ENDFORM.                    "GET_CUS_ADDRESS

