*&---------------------------------------------------------------------*
*&      Form  CALCULATION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GW_R1  text
*      -->P_GW_R1  text
*      -->P_GT_POSTFIX  text
*      <--P_GW_R1  text
*----------------------------------------------------------------------*
FORM CALCULATION  USING    P_R2       TYPE DEC20_2
                           P_POSTFIX  TYPE STRING
                  CHANGING P_R1       TYPE DEC20_2.
  CASE P_POSTFIX.
    WHEN '+'.
      P_R1 = P_R2 + P_R1.
    WHEN '-'.
      P_R1 = P_R2 - P_R1.
    WHEN '*'.
      P_R1 = P_R2 * P_R1.
    WHEN '/'.
      P_R1 = P_R2 / P_R1.
  ENDCASE.

ENDFORM.                    " CALCULATION
*&---------------------------------------------------------------------*
*&      Form  CHECK_NUMBER
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_POSTFIX  text
*----------------------------------------------------------------------*
FORM CHECK_NUMBER  USING    P_POSTFIX.
  DATA: OUTPUT_INTEGER TYPE P.

  CATCH SYSTEM-EXCEPTIONS
    ARITHMETIC_ERRORS = 1
    CONVERSION_ERRORS = 2.
    CONDENSE P_POSTFIX NO-GAPS.
    OUTPUT_INTEGER = P_POSTFIX.
  ENDCATCH.
ENDFORM.                    " CHECK_NUMBER
