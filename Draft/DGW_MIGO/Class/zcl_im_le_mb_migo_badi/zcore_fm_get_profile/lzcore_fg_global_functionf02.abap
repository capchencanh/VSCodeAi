  ADRC~LOCATION
  INTO CORRESPONDING FIELDS OF TABLE E_T_EXPORT
  FROM KNA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = KNA1~ADRNR
            LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = KNA1~ADRNR
  WHERE KUNNR IN LR_OBJECT.

  IF I_BELNR IS NOT INITIAL.
    SELECT SINGLE
    BUKRS  AS  I_BUKRS
    GJAHR  AS  I_GJAHR
    BELNR  AS  I_BELNR
    BUZEI  AS  I_BUZEI
    ANRED
    NAME1
    NAME2
    NAME3
    NAME4
    STRAS
    ORT01
    LAND1
    STCD1
    ANRED
    ADRNR
    INTO CORRESPONDING FIELDS OF I_S_EXPORT
    FROM  BSEC
    WHERE BUKRS EQ I_BUKRS
      AND GJAHR EQ I_GJAHR
      AND BELNR EQ I_BELNR
      AND BUZEI EQ I_BUZEI.

    IF SY-SUBRC NE 0.
      SELECT SINGLE
      AUSBK  AS  I_BUKRS
      GJAHR  AS  I_GJAHR
      BELNR  AS  I_BELNR
      BUZEI  AS  I_BUZEI
      ANRED
      NAME1
      NAME2
      NAME3
      NAME4
      STRAS
      ORT01
      LAND1
      STCD1
      ANRED
      INTO CORRESPONDING FIELDS OF I_S_EXPORT
      FROM  VBSEC
      WHERE AUSBK EQ I_BUKRS
        AND GJAHR EQ I_GJAHR
        AND BELNR EQ I_BELNR
        AND BUZEI EQ I_BUZEI.
      IF SY-SUBRC NE 0.
        SELECT SINGLE
        BUKRS  AS  I_BUKRS
        GJAHR  AS  I_GJAHR
        BELNR  AS  I_BELNR
        BUZEI  AS  I_BUZEI
        ANRED
        NAME1
        NAME2
        NAME3
        NAME4
        STRAS
        ORT01
        LAND1
        STCD1
        ANRED
        ADRNR
        INTO CORRESPONDING FIELDS OF I_S_EXPORT
        FROM  BSEC
        WHERE BUKRS EQ I_BUKRS
          AND GJAHR EQ I_GJAHR
          AND BELNR EQ I_BELNR.
        IF SY-SUBRC NE 0.
          SELECT SINGLE
          AUSBK  AS  I_BUKRS
          GJAHR  AS  I_GJAHR
          BELNR  AS  I_BELNR
          BUZEI  AS  I_BUZEI
          ANRED
          NAME1
          NAME2
          NAME3
          NAME4
          STRAS
          ORT01
          LAND1
          STCD1
          ANRED
          INTO CORRESPONDING FIELDS OF I_S_EXPORT
          FROM  VBSEC
          WHERE AUSBK EQ I_BUKRS
            AND GJAHR EQ I_GJAHR
            AND BELNR EQ I_BELNR.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

  LOOP AT E_T_EXPORT ASSIGNING <FS_PROFILE>.
    <FS_PROFILE>-E_KTOKL = <FS_PROFILE>-KTOKL.

    IF <FS_PROFILE>-XCPDK NE 'X'.
*    "TITLE
      <FS_PROFILE>-E_TITLE = <FS_PROFILE>-ANRED.
      CONDENSE <FS_PROFILE>-E_TITLE.

      " Ten Customer
