  FROM T001W INNER JOIN ADRC ON ADRC~ADDRNUMBER = T001W~ADRNR AND ADRC~NATION EQ 'I'
  LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = T001W~ADRNR
  LEFT JOIN ADRCT ON ADRCT~ADDRNUMBER = T001W~ADRNR AND ADRCT~NATION EQ 'I'
