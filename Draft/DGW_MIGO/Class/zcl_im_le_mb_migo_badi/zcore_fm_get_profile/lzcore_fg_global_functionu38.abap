FUNCTION ZCORE_FM_GET_PROFILE_SD.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_NUMBER) TYPE  CHAR10 OPTIONAL
*"     REFERENCE(I_VBELN) TYPE  VBELN
*"     REFERENCE(I_TYPE) TYPE  PARVW
*"  EXPORTING
*"     REFERENCE(E_NAME) TYPE  CHAR255
*"     REFERENCE(E_ADDRESS) TYPE  CHAR255
*"     REFERENCE(E_TAX) TYPE  CHAR255
*"     REFERENCE(E_TEL_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_FAX_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_EMAIL) TYPE  CHAR255
*"     REFERENCE(E_NAME_N_TITLE) TYPE  CHAR255
*"     REFERENCE(E_NAME1) TYPE  CHAR255
*"     REFERENCE(E_TITLE) TYPE  TEXT15
*"     REFERENCE(E_KTOKL) TYPE  KTOKL_077T
*"     REFERENCE(E_KTOKL_NAME) TYPE  TXT30_077T
*"     REFERENCE(E_COUNTRY) TYPE  LAND1
*"     REFERENCE(E_POST_CODE1) TYPE  AD_PSTCD1
*"     REFERENCE(E_ADDRESS_STREET) TYPE  CHAR255
*"     REFERENCE(E_ACCOUNT) TYPE  KUNNR
*"     REFERENCE(E_KOART) TYPE  KOART
*"     REFERENCE(E_PARTNER) TYPE  BU_PARTNER
*"     REFERENCE(E_NAME_F) TYPE  CHAR255
*"     REFERENCE(E_KUNNR) TYPE  CHAR10
*"--------------------------------------------------------------------
DATA: LW_XCPDK        TYPE KNA1-XCPDK,
        LW_KTOKL        TYPE KTOKL_077T,
        LW_KTOKL_NAME   TYPE TXT30_077T,

        LW_ADRNR        TYPE T001-ADRNR,
        LW_KUNNR        TYPE VBPA-KUNNR,
        LW_LIFNR        TYPE VBPA-LIFNR,
        LW_TITLE        TYPE ADRC-TITLE,
        LW_NAME1        TYPE ADRC-NAME1,
        LW_NAME2        TYPE ADRC-NAME2,
        LW_NAME3        TYPE ADRC-NAME3,
        LW_NAME4        TYPE ADRC-NAME4,
        LW_HOUSE_NUM1   TYPE ADRC-HOUSE_NUM1,
        LW_HOUSE_NUM2   TYPE ADRC-HOUSE_NUM2,
        LW_HOUSE_NUM3   TYPE ADRC-HOUSE_NUM3,
        LW_STR_SUPPL1   TYPE AD_STRSPP1,
        LW_STR_SUPPL2   TYPE AD_STRSPP1,
        LW_STR_SUPPL3   TYPE AD_STRSPP1,
        LW_STREET       TYPE ADRC-STREET,
        LW_CITY1        TYPE ADRC-CITY1,
        LW_CITY2        TYPE ADRC-CITY2,
        LW_COUNTRY      TYPE ADRC-COUNTRY,
        LW_COUNTRY_NAME TYPE T005T-LANDX,
        LW_LOCATION     TYPE AD_LCTN,
        LW_TAX          TYPE T001-STCEG,
        LW_TEL_NUMBER   TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER   TYPE ADRC-FAX_NUMBER,
        LW_EMAIL        TYPE ADR6-SMTP_ADDR,
        LW_E_TITLE      TYPE TEXT15,

        LW_STRAS        TYPE BSEC-STRAS,
        LW_ORT01        TYPE BSEC-ORT01,
        LW_LAND1        TYPE BSEC-LAND1,
        LW_STCD1        TYPE BSEC-STCD1,
        LW_POST_CODE1   TYPE AD_PSTCD1.
  SELECT SINGLE
    VBPA~ADRNR
    VBPA~KUNNR
    VBPA~LIFNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    VBPA~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    ADRC~TITLE
    ADRC~POST_CODE1
    ADRC~LOCATION
  INTO
    (LW_ADRNR,
     LW_KUNNR,
     LW_LIFNR,
     LW_TITLE,
     LW_NAME1,
     LW_NAME2,
     LW_NAME3,
     LW_NAME4,
     LW_HOUSE_NUM1,
     LW_HOUSE_NUM2,
     LW_HOUSE_NUM3,
     LW_STR_SUPPL1,
     LW_STR_SUPPL2,
     LW_STR_SUPPL3,
     LW_STREET,
     LW_CITY1,
     LW_CITY2,
     LW_COUNTRY,
     LW_TAX,
     LW_TEL_NUMBER,
     LW_FAX_NUMBER,
     LW_EMAIL,
     LW_E_TITLE,
     E_POST_CODE1,
     LW_LOCATION)
  FROM VBPA INNER JOIN ADRC ON ADRC~ADDRNUMBER = VBPA~ADRNR
            LEFT  JOIN ADR6 ON ADR6~ADDRNUMBER = VBPA~ADRNR
  WHERE VBPA~VBELN = I_VBELN
    AND VBPA~PARVW = I_TYPE.

  " lấy dữ liệu từ shipment
  IF SY-SUBRC NE 0.
    SELECT SINGLE
      VTPA~ADRNR
      ADRC~TITLE
      ADRC~NAME1
      ADRC~NAME2
      ADRC~NAME3
      ADRC~NAME4
      ADRC~HOUSE_NUM1
      ADRC~HOUSE_NUM2
      ADRC~HOUSE_NUM3
      ADRC~STR_SUPPL1
      ADRC~STR_SUPPL2
      ADRC~STR_SUPPL3
      ADRC~STREET
      ADRC~CITY1
      ADRC~CITY2
      ADRC~COUNTRY
      ADRC~TEL_NUMBER
      ADRC~FAX_NUMBER
      ADR6~SMTP_ADDR
      ADRC~TITLE
      ADRC~POST_CODE1
      ADRC~LOCATION
    INTO
      (LW_ADRNR,
       LW_TITLE,
       LW_NAME1,
       LW_NAME2,
       LW_NAME3,
       LW_NAME4,
       LW_HOUSE_NUM1,
       LW_HOUSE_NUM2,
       LW_HOUSE_NUM3,
       LW_STR_SUPPL1,
       LW_STR_SUPPL2,
       LW_STR_SUPPL3,
       LW_STREET,
       LW_CITY1,
       LW_CITY2,
       LW_COUNTRY,
       LW_TEL_NUMBER,
       LW_FAX_NUMBER,
       LW_EMAIL,
       LW_E_TITLE,
       E_POST_CODE1,
       LW_LOCATION)
    FROM VTPA INNER JOIN ADRC ON ADRC~ADDRNUMBER = VTPA~ADRNR
              LEFT  JOIN ADR6 ON ADR6~ADDRNUMBER = VTPA~ADRNR
    WHERE VTPA~VBELN = I_VBELN
      AND VTPA~PARVW = I_TYPE.
  ENDIF.

  LW_EMAIL = E_EMAIL.
  IF LW_KUNNR IS NOT INITIAL.
    E_ACCOUNT = LW_KUNNR.
    E_KOART   = 'D'.

    PERFORM GET_EMAIL_BP_CUST
      USING E_ACCOUNT
      CHANGING LW_EMAIL
               E_PARTNER.
  ENDIF.

  IF LW_LIFNR IS NOT INITIAL.
    E_ACCOUNT = LW_LIFNR.
    E_KOART   = 'K'.

    PERFORM GET_EMAIL_BP_VEND
      USING E_ACCOUNT
      CHANGING LW_EMAIL
               E_PARTNER.
  ENDIF.

  SELECT SINGLE
    KNA1~ANRED
  INTO
     LW_E_TITLE
  FROM KNA1
  WHERE KUNNR EQ I_NUMBER.

  "TITLE
  E_TITLE = LW_E_TITLE.
  CONDENSE E_TITLE.
  "Country
  E_COUNTRY = LW_COUNTRY.
  CONDENSE E_COUNTRY.

  " Ten Customer
  CLEAR: E_NAME.
  IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
    E_NAME = LW_NAME1.
  ELSE.
    CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
  ENDIF.

  CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_F SEPARATED BY SPACE.
  IF E_NAME_F IS INITIAL.
    E_NAME_F = LW_NAME1.
  ENDIF.

  E_NAME1 = LW_NAME1.
  CONDENSE: E_NAME, E_NAME1.

  CLEAR: E_NAME_N_TITLE.
  IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
    E_NAME_N_TITLE = LW_NAME1.
  ELSE.
    CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
  ENDIF.

  CONDENSE E_NAME_N_TITLE.

  IF LW_COUNTRY IS NOT INITIAL.
    SELECT SINGLE LANDX
      INTO LW_COUNTRY_NAME
      FROM T005T
      WHERE SPRAS EQ SY-LANGU
        AND LAND1 EQ LW_COUNTRY.
  ENDIF.

  " Dia chi
  CLEAR: E_ADDRESS.
*  CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS SEPARATED BY SPACE.
  CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
  CONDENSE E_ADDRESS.
  " Dia chi street
  CLEAR: E_ADDRESS_STREET.
  CONCATENATE LW_HOUSE_NUM1 LW_HOUSE_NUM2 LW_HOUSE_NUM3 LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3  LW_CITY2 LW_CITY1 LW_COUNTRY_NAME INTO E_ADDRESS_STREET SEPARATED BY SPACE.
  CONDENSE E_ADDRESS_STREET.

  " Tel, Fax, Tax, Email
**** FPT HieuDV modify 22/10/2013
*    E_TAX = LW_TAX.
  IF LW_TAX IS INITIAL.
    PERFORM GET_TAX USING LW_TAX E_ACCOUNT
             CHANGING E_TAX.
  ENDIF.
**** FPT HieuDV modify 22/10/2013

  E_TEL_NUMBER = LW_TEL_NUMBER.
  E_FAX_NUMBER = LW_FAX_NUMBER.
  E_EMAIL      = LW_EMAIL.
  E_KUNNR      = LW_KUNNR.

*  ENDIF.





ENDFUNCTION.

