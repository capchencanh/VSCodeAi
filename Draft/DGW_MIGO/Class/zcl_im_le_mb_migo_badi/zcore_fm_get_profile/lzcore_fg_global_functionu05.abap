FUNCTION ZCORE_CONVERT_CHAR_DECIMALS_2.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(INPUT_NUM)
*"     VALUE(DECIMALS) TYPE  CHAR3 DEFAULT '2'
*"     VALUE(I_USER) TYPE  UNAME DEFAULT 'CT.ABAP'
*"     REFERENCE(I_X) TYPE  INT4 DEFAULT 1
*"     VALUE(INPUT_NUM2) TYPE  ZDE_13P3 OPTIONAL
*"  EXPORTING
*"     REFERENCE(OUTPUT_NUM)
*"--------------------------------------------------------------------
DATA:
    E_TEXT            TYPE CHAR255,
    LV_THOUSAN         TYPE FLAG,
    LV_FORMAT         TYPE FLAG,
    LV_LENGH_ZERO     TYPE INT4,
    LV_LENGH_INPUT    TYPE INT4,
    LV_LENGH_OUTPUT   TYPE INT4,
    LV_COMMA_LOCATION TYPE INT4,
    LV_DECIMALS       TYPE INT4.

  TYPES:
    BEGIN OF LTY_USER_FORMAT,
      BNAME TYPE USR01-BNAME,
      DCPFM TYPE USR01-DCPFM,
    END OF LTY_USER_FORMAT.

  DATA:
    GS_USER TYPE LTY_USER_FORMAT.

  DATA: LR_PACKED  TYPE REF TO DATA.
  DATA: LR_PACKED2 TYPE REF TO DATA.

  FIELD-SYMBOLS: <FS_PACKED>  TYPE ANY.
  FIELD-SYMBOLS: <FS_PACKED2> TYPE ANY.



  "get data user format
  SELECT SINGLE
    BNAME
    DCPFM
    INTO GS_USER
    FROM USR01
    WHERE BNAME EQ I_USER.

  IF GS_USER-DCPFM EQ 'X'."1,000.000
    LV_THOUSAN = ','.
    LV_FORMAT = '.'.
  ELSEIF GS_USER-DCPFM IS INITIAL."1.000,000
    LV_THOUSAN = '.'.
    LV_FORMAT = ','.
  ELSEIF GS_USER-DCPFM EQ 'Y'."1000,000
    LV_THOUSAN = ''.
    LV_FORMAT = ','.
  ENDIF.




  LV_DECIMALS = DECIMALS.

  CREATE DATA LR_PACKED TYPE P DECIMALS LV_DECIMALS.
  ASSIGN LR_PACKED->* TO <FS_PACKED>.

  REPLACE ALL OCCURRENCES OF LV_THOUSAN IN INPUT_NUM WITH ''.
  REPLACE LV_FORMAT  IN INPUT_NUM WITH '.'.



  <FS_PACKED>  = INPUT_NUM.

  " Su dung cho tcode zqm03 x 100
  OUTPUT_NUM = <FS_PACKED> * I_X + INPUT_NUM2.
*  WRITE <FS_PACKED> TO E_TEXT.

*  REPLACE ALL OCCURRENCES OF LV_THOUSAN IN E_TEXT WITH ''.
*  REPLACE LV_FORMAT  IN E_TEXT WITH '.'.
*
*  CONDENSE E_TEXT.
*
*  OUTPUT_NUM = E_TEXT.





ENDFUNCTION.

