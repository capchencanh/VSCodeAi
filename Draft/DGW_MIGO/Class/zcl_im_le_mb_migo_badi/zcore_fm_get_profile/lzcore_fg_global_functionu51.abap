  IF I_KOSTL EQ 'X'.
    LW_WHERE = `CSKT~KOSTL EQ @GT_DATA-KOSTL`.
    SELECT *
    INTO TABLE @DATA(LT_CSKT)
    FROM CSKT
    FOR ALL ENTRIES IN @GT_DATA
    WHERE CSKT~SPRAS EQ 'E' AND
          CSKT~DATBI GE @SY-DATUM AND
          (LW_WHERE).
    IF LT_CSKT IS NOT INITIAL.
      SORT LT_CSKT BY KOSTL.
    ENDIF.
