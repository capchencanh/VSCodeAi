*"     VALUE(I_KOSTL) TYPE  CHECKBOX OPTIONAL
*"  TABLES
*"      GT_DATA
*"--------------------------------------------------------------------
DATA: LW_WHERE TYPE STRING.
  IF I_MTART EQ 'X'.
    LW_WHERE = `T134T~MTART EQ @GT_DATA-MTART`.

    SELECT *
    INTO TABLE @DATA(LT_T134T)
    FROM T134T
    FOR ALL ENTRIES IN @GT_DATA
    WHERE T134T~SPRAS EQ 'E' AND
          (LW_WHERE).
    IF LT_T134T IS NOT INITIAL.
      SORT LT_T134T BY MTART.
    ENDIF.
  ENDIF.

  IF I_MATKL EQ 'X'.
    LW_WHERE = `T023T~MATKL EQ @GT_DATA-MATKL`.

