FUNCTION ZCORE_FM_GET_LONG_TEXT_MULTI_1.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  TABLES
*"      T_TEXT_TABLE TYPE  TEXT_LH OPTIONAL
*"      T_LTEXT STRUCTURE  ZST_LTEXT_LTEXT1_ONLY
*"----------------------------------------------------------------------
  DATA:
*        <LF_TEXT_TABLE>  TYPE ITCLH,
    LT_ERROR       TYPE TEXT_LH,
    LT_TEXT_HEADER TYPE TABLE OF THEAD,
    LS_TEXT_HEADER TYPE THEAD.
*        <LF_TLINE>       TYPE TLINE.
  FIELD-SYMBOLS:
    <LF_LTEXT>      TYPE ZST_LTEXT_LTEXT1_ONLY,
    <LF_TEXT_TABLE> TYPE ITCLH,
    <LF_TLINE>      TYPE TLINE.

  "Fill language
  LOOP AT T_LTEXT ASSIGNING <LF_LTEXT> WHERE TDSPRAS IS INITIAL.
    <LF_LTEXT>-TDSPRAS = SY-LANGU.
  ENDLOOP.

  SORT T_LTEXT BY TDOBJECT  ASCENDING
                TDNAME    ASCENDING
                TDID      ASCENDING
                TDSPRAS   ASCENDING.
  DELETE ADJACENT DUPLICATES FROM T_LTEXT COMPARING TDOBJECT TDNAME TDID TDSPRAS.

  "Fill Text Header
  MOVE-CORRESPONDING T_LTEXT[] TO LT_TEXT_HEADER.

  "Get Multiple Long Text
  CALL FUNCTION 'READ_TEXT_TABLE'
    IMPORTING
      TEXT_TABLE              = T_TEXT_TABLE[]
      ERROR_TABLE             = LT_ERROR
    TABLES
      TEXT_HEADERS            = LT_TEXT_HEADER
    EXCEPTIONS
      WRONG_ACCESS_TO_ARCHIVE = 1
      OTHERS                  = 2.
  IF SY-SUBRC = 0.
    LOOP AT T_TEXT_TABLE ASSIGNING <LF_TEXT_TABLE>.
      READ TABLE T_LTEXT ASSIGNING <LF_LTEXT>
        WITH KEY TDOBJECT = <LF_TEXT_TABLE>-HEADER-TDOBJECT
                 TDNAME = <LF_TEXT_TABLE>-HEADER-TDNAME
                 TDID = <LF_TEXT_TABLE>-HEADER-TDID
                 TDSPRAS = <LF_TEXT_TABLE>-HEADER-TDSPRAS BINARY SEARCH.
      IF SY-SUBRC = 0.
        LOOP AT <LF_TEXT_TABLE>-LINES ASSIGNING <LF_TLINE>.
          CONCATENATE <LF_LTEXT>-LTEXT1 <LF_TLINE>-TDLINE INTO <LF_LTEXT>-LTEXT1 SEPARATED BY SPACE.
        ENDLOOP.
        "Replace special character when use special character like & of LTEXT1
        IF <LF_LTEXT>-LTEXT1 CA '&'.
          REPLACE ALL OCCURRENCES OF '<(>' IN <LF_LTEXT>-LTEXT1 WITH SPACE.
          REPLACE ALL OCCURRENCES OF '<)>' IN <LF_LTEXT>-LTEXT1 WITH SPACE.
        ENDIF.
        CONDENSE: <LF_LTEXT>-LTEXT1.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFUNCTION.

