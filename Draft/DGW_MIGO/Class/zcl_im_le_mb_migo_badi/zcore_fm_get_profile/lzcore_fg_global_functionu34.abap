FUNCTION ZCORE_FM_GET_PROFILE.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_NUMBER)
*"     REFERENCE(I_KIND) TYPE  CHAR01
*"     REFERENCE(I_BUKRS) TYPE  BUKRS OPTIONAL
*"     REFERENCE(I_BELNR) TYPE  BELNR_D OPTIONAL
*"     REFERENCE(I_GJAHR) TYPE  GJAHR OPTIONAL
*"     REFERENCE(I_ONCECUS) TYPE  CHAR01 OPTIONAL
*"     REFERENCE(I_NATION) TYPE  AD_NATION OPTIONAL
*"     REFERENCE(I_COUNTRY) OPTIONAL
*"     REFERENCE(I_ADRNR) OPTIONAL
*"     REFERENCE(I_PARVW) TYPE  PARVW OPTIONAL
*"  EXPORTING
*"     REFERENCE(E_NAME) TYPE  CHAR255
*"     REFERENCE(E_ADDRESS) TYPE  CHAR255
*"     REFERENCE(E_TAX) TYPE  CHAR255
*"     REFERENCE(E_TEL_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_FAX_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_EMAIL) TYPE  CHAR255
*"     REFERENCE(E_EMAIL1) TYPE  CHAR255
*"     REFERENCE(E_NAME_N_TITLE) TYPE  CHAR255
*"     REFERENCE(E_TITLE) TYPE  TEXT15
*"     REFERENCE(E_NAME1) TYPE  CHAR255
*"     REFERENCE(E_KTOKL) TYPE  KTOKL_077T
*"     REFERENCE(E_KTOKL_NAME) TYPE  TXT30_077T
*"     REFERENCE(E_REMARK) TYPE  CHAR255
*"     REFERENCE(E_ADDRESS_EN) TYPE  CHAR255
*"     REFERENCE(E_ONECUS) TYPE  CHAR1
*"     REFERENCE(E_WEB) TYPE  URL
*"     REFERENCE(E_PARTNER) TYPE  BU_PARTNER
*"     REFERENCE(E_STREET1) TYPE  CHAR255
*"     REFERENCE(E_STREET2) TYPE  CHAR255
*"     REFERENCE(E_CITY) TYPE  CHAR255
*"     REFERENCE(E_MOB_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_BANKN) TYPE  CHAR255
*"     REFERENCE(E_BRANCH) TYPE  CHAR255
*"     REFERENCE(E_COUNTRY)
*"     REFERENCE(E_CMND)
*"     REFERENCE(E_SEARCH1) TYPE  AD_SORT1
*"----------------------------------------------------------------------
DATA: LS_PROFILE TYPE ZST_PROFILE.
  CLEAR:
  LS_PROFILE.

  LS_PROFILE-NUMBER       = I_NUMBER.
  LS_PROFILE-KIND         = I_KIND.
  LS_PROFILE-NATION       = I_NATION.
  LS_PROFILE-BUKRS        = I_BUKRS.
  LS_PROFILE-BELNR        = I_BELNR.
  LS_PROFILE-GJAHR        = I_GJAHR.
  LS_PROFILE-GET_COUNTRY  = I_COUNTRY.
  LS_PROFILE-ADRNR        = I_ADRNR.
  LS_PROFILE-PARVW        = I_PARVW.

  CALL FUNCTION 'ZCORE_FM_GET_PROFILE_MULT'
    IMPORTING
      ES_HEAD = LS_PROFILE.

  E_NAME         = LS_PROFILE-NAME         .
  E_ADDRESS      = LS_PROFILE-ADDRESS      .
  E_TAX          = LS_PROFILE-TAX          .
  E_TEL_NUMBER   = LS_PROFILE-TEL_NUMBER   .
  E_FAX_NUMBER   = LS_PROFILE-FAX_NUMBER   .
  E_EMAIL        = LS_PROFILE-EMAIL        .
  E_NAME_N_TITLE = LS_PROFILE-NAME         .
  E_NAME1        = LS_PROFILE-NAME1        .
  E_TITLE        = LS_PROFILE-TITLE        .
  E_REMARK       = LS_PROFILE-REMARK       .
  E_ADDRESS      = LS_PROFILE-ADDRESS      .
  E_ONECUS       = LS_PROFILE-ONECUS       .
  E_PARTNER      = LS_PROFILE-PARTNER      .
  E_CITY         = LS_PROFILE-CITY1        .
  E_MOB_NUMBER   = LS_PROFILE-MOBILE_NUMBER.
  E_BANKN        = LS_PROFILE-BANKN        .
  E_BRANCH       = LS_PROFILE-BRANCH       .
  E_COUNTRY      = LS_PROFILE-COUNTRY      .
  E_CMND         = LS_PROFILE-CMND         .
  E_SEARCH1 = LS_PROFILE-SEARCH_TERM1 .





ENDFUNCTION.

*
