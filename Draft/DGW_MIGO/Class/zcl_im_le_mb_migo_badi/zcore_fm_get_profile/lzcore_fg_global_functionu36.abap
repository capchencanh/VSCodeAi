FUNCTION ZCORE_FM_GET_PROFILE_MM1.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_NUMBER) TYPE  CHAR10
*"     REFERENCE(I_EBELN) TYPE  EBELN OPTIONAL
*"  EXPORTING
*"     REFERENCE(E_NAME) TYPE  CHAR255
*"     REFERENCE(E_ADDRESS) TYPE  CHAR255
*"     REFERENCE(E_TAX) TYPE  CHAR255
*"     REFERENCE(E_TEL_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_FAX_NUMBER) TYPE  CHAR255
*"     REFERENCE(E_EMAIL) TYPE  CHAR255
*"     REFERENCE(E_NAME_N_TITLE) TYPE  CHAR255
*"     REFERENCE(E_NAME1) TYPE  CHAR255
*"     REFERENCE(E_TITLE) TYPE  TEXT15
*"     REFERENCE(E_KTOKL) TYPE  KTOKL_077T
*"     REFERENCE(E_KTOKL_NAME) TYPE  KTOKL_077T
*"     REFERENCE(E_TEL_EXTENS) TYPE  CHAR255
*"     REFERENCE(E_FAX_EXTENS) TYPE  CHAR255
*"--------------------------------------------------------------------
DATA: LW_XCPDK      TYPE LFA1-XCPDK,
        LW_KTOKL      TYPE KTOKL_077T,
        LW_KTOKL_NAME TYPE TXT30_077T.

  DATA: LW_ADRNR        TYPE T001-ADRNR,
        LW_TITLE        TYPE ADRC-TITLE,
        LW_NAME1        TYPE ADRC-NAME1,
        LW_NAME2        TYPE ADRC-NAME2,
        LW_NAME3        TYPE ADRC-NAME3,
        LW_NAME4        TYPE ADRC-NAME4,
        LW_HOUSE_NUM1   TYPE ADRC-HOUSE_NUM1,
        LW_HOUSE_NUM2   TYPE ADRC-HOUSE_NUM2,
        LW_HOUSE_NUM3   TYPE ADRC-HOUSE_NUM3,
        LW_STR_SUPPL1   TYPE AD_STRSPP1,
        LW_STR_SUPPL2   TYPE AD_STRSPP1,
        LW_STR_SUPPL3   TYPE AD_STRSPP1,
        LW_STREET       TYPE ADRC-STREET,
        LW_CITY1        TYPE ADRC-CITY1,
        LW_CITY2        TYPE ADRC-CITY2,
        LW_COUNTRY      TYPE ADRC-COUNTRY,
        LW_TAX          TYPE T001-STCEG,
        LW_TEL_NUMBER   TYPE ADRC-TEL_NUMBER,
        LW_FAX_NUMBER   TYPE ADRC-FAX_NUMBER,
        LW_EMAIL        TYPE ADR6-SMTP_ADDR,
        LW_E_TITLE      TYPE TEXT15,
        LW_E_TEL_EXTENS TYPE ADRC-TEL_EXTENS,
        LW_E_FAX_EXTENS TYPE ADRC-FAX_EXTENS,
        LW_LOCATION     TYPE AD_LCTN.

        DATA:           LW_STRAS       TYPE BSEC-STRAS,
        LW_ORT01        TYPE BSEC-ORT01,
        LW_LAND1        TYPE BSEC-LAND1,
        LW_STCD1        TYPE BSEC-STCD1.

  " Kiem Tra Loai Vendor
  SELECT SINGLE XCPDK KTOKK
  INTO (LW_XCPDK, LW_KTOKL)
  FROM LFA1
  WHERE LIFNR EQ I_NUMBER.

  SELECT SINGLE TXT30
  INTO LW_KTOKL_NAME
  FROM T077Y
  WHERE KTOKK = LW_KTOKL
    AND SPRAS = SY-LANGU.

  E_KTOKL = LW_KTOKL.
  E_KTOKL_NAME = LW_KTOKL_NAME.

  " Neu khong phai One Time Vendor Hoac la One Time Vendor nhung khong lay thong tin theo chung tu
  IF LW_XCPDK NE 'X'.
    " Lay Thong Tin Vendor
    SELECT  SINGLE
    LFA1~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    LFA1~STCEG
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    LFA1~ANRED
    ADRC~TEL_EXTENS "QNLT add 13.12.2015
    ADRC~FAX_EXTENS "QNLT add 13.12.2015
    ADRC~LOCATION
    INTO (LW_ADRNR,
           LW_TITLE,
           LW_NAME1,
           LW_NAME2,
           LW_NAME3,
           LW_NAME4,
           LW_HOUSE_NUM1,
           LW_HOUSE_NUM2,
           LW_HOUSE_NUM3,
           LW_STR_SUPPL1,
           LW_STR_SUPPL2,
           LW_STR_SUPPL3,
           LW_STREET,
           LW_CITY1,
           LW_CITY2,
           LW_COUNTRY,
           LW_TAX,
           LW_TEL_NUMBER,
           LW_FAX_NUMBER,
           LW_EMAIL,
           LW_E_TITLE,
           LW_E_TEL_EXTENS,  "QNLT add 13.12.2015
           LW_E_FAX_EXTENS,   "QNLT add 13.12.2015
           LW_LOCATION
           )
    FROM LFA1 INNER JOIN ADRC ON ADRC~ADDRNUMBER = LFA1~ADRNR
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = LFA1~ADRNR
    WHERE LIFNR EQ I_NUMBER.

    "TITLE
    E_TITLE = LW_E_TITLE.
    CONDENSE E_TITLE.

    " Ten Vendor
    CLEAR: E_NAME.
    IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
      E_NAME = LW_NAME1.
    ELSE.
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    ENDIF.

    E_NAME1 = LW_NAME1.
    CONDENSE: E_NAME, E_NAME1.

    CLEAR: E_NAME_N_TITLE.
    IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
      E_NAME_N_TITLE = LW_NAME1.
    ELSE.
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
    ENDIF.

    CONDENSE E_NAME_N_TITLE.

    " Dia chi
    CLEAR: E_ADDRESS.
    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.

    " Tel, Fax, Tax, Email
    E_TAX = LW_TAX.
    E_TEL_NUMBER = LW_TEL_NUMBER.
    E_FAX_NUMBER = LW_FAX_NUMBER.
    E_EMAIL = LW_EMAIL.

    "QNLT add
    E_TEL_EXTENS = LW_E_TEL_EXTENS.
    E_FAX_EXTENS = LW_E_FAX_EXTENS.

  ELSE.
    "ONE TIME VENDOR
    SELECT  SINGLE
    EKKO~ADRNR
    ADRC~TITLE
    ADRC~NAME1
    ADRC~NAME2
    ADRC~NAME3
    ADRC~NAME4
    ADRC~HOUSE_NUM1
    ADRC~HOUSE_NUM2
    ADRC~HOUSE_NUM3
    ADRC~STR_SUPPL1
    ADRC~STR_SUPPL2
    ADRC~STR_SUPPL3
    ADRC~STREET
    ADRC~CITY1
    ADRC~CITY2
    ADRC~COUNTRY
    ADRC~TEL_NUMBER
    ADRC~FAX_NUMBER
    ADR6~SMTP_ADDR
    ADRC~TITLE
    ADRC~TEL_EXTENS "QNLT add 13.12.2015
    ADRC~FAX_EXTENS "QNLT add 13.12.2015
    ADRC~LOCATION
    INTO (LW_ADRNR,
          LW_TITLE,
          LW_NAME1,
          LW_NAME2,
          LW_NAME3,
          LW_NAME4,
          LW_HOUSE_NUM1,
          LW_HOUSE_NUM2,
          LW_HOUSE_NUM3,
          LW_STR_SUPPL1,
          LW_STR_SUPPL2,
          LW_STR_SUPPL3,
          LW_STREET,
          LW_CITY1,
          LW_CITY2,
          LW_COUNTRY,
          LW_TEL_NUMBER,
          LW_FAX_NUMBER,
          LW_EMAIL,
          LW_E_TITLE,
           LW_E_TEL_EXTENS,  "QNLT add 13.12.2015
           LW_E_FAX_EXTENS,   "QNLT add 13.12.2015
           LW_LOCATION
          )
    FROM EKKO INNER JOIN ADRC ON ADRC~ADDRNUMBER = EKKO~ADRNR
    LEFT JOIN ADR6 ON ADR6~ADDRNUMBER = EKKO~ADRNR
    WHERE EKKO~EBELN = I_EBELN.

    SELECT SINGLE
    LFA1~STCEG
    LFA1~ANRED
    INTO
    (LW_TAX,
    LW_E_TITLE)
    FROM LFA1
    WHERE LIFNR EQ I_NUMBER.

    "TITLE
    E_TITLE = LW_E_TITLE.
    CONDENSE E_TITLE.

    " Ten Vendor
    CLEAR: E_NAME.
    IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
      E_NAME = LW_NAME1.
    ELSE.
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME SEPARATED BY SPACE.
    ENDIF.

    E_NAME1 = LW_NAME1.
    CONDENSE: E_NAME, E_NAME1.

    CLEAR: E_NAME_N_TITLE.
    IF LW_NAME2 IS INITIAL AND LW_NAME3 IS INITIAL AND LW_NAME4 IS INITIAL.
      E_NAME_N_TITLE = LW_NAME1.
    ELSE.
      CONCATENATE LW_NAME2 LW_NAME3 LW_NAME4 INTO E_NAME_N_TITLE SEPARATED BY SPACE.
    ENDIF.

    CONDENSE E_NAME_N_TITLE.

    " Dia chi
    CLEAR: E_ADDRESS.
    CONCATENATE LW_STREET LW_STR_SUPPL1 LW_STR_SUPPL2 LW_STR_SUPPL3 LW_LOCATION INTO E_ADDRESS SEPARATED BY SPACE.
    CONDENSE E_ADDRESS.

    " Tel, Fax, Tax, Email
    E_TAX = LW_TAX.
    E_TEL_NUMBER = LW_TEL_NUMBER.
    E_FAX_NUMBER = LW_FAX_NUMBER.
    E_EMAIL = LW_EMAIL.

    "QNLT add
    E_TEL_EXTENS = LW_E_TEL_EXTENS.
    E_FAX_EXTENS = LW_E_FAX_EXTENS.
  ENDIF.





ENDFUNCTION.

*
