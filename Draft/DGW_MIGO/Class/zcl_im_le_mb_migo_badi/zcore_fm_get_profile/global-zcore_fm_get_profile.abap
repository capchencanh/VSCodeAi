  GW_CALLBACK_TOP_OF_PAGE       TYPE  SLIS_FORMNAME,
  GW_CALLBACK_EVENT_TOP_OF_PAGE TYPE  SLIS_FORMNAME,
  GW_CALLBACK_HTML_END_OF_LIST  TYPE  SLIS_FORMNAME,
  GW_CALLBACK_BUTTON_CLICK      TYPE  SLIS_FORMNAME,
  GW_CALLBACK_HOTSPOT_CLICK     TYPE  SLIS_FORMNAME,
  GW_CALLBACK_DATA_CHANGED      TYPE  SLIS_FORMNAME,
  GW_CALLBACK_HTML_TOP_OF_PAGE  TYPE  SLIS_FORMNAME.

