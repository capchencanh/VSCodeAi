FUNCTION ZCORE_FM_ALV_DISPLAY.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_CALLBACK_PROGRAM) TYPE  SY-REPID DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_PF_STATUS_SET) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_USER_COMMAND) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_TOP_OF_PAGE) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_HTML_END_OF_LIST) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_HTML_TOP_OF_PAGE) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_BUTTON_CLICK) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_HOTSPOT_CLICK) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_DATA_CHANGED) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     REFERENCE(I_CALLBACK_EVENT_TOP_OF_PAGE) TYPE  SLIS_FORMNAME
*"         DEFAULT SPACE
*"     VALUE(I_STRUCTURE_NAME) TYPE  DD02L-TABNAME OPTIONAL
*"     REFERENCE(IT_FIELDCAT_LVC) TYPE  LVC_T_FCAT OPTIONAL
*"     REFERENCE(I_LASTCOL) TYPE  INT4 OPTIONAL
*"     REFERENCE(IT_HEADER) TYPE  LVC_T_HEAD OPTIONAL
*"     REFERENCE(I_GRID_TITLE) TYPE  LVC_TITLE OPTIONAL
*"     REFERENCE(I_GRID_SETTINGS) TYPE  LVC_S_GLAY OPTIONAL
*"     REFERENCE(IS_LAYOUT_LVC) TYPE  LVC_S_LAYO OPTIONAL
*"     REFERENCE(IT_EXCLUDING) TYPE  SLIS_T_EXTAB OPTIONAL
*"     REFERENCE(IT_SPECIAL_GROUPS_LVC) TYPE  LVC_T_SGRP OPTIONAL
*"     REFERENCE(IT_SORT_LVC) TYPE  LVC_T_SORT OPTIONAL
*"     REFERENCE(IT_FILTER_LVC) TYPE  LVC_T_FILT OPTIONAL
*"     REFERENCE(IT_HYPERLINK) TYPE  LVC_T_HYPE OPTIONAL
*"     REFERENCE(IS_SEL_HIDE) TYPE  SLIS_SEL_HIDE_ALV OPTIONAL
*"     REFERENCE(I_SAVE) DEFAULT SPACE
*"     REFERENCE(IT_EVENTS) TYPE  SLIS_T_EVENT OPTIONAL
*"     REFERENCE(IT_EVENT_EXIT) TYPE  SLIS_T_EVENT_EXIT OPTIONAL
*"     REFERENCE(IS_PRINT_LVC) TYPE  LVC_S_PRNT OPTIONAL
*"     REFERENCE(IS_REPREP_ID_LVC) TYPE  LVC_S_RPRP OPTIONAL
*"     REFERENCE(I_SCREEN_START_COLUMN) DEFAULT 0
*"     REFERENCE(I_SCREEN_START_LINE) DEFAULT 0
*"     REFERENCE(I_SCREEN_END_COLUMN) DEFAULT 0
*"     REFERENCE(I_SCREEN_END_LINE) DEFAULT 0
*"     REFERENCE(I_HTML_HEIGHT_TOP) TYPE  I OPTIONAL
*"     REFERENCE(I_HTML_HEIGHT_END) TYPE  I OPTIONAL
*"     REFERENCE(IT_ALV_GRAPHICS) TYPE  DTC_T_TC OPTIONAL
*"     REFERENCE(IT_EXCEPT_QINFO_LVC) TYPE  SLIS_T_QINFO_ALV OPTIONAL
*"     REFERENCE(IR_SALV_FULLSCREEN_ADAPTER) TYPE
*"EF TO CL_SALV_FULLSCREEN_ADAPTER OPTIONAL
*"     REFERENCE(IS_VARIANT) TYPE  DISVARIANT OPTIONAL
*"     REFERENCE(IT_DROPDOWN) TYPE  LVC_T_DROP OPTIONAL
*"  TABLES
*"      T_OUTTAB
*"--------------------------------------------------------------------
DATA:
    LT_FIELDCAT                  TYPE LVC_T_FCAT,
    LT_EVENTS                    TYPE SLIS_T_EVENT,
    LW_CALLBACK_PF_STATUS_SET    TYPE  SLIS_FORMNAME,
    LW_CALLBACK_HTML_TOP_OF_PAGE TYPE  SLIS_FORMNAME,
    LW_CALLBACK_USER_COMMAND     TYPE  SLIS_FORMNAME,
    LW_CALLBACK_TOP_OF_PAGE      TYPE  SLIS_FORMNAME,
    LW_CALLBACK_HTML_END_OF_LIST TYPE  SLIS_FORMNAME,
    LS_VARIANT                   TYPE  DISVARIANT.
  DATA: L_EVENT  TYPE LVC_FNAME.
  FIELD-SYMBOLS:
    <LF_FIELDCAT> TYPE LVC_S_FCAT,
    <LS_EVENT>    TYPE SLIS_ALV_EVENT.

* Init
  CLEAR: LT_FIELDCAT.
  GW_CALLBACK_PROGRAM           = I_CALLBACK_PROGRAM.
  GW_CALLBACK_PF_STATUS_SET     = I_CALLBACK_PF_STATUS_SET.
  GW_CALLBACK_USER_COMMAND      = I_CALLBACK_USER_COMMAND.
  GW_CALLBACK_TOP_OF_PAGE       = I_CALLBACK_TOP_OF_PAGE.
  GW_CALLBACK_HTML_END_OF_LIST  = I_CALLBACK_HTML_END_OF_LIST.
  GW_CALLBACK_HTML_TOP_OF_PAGE  = I_CALLBACK_HTML_TOP_OF_PAGE.
  GW_CALLBACK_BUTTON_CLICK      = I_CALLBACK_BUTTON_CLICK.
  GW_CALLBACK_HOTSPOT_CLICK     = I_CALLBACK_HOTSPOT_CLICK.
  GW_CALLBACK_DATA_CHANGED      = I_CALLBACK_DATA_CHANGED.
  GW_CALLBACK_EVENT_TOP_OF_PAGE = I_CALLBACK_EVENT_TOP_OF_PAGE.

  IF I_CALLBACK_PF_STATUS_SET IS NOT INITIAL.
    LW_CALLBACK_PF_STATUS_SET = 'ALV_GRID_PF_STATUS_SET'.
  ENDIF.
  IF I_CALLBACK_USER_COMMAND IS NOT INITIAL.
    LW_CALLBACK_USER_COMMAND = 'ALV_GRID_USER_COMMAND'.
  ENDIF.
  IF I_CALLBACK_TOP_OF_PAGE IS NOT INITIAL.
    LW_CALLBACK_TOP_OF_PAGE = 'ALV_GRID_TOP_OF_PAGE'.
  ENDIF.
  IF I_CALLBACK_HTML_END_OF_LIST IS NOT INITIAL.
    LW_CALLBACK_HTML_END_OF_LIST = 'ALV_GRID_HTML_END_OF_LIST'.
  ENDIF.
  IF I_CALLBACK_HTML_TOP_OF_PAGE IS NOT INITIAL.
    LW_CALLBACK_HTML_TOP_OF_PAGE = 'ALV_GRID_TOP_HTML'.
  ENDIF.
  IF I_CALLBACK_EVENT_TOP_OF_PAGE IS NOT INITIAL.
* Create TOP-Document
    CREATE OBJECT DG_DYNDOC_ID
      EXPORTING
        STYLE = 'ALV_GRID'.
  ENDIF.
  CLEAR: GT_DROPDOWN.
  GT_DROPDOWN = IT_DROPDOWN.
* Get fieldcat
  IF I_STRUCTURE_NAME IS NOT INITIAL.
    CALL FUNCTION 'LVC_FIELDCATALOG_MERGE'
      EXPORTING
        I_STRUCTURE_NAME       = I_STRUCTURE_NAME
      CHANGING
        CT_FIELDCAT            = LT_FIELDCAT
      EXCEPTIONS
        INCONSISTENT_INTERFACE = 1
        PROGRAM_ERROR          = 2
        OTHERS                 = 3.
  ELSE.
    LT_FIELDCAT = IT_FIELDCAT_LVC[].
  ENDIF.
  IF I_LASTCOL > 0.
    LOOP AT LT_FIELDCAT ASSIGNING <LF_FIELDCAT>
      WHERE COL_POS > I_LASTCOL.
      <LF_FIELDCAT>-NO_OUT = 'X'.
    ENDLOOP.
  ENDIF.
  LOOP AT LT_FIELDCAT ASSIGNING <LF_FIELDCAT>.
    <LF_FIELDCAT>-COLDDICTXT = 'L'.
*    IF <LF_FIELDCAT>-REPTEXT IS NOT INITIAL.
*      <LF_FIELDCAT>-SCRTEXT_S = <LF_FIELDCAT>-SCRTEXT_M = <LF_FIELDCAT>-SCRTEXT_L = <LF_FIELDCAT>-REPTEXT.
    IF <LF_FIELDCAT>-SCRTEXT_L IS NOT INITIAL.
      <LF_FIELDCAT>-SCRTEXT_S = <LF_FIELDCAT>-SCRTEXT_M = <LF_FIELDCAT>-SCRTEXT_L.
      <LF_FIELDCAT>-REPTEXT   = <LF_FIELDCAT>-SCRTEXT_L.
    ENDIF.
  ENDLOOP.

  IF IT_EVENTS[] IS INITIAL.
    CALL FUNCTION 'REUSE_ALV_EVENTS_GET'
      EXPORTING
        I_LIST_TYPE     = 4
      IMPORTING
        ET_EVENTS       = LT_EVENTS
      EXCEPTIONS
        LIST_TYPE_WRONG = 1
        OTHERS          = 2.
    IF SY-SUBRC = 0.
      READ TABLE LT_EVENTS ASSIGNING <LS_EVENT>
                 WITH KEY NAME = 'CALLER_EXIT'.
      IF SY-SUBRC EQ 0.
        CONCATENATE 'ALV_EVENT_' <LS_EVENT>-NAME
               INTO <LS_EVENT>-FORM.
        TRANSLATE <LS_EVENT>-FORM TO UPPER CASE.
        CONDENSE <LS_EVENT>-FORM.
      ENDIF.
    ENDIF.
  ELSE.
    LT_EVENTS[] = IT_EVENTS[].
  ENDIF.

  GT_HEADER[] = IT_HEADER[].
  GW_COUNT = LINES( T_OUTTAB ).

  LS_VARIANT = IS_VARIANT.
  IF LS_VARIANT-REPORT IS INITIAL.
    LS_VARIANT-REPORT = I_CALLBACK_PROGRAM.
  ENDIF.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY_LVC'
    EXPORTING
      I_CALLBACK_PROGRAM          = 'SAPLZCORE_FG_GLOBAL_FUNCTION'
      I_CALLBACK_HTML_TOP_OF_PAGE = LW_CALLBACK_HTML_TOP_OF_PAGE "'ALV_GRID_TOP_HTML'
      I_CALLBACK_PF_STATUS_SET    = LW_CALLBACK_PF_STATUS_SET
      I_CALLBACK_USER_COMMAND     = LW_CALLBACK_USER_COMMAND
      I_CALLBACK_TOP_OF_PAGE      = LW_CALLBACK_TOP_OF_PAGE
      I_CALLBACK_HTML_END_OF_LIST = LW_CALLBACK_HTML_END_OF_LIST
      I_GRID_TITLE                = I_GRID_TITLE
      I_GRID_SETTINGS             = I_GRID_SETTINGS
      IS_LAYOUT_LVC               = IS_LAYOUT_LVC
      IT_FIELDCAT_LVC             = LT_FIELDCAT
      IT_EXCLUDING                = IT_EXCLUDING
      IT_SPECIAL_GROUPS_LVC       = IT_SPECIAL_GROUPS_LVC
      IT_SORT_LVC                 = IT_SORT_LVC
      IT_FILTER_LVC               = IT_FILTER_LVC
      IT_HYPERLINK                = IT_HYPERLINK
      IS_SEL_HIDE                 = IS_SEL_HIDE
      I_SAVE                      = I_SAVE
      IT_EVENTS                   = LT_EVENTS
      IT_EVENT_EXIT               = IT_EVENT_EXIT
      IS_PRINT_LVC                = IS_PRINT_LVC
      IS_REPREP_ID_LVC            = IS_REPREP_ID_LVC
      I_SCREEN_START_COLUMN       = I_SCREEN_START_COLUMN
      I_SCREEN_START_LINE         = I_SCREEN_START_LINE
      I_SCREEN_END_COLUMN         = I_SCREEN_END_COLUMN
      I_SCREEN_END_LINE           = I_SCREEN_END_LINE
      I_HTML_HEIGHT_TOP           = I_HTML_HEIGHT_TOP
      I_HTML_HEIGHT_END           = I_HTML_HEIGHT_END
      IT_ALV_GRAPHICS             = IT_ALV_GRAPHICS
      IT_EXCEPT_QINFO_LVC         = IT_EXCEPT_QINFO_LVC
      IR_SALV_FULLSCREEN_ADAPTER  = IR_SALV_FULLSCREEN_ADAPTER
      IS_VARIANT                  = LS_VARIANT
    TABLES
      T_OUTTAB                    = T_OUTTAB
    EXCEPTIONS
      PROGRAM_ERROR               = 1
      OTHERS                      = 2.





ENDFUNCTION.

*
* 
