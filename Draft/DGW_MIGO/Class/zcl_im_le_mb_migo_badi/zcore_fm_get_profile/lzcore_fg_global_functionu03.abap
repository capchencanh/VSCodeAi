FUNCTION ZCORE_AUTHORIZATION_WERKS.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_WERKS) TYPE  WERKS_D OPTIONAL
*"  TABLES
*"      IT_WERKS STRUCTURE  ZCORE_ST_RSELOPTION_WERKS OPTIONAL
*"--------------------------------------------------------------------
DATA: LT_WERKS TYPE TABLE OF  T001W,
        LS_WERKS TYPE           T001W.

  IF I_WERKS IS NOT INITIAL.
    AUTHORITY-CHECK OBJECT 'M_MSEG_WMB'
              ID 'WERKS' FIELD I_WERKS
              ID 'ACTVT' FIELD '03'.
    IF SY-SUBRC NE 0.
      MESSAGE 'YOU ARE NOT AUTHORIZED WITH THIS PLANT !' TYPE 'E'.
    ENDIF.
  ENDIF.

  IF IT_WERKS IS NOT INITIAL.
    SELECT WERKS
    INTO CORRESPONDING FIELDS OF TABLE LT_WERKS
    FROM T001W
    WHERE WERKS IN IT_WERKS.

    LOOP AT LT_WERKS INTO LS_WERKS.
      AUTHORITY-CHECK OBJECT 'M_MSEG_WMB'
              ID 'WERKS' FIELD LS_WERKS-WERKS
              ID 'ACTVT' FIELD '03'.
      IF SY-SUBRC NE 0.
        MESSAGE 'YOU ARE NOT AUTHORIZED WITH THIS PLANT !' TYPE 'E'.
      ENDIF.
    ENDLOOP.
  ENDIF.





ENDFUNCTION.

