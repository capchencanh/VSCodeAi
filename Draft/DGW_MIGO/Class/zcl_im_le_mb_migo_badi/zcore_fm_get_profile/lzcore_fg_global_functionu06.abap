FUNCTION ZCORE_CONVERT_CHAR_DECIMALS_N.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(INPUT_NUM) DEFAULT '12,906'
*"     VALUE(DECIMALS) DEFAULT '2'
*"     VALUE(I_USER) TYPE  UNAME DEFAULT 'CT.ABAP'
*"  EXPORTING
*"     REFERENCE(OUTPUT_NUM)
*"--------------------------------------------------------------------
  DATA:
    E_TEXT            TYPE CHAR255,
    LV_FORMAT         TYPE FLAG,
    LV_LENGH_ZERO     TYPE INT4,
    LV_LENGH_INPUT    TYPE INT4,
    LV_LENGH_OUTPUT   TYPE INT4,
    LV_COMMA_LOCATION TYPE INT4,
    LV_DECIMALS       TYPE INT4.

  TYPES:
    BEGIN OF LTY_USER_FORMAT,
      BNAME TYPE USR01-BNAME,
      DCPFM TYPE USR01-DCPFM,
    END OF LTY_USER_FORMAT.

  DATA:
    GS_USER TYPE LTY_USER_FORMAT.

  DATA: LR_PACKED TYPE REF TO DATA.

  FIELD-SYMBOLS: <FS_PACKED> TYPE ANY.



  "get data user format
  SELECT SINGLE
    BNAME
    DCPFM
    INTO GS_USER
    FROM USR01
    WHERE BNAME EQ I_USER.

  IF GS_USER-DCPFM EQ 'X'."1,000.000
    LV_FORMAT = '.'.
  ELSEIF GS_USER-DCPFM IS INITIAL."1.000,000
    LV_FORMAT = ','.
  ELSEIF GS_USER-DCPFM EQ 'Y'."1000,000
    LV_FORMAT = ','.
  ENDIF.




  LV_DECIMALS = DECIMALS.

  CREATE DATA LR_PACKED TYPE P DECIMALS LV_DECIMALS.
  ASSIGN LR_PACKED->* TO <FS_PACKED>.

  REPLACE LV_FORMAT IN INPUT_NUM WITH 'F'.
  REPLACE ALL OCCURRENCES OF '.' IN INPUT_NUM WITH '' .
  REPLACE ALL OCCURRENCES OF ',' IN INPUT_NUM WITH ''.
  REPLACE ALL OCCURRENCES OF 'F' IN INPUT_NUM WITH '.'.

  <FS_PACKED> = INPUT_NUM.
  WRITE <FS_PACKED> TO OUTPUT_NUM DECIMALS DECIMALS.





ENDFUNCTION.

