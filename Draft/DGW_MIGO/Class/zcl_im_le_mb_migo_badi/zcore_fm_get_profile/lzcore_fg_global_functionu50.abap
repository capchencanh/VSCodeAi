FUNCTION ZFM_GET_CHARACTERISTIC_ALL.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_RETURN_VALUE) TYPE  CHECKBOX OPTIONAL
*"  TABLES
*"      GT_DATA
*"      GT_CHARACTERTICTIS STRUCTURE  ZST_GET_CHARACTERISTIC OPTIONAL
*"      GT_BATCH STRUCTURE  ZST_BATCH OPTIONAL
*"--------------------------------------------------------------------
TYPES: BEGIN OF LTY_MCH1,
           MATNR TYPE MATNR,
           CHARG TYPE CHARG_D,
           OBJEC TYPE INOB-OBJEK,
         END OF LTY_MCH1.

  DATA: LW_MATNR TYPE MATNR.
  DATA: LT_MCH1  TYPE TABLE OF LTY_MCH1,
        LS_MCH1  LIKE LINE OF LT_MCH1,
        LW_OBJEC TYPE CUOBN,
        LW_ATFLV TYPE ATFLV,
        LW_ATWRT TYPE ATWRT,
        LW_INDEX TYPE SY-TABIX,
        GS_BATCH TYPE ZST_BATCH.
  DATA: GR_ATNAM TYPE RANGE OF ATNAM WITH HEADER LINE.
  FIELD-SYMBOLS: <LF_VALUE> TYPE ANY,
                 <LF_MATNR> TYPE ANY,
                 <LF_CHARG> TYPE ANY,
                 <LF_OBJEC> TYPE ANY.

  CHECK GT_DATA[] IS NOT INITIAL.
  SORT GT_DATA BY ('MATNR') ('CHARG').
  MOVE-CORRESPONDING GT_DATA[] TO LT_MCH1.
  SORT LT_MCH1.
  DELETE ADJACENT DUPLICATES FROM LT_MCH1.

  LOOP AT LT_MCH1 ASSIGNING FIELD-SYMBOL(<LF_MCH1>).
    CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
      EXPORTING
        INPUT        = <LF_MCH1>-MATNR
      IMPORTING
        OUTPUT       = LW_MATNR
      EXCEPTIONS
        LENGTH_ERROR = 1
        OTHERS       = 2.
    CONCATENATE LW_MATNR <LF_MCH1>-CHARG INTO <LF_MCH1>-OBJEC RESPECTING BLANKS.
  ENDLOOP.

  LOOP AT GT_CHARACTERTICTIS INTO DATA(LS_CHARACTERTICTIS).
    GR_ATNAM-LOW = LS_CHARACTERTICTIS-NAME.
    GR_ATNAM-SIGN = 'I'.
    GR_ATNAM-OPTION = 'EQ'.
    APPEND GR_ATNAM.
  ENDLOOP.

  SELECT
    INOB~OBJEK
    AUSP~ATINN
    AUSP~ATWRT
    AUSP~ATFLV
    CABN~ATNAM
    CABN~ATFOR
    CABN~ANZDZ
    CABN~ANZST
    CABNT~ATBEZ
   INTO CORRESPONDING FIELDS OF TABLE GT_BATCH
   FROM INOB
   INNER JOIN AUSP ON AUSP~OBJEK EQ INOB~CUOBJ
   INNER JOIN CABN ON CABN~ATINN EQ AUSP~ATINN
   LEFT JOIN CABNT ON CABN~ATINN = CABNT~ATINN
                  AND CABN~ADZHL = CABNT~ADZHL
                  AND CABNT~SPRAS = SY-LANGU
   FOR ALL ENTRIES IN LT_MCH1
   WHERE  INOB~OBJEK EQ LT_MCH1-OBJEC AND
          CABN~ATNAM IN GR_ATNAM.
  SORT GT_BATCH BY OBJEK ATNAM.

  CHECK I_RETURN_VALUE IS INITIAL.

  LOOP AT GT_DATA ASSIGNING FIELD-SYMBOL(<FS_DATA>).
    ASSIGN COMPONENT 'MATNR' OF STRUCTURE <FS_DATA> TO <LF_MATNR>.
    IF SY-SUBRC = 0.
      ASSIGN COMPONENT 'CHARG' OF STRUCTURE <FS_DATA> TO <LF_CHARG>.
      IF SY-SUBRC = 0.
        READ TABLE LT_MCH1 INTO LS_MCH1 WITH KEY MATNR = <LF_MATNR>
                                                 CHARG = <LF_CHARG>.
        IF SY-SUBRC = 0.
          ASSIGN COMPONENT 'OBJEC' OF STRUCTURE LS_MCH1 TO <LF_OBJEC>.
          IF SY-SUBRC = 0.
            READ TABLE GT_BATCH TRANSPORTING NO FIELDS WITH KEY OBJEK = <LF_OBJEC> BINARY SEARCH.
            IF SY-SUBRC = 0.
              LW_INDEX = SY-TABIX.
            ENDIF.

            LOOP AT GT_BATCH INTO GS_BATCH FROM LW_INDEX.
              IF GS_BATCH-OBJEK NE <LF_OBJEC>.
                EXIT.
              ENDIF.
              ASSIGN COMPONENT GS_BATCH-ATNAM OF STRUCTURE <FS_DATA> TO <LF_VALUE>.
              IF SY-SUBRC = 0.
                PERFORM GET_VALUE USING GS_BATCH CHANGING LW_ATFLV LW_ATWRT.
                CONDENSE LW_ATWRT.
                <LF_VALUE> = LW_ATWRT.
                UNASSIGN <LF_VALUE>.
              ENDIF.
            ENDLOOP.
            UNASSIGN <LF_OBJEC>.
          ENDIF.
        ENDIF.
        UNASSIGN <LF_CHARG>.
      ENDIF.
      UNASSIGN <LF_MATNR>.
    ENDIF.
  ENDLOOP.





ENDFUNCTION.

