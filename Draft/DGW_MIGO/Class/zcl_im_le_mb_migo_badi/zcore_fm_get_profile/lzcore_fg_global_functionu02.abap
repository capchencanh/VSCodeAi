FUNCTION ZCORE_AUTHORIZATION_LGORT.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  TABLES
*"      IT_WERKS STRUCTURE  ZCORE_ST_RSELOPTION_WERKS OPTIONAL
*"      IT_LGORT STRUCTURE  ZCORE_ST_RSELOPTION_LGORT OPTIONAL
*"  CHANGING
*"     REFERENCE(I_WERKS) TYPE  WERKS_D OPTIONAL
*"----------------------------------------------------------------------
  DATA: LT_LGORT TYPE TABLE OF  T001L,
        LS_LGORT TYPE           T001L,
        LR_WERKS TYPE RANGE OF  WERKS_D.

  IF I_WERKS IS NOT INITIAL AND IT_WERKS IS INITIAL.
    IT_WERKS-SIGN     = 'I'.
    IT_WERKS-OPTION   = 'BT'.
    IT_WERKS-LOW      = I_WERKS.
    IT_WERKS-HIGH     = I_WERKS.
    APPEND IT_WERKS.
  ENDIF.
  SELECT WERKS LGORT
  FROM T001L
  INTO CORRESPONDING FIELDS OF TABLE LT_LGORT
  WHERE WERKS IN IT_WERKS
    AND LGORT IN IT_LGORT
  ORDER BY WERKS LGORT.

  LOOP AT LT_LGORT INTO LS_LGORT.
    AUTHORITY-CHECK OBJECT 'M_MSEG_LGO'
     ID 'WERKS' FIELD LS_LGORT-WERKS
     ID 'LGORT' FIELD LS_LGORT-LGORT
     ID 'ACTVT' FIELD '03'.
    IF ( SY-SUBRC NE 0 ).
      DELETE LT_LGORT.
    ENDIF.
  ENDLOOP.

  "tri.nguyen2 add begin 27.08.2025 16:36:53
  IF LT_LGORT IS INITIAL.
    MESSAGE 'You are not authorized with this storage location!' TYPE 'E'.
  ELSE.
    "delete object not auth
    DELETE ADJACENT DUPLICATES FROM LT_LGORT COMPARING WERKS.

    IT_WERKS-SIGN   = 'I'.
    IT_WERKS-OPTION = 'EQ'.
    LOOP AT LT_LGORT INTO LS_LGORT.
      IT_WERKS-LOW    = LS_LGORT-WERKS.
      APPEND IT_WERKS.
    ENDLOOP.

    "Xoa range ban dau va cap nhat range moi
    DELETE IT_WERKS INDEX 1.
    SORT IT_WERKS BY SIGN OPTION LOW.
    DELETE ADJACENT DUPLICATES FROM IT_WERKS COMPARING SIGN OPTION LOW.
  ENDIF.
  "tri.nguyen2 add end 27.08.2025 16:36:53

ENDFUNCTION.

