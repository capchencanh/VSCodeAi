FUNCTION ZCORE_FM_GET_CRTRT_MULTIVAL.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(I_MATNR) TYPE  MATNR DEFAULT SPACE
*"     REFERENCE(I_CHARG) TYPE  CHARG_D DEFAULT SPACE
*"     REFERENCE(I_WERKS) TYPE  WERKS_D DEFAULT SPACE
*"     REFERENCE(I_ATNAM) TYPE  ATNAM DEFAULT SPACE
*"     REFERENCE(I_KLART) TYPE  KLASSENART DEFAULT '001'
*"     REFERENCE(I_CLASS) TYPE  KLAH-CLASS OPTIONAL
*"     REFERENCE(I_INCL_MATITEM) TYPE  CHAR1 OPTIONAL
*"     REFERENCE(I_ARBPL) TYPE  ARBPL DEFAULT SPACE
*"     REFERENCE(I_DELIMITER) DEFAULT ', '
*"     REFERENCE(I_CONCAT_SPACE) TYPE  CHAR1 DEFAULT SPACE
*"     REFERENCE(I_RM_DUPLICATE) TYPE  CHAR1 DEFAULT SPACE
*"     REFERENCE(I_OBJECTTABLE) TYPE  BAPI1003_KEY-OBJECTTABLE
*"         DEFAULT SPACE
*"     REFERENCE(I_OBJECTKEY) TYPE  OBJNUM DEFAULT SPACE
*"     REFERENCE(I_INCL_UOM) TYPE  CHAR1 DEFAULT SPACE
*"  EXPORTING
*"     REFERENCE(EZ_MATERIAL_URE_NITROGEN)
*"     REFERENCE(EZ_MATERIAL_URE_MOISTURE)
*"     REFERENCE(EZ_MATERIAL_URE_BIURET)
*"     REFERENCE(EZ_MATERIAL_URE_SIZE)
*"     REFERENCE(EZ_MATERIAL_URE_COLOR)
*"  TABLES
*"      IT_ATNAM STRUCTURE  ZCORE_ST_RSELOPTION_ATNAM OPTIONAL
*"      IT_CHARACT STRUCTURE  BAPI1003_ALLOC_VALUES_CHAR OPTIONAL
*"--------------------------------------------------------------------
TYPES: BEGIN OF LTY_CABN,
           ATNAM TYPE CABN-ATNAM,
           ATFOR TYPE CABN-ATFOR,
           ANZST TYPE CABN-ANZST,
           ANZDZ TYPE CABN-ANZDZ,
           MSEHI TYPE CABN-MSEHI,
           MSEH6 TYPE T006A-MSEH6,
         END OF LTY_CABN.
  DATA:
    LW_CUOBJ TYPE CUOBJ,
    LW_OBJEK TYPE OBJNUM,
    LW_MATNR TYPE MATNR.
  DATA:
    LT_CABN TYPE TABLE OF LTY_CABN,
    LS_CABN TYPE          LTY_CABN.
  DATA:
    LW_ATWRT    TYPE      CAWN-ATWRT, "DATUM,
    LW_DEC      TYPE      ESECOMPAVG,
    LW_DECIMALS TYPE      I,
    LW_FLOAT    TYPE      F.
  DATA:
    LV_OBJECTKEY       TYPE BAPI1003_KEY-OBJECT,
    LV_CLASSTYPE       TYPE KLAH-KLART,
    LV_CLASSNUM        TYPE KLAH-CLASS,
    LV_OBJECTTABLE     TYPE BAPI1003_KEY-OBJECTTABLE,
    LT_ALLOCVALUESNUM  TYPE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_NUM  INITIAL SIZE 1,
    LT_ALLOCVALUESCHAR TYPE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_CHAR INITIAL SIZE 1,
    LT_ALLOCVALUESCURR TYPE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_CURR INITIAL SIZE 1,
    LT_RETURN          TYPE STANDARD TABLE OF BAPIRET2                   INITIAL SIZE 1.
  DATA:
    LV_FS     TYPE STRING,
    LW_SUBSTR TYPE STRING,
    LW_STR    TYPE STRING.

  FIELD-SYMBOLS:
    <LS_ALLOCVALUESNUM>  TYPE BAPI1003_ALLOC_VALUES_NUM,
    <LS_ALLOCVALUESCHAR> TYPE BAPI1003_ALLOC_VALUES_CHAR,
    <LS_ALLOCVALUESCURR> TYPE BAPI1003_ALLOC_VALUES_CURR,
    <FS>                 TYPE ANY.

  RANGES:
        S_VALUESCHAR                                FOR RCTAV-ATNAM,
        S_ATFOR                                     FOR CABN-ATFOR. "TYPE:DATE/NUM
  CLEAR :
        LV_OBJECTKEY,
        LV_CLASSTYPE,
        LV_CLASSNUM.
  REFRESH:
        LT_ALLOCVALUESNUM[],
        LT_ALLOCVALUESCHAR[],
        LT_ALLOCVALUESCURR[],
        LT_RETURN[].

  IF I_MATNR IS NOT INITIAL.
    IF I_KLART = '023'.
      UNPACK I_MATNR TO LW_MATNR.

      CALL FUNCTION 'QMSP_MATERIAL_BATCH_CLASS_READ'
        EXPORTING
          I_MATNR                = LW_MATNR
          I_CHARG                = I_CHARG
          I_WERKS                = I_WERKS
          I_MARA_LEVEL           = 'X'
        IMPORTING
          E_CLASS                = LV_CLASSNUM
          E_KLART                = LV_CLASSTYPE
          E_OBTAB                = LV_OBJECTTABLE
        EXCEPTIONS
          NO_CLASS               = 1
          INTERNAL_ERROR_CLASSIF = 2
          NO_CHANGE_SERVICE      = 3
          OTHERS                 = 4.
      IF I_CHARG EQ SPACE.
        LV_OBJECTTABLE = 'MARA'.
      ENDIF.
      CONCATENATE  LW_MATNR  I_CHARG  INTO LV_OBJECTKEY. "I_WERKS
    ELSEIF I_KLART = '001'.
      WRITE I_MATNR TO LV_OBJECTKEY.
      WRITE I_KLART TO LV_CLASSTYPE.
      LV_OBJECTTABLE = 'MARA'.
      IF I_CLASS IS INITIAL.
        SELECT SINGLE KLAH~CLASS
        INTO  LV_CLASSNUM
        FROM KSSK INNER JOIN KLAH ON KSSK~CLINT = KLAH~CLINT
        WHERE KSSK~KLART = I_KLART
          AND KSSK~OBJEK EQ LV_OBJECTKEY
          AND KSSK~MAFID EQ 'O'.
      ELSE.
        LV_CLASSNUM = I_CLASS.
      ENDIF.
    ENDIF.
  ELSE.
    LV_CLASSTYPE  = I_KLART.

    IF I_OBJECTTABLE IS INITIAL AND I_OBJECTKEY IS INITIAL.
      CONCATENATE  I_WERKS I_ARBPL INTO LV_OBJECTKEY.

      SELECT
        INOB~OBTAB
        INOB~CUOBJ
         UP TO 1 ROWS
        INTO (LV_OBJECTTABLE, LW_CUOBJ)
      FROM INOB
      WHERE
         INOB~KLART = I_KLART
        AND  OBJEK EQ LV_OBJECTKEY.
      ENDSELECT.

      LW_OBJEK       = LW_CUOBJ.
    ELSE.
      LV_OBJECTKEY   = I_OBJECTKEY.
      LV_OBJECTTABLE = I_OBJECTTABLE.
      LW_OBJEK       = I_OBJECTKEY+0(18).
    ENDIF.
    SELECT
        KLAH~CLASS INTO LV_CLASSNUM
        UP TO 1 ROWS
    FROM KSSK
          INNER JOIN KLAH ON KSSK~CLINT = KLAH~CLINT
    WHERE
        KSSK~OBJEK     = LW_OBJEK
        AND KSSK~MAFID = 'O'
        AND KSSK~KLART = I_KLART.
    ENDSELECT.
  ENDIF.
  IF SY-SUBRC <> 0.
* IMPLEMENT SUITABLE ERROR HANDLING HERE
  ELSE.
    S_ATFOR-SIGN = 'I'.
    S_ATFOR-OPTION = 'EQ'.
    S_ATFOR-LOW = 'NUM'.
    APPEND S_ATFOR.

    S_ATFOR-SIGN = 'I'.
    S_ATFOR-OPTION = 'EQ'.
    S_ATFOR-LOW = 'DATE'.
    APPEND S_ATFOR.

    IF IT_ATNAM[] IS NOT INITIAL.
      S_VALUESCHAR[] = IT_ATNAM[].
    ELSEIF I_ATNAM IS NOT INITIAL.
      S_VALUESCHAR-SIGN = 'I'.
      S_VALUESCHAR-OPTION = 'EQ'.
      S_VALUESCHAR-LOW  = I_ATNAM.
      APPEND S_VALUESCHAR.
    ELSE.
      IF LW_MATNR IS NOT INITIAL. "MATERIAL
        S_VALUESCHAR-SIGN = 'I'.
        S_VALUESCHAR-OPTION = 'EQ'.

        S_VALUESCHAR-LOW  = 'Z_MATERIAL_URE_NITROGEN'.
        APPEND S_VALUESCHAR.

        S_VALUESCHAR-LOW  = 'Z_MATERIAL_URE_MOISTURE'.
        APPEND S_VALUESCHAR.

        S_VALUESCHAR-LOW  = 'Z_MATERIAL_URE_BIURET'.
        APPEND S_VALUESCHAR.

        S_VALUESCHAR-LOW  = 'Z_MATERIAL_URE_SIZE'.
        APPEND S_VALUESCHAR.

        S_VALUESCHAR-LOW  = 'Z_MATERIAL_URE_COLOR'.
        APPEND S_VALUESCHAR.

        S_VALUESCHAR-LOW  = 'Z_NGAYMUAHANG'.
        APPEND S_VALUESCHAR.
        S_VALUESCHAR-LOW  = 'Z_NGAYNHAPKHO'.
        APPEND S_VALUESCHAR.
      ENDIF.
    ENDIF.


    CALL FUNCTION 'BAPI_OBJCL_GETDETAIL'
      EXPORTING
        OBJECTKEY       = LV_OBJECTKEY
        OBJECTTABLE     = LV_OBJECTTABLE
        CLASSNUM        = LV_CLASSNUM
        CLASSTYPE       = LV_CLASSTYPE
      TABLES
        ALLOCVALUESNUM  = LT_ALLOCVALUESNUM
        ALLOCVALUESCHAR = LT_ALLOCVALUESCHAR
        ALLOCVALUESCURR = LT_ALLOCVALUESCURR
        RETURN          = LT_RETURN.

    CLEAR : LV_OBJECTKEY.

    IT_CHARACT[] = LT_ALLOCVALUESCHAR[].

    IF LT_ALLOCVALUESNUM[] IS NOT INITIAL.
      SELECT
          CABN~ATNAM
          CABN~ATFOR
          CABN~ANZST
          CABN~ANZDZ
          CABN~MSEHI
          T006A~MSEH6
        INTO CORRESPONDING FIELDS OF TABLE LT_CABN BYPASSING BUFFER
      FROM CABN
        LEFT JOIN T006A ON CABN~MSEHI   = T006A~MSEHI
                        AND T006A~SPRAS = SY-LANGU
      WHERE
          CABN~ATNAM IN S_VALUESCHAR "IT_ATNAM.
          AND CABN~ATFOR IN S_ATFOR.
    ENDIF.

    LOOP AT LT_ALLOCVALUESCHAR ASSIGNING <LS_ALLOCVALUESCHAR> WHERE CHARACT IN S_VALUESCHAR.
      CONCATENATE 'E' <LS_ALLOCVALUESCHAR>-CHARACT INTO LV_FS RESPECTING BLANKS.
      ASSIGN (LV_FS) TO <FS>.
      IF SY-SUBRC = 0.
        IF <FS> IS INITIAL .
          <FS> = <LS_ALLOCVALUESCHAR>-VALUE_CHAR.
        ELSE.
          CONCATENATE <FS> I_DELIMITER INTO LW_STR.
          CONCATENATE <LS_ALLOCVALUESCHAR>-VALUE_CHAR I_DELIMITER INTO LW_SUBSTR.
          IF I_RM_DUPLICATE EQ SPACE OR ( I_RM_DUPLICATE NE SPACE AND NOT LW_STR CS LW_SUBSTR ).
            CONCATENATE <FS> I_DELIMITER INTO <FS>.
            CONCATENATE <FS> <LS_ALLOCVALUESCHAR>-VALUE_CHAR INTO <FS> SEPARATED BY I_CONCAT_SPACE.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.

    LOOP AT LT_ALLOCVALUESNUM ASSIGNING <LS_ALLOCVALUESNUM> WHERE CHARACT IN S_VALUESCHAR.

      LV_FS = <LS_ALLOCVALUESNUM>-CHARACT.


      CLEAR: LS_CABN,LW_ATWRT.
      READ TABLE LT_CABN INTO LS_CABN WITH KEY ATNAM = <LS_ALLOCVALUESNUM>-CHARACT.
      IF SY-SUBRC EQ 0 AND LS_CABN-ATFOR EQ 'DATE'.
        CALL FUNCTION 'CTCV_CONVERT_FLOAT_TO_DATE'
          EXPORTING
            FLOAT = <LS_ALLOCVALUESNUM>-VALUE_FROM
          IMPORTING
            DATE  = LW_ATWRT.
        CONCATENATE LW_ATWRT(4) LW_ATWRT+4(2) LW_ATWRT+6(2) INTO IT_CHARACT-VALUE_CHAR.
        IT_CHARACT-CHARACT = <LS_ALLOCVALUESNUM>-CHARACT.
        APPEND IT_CHARACT.
*        <FS> = LW_ATWRT.
      ELSEIF SY-SUBRC EQ 0 AND LS_CABN-ATFOR EQ 'NUM'.
*        LW_DEC = LS_CABN-ANZST. "4
*        IF LS_CABN-ANZDZ EQ 0.
*          LW_DECIMALS = -2.
*        ELSE.
*          LW_DECIMALS = LS_CABN-ANZDZ."0
*        ENDIF.
*        LW_FLOAT = <LS_ALLOCVALUESNUM>-VALUE_FROM.
*
*        CALL FUNCTION 'C14W_NUMBER_CHAR_CONVERSION'
*         EXPORTING
*           I_FLOAT              = LW_FLOAT
*           I_DEC                = LW_DEC
*           I_DECIMALS           = LW_DECIMALS
*         IMPORTING
*           E_STRING             = LW_ATWRT.
*        IF SY-SUBRC <> 0.
**   IMPLEMENT SUITABLE ERROR HANDLING HERE
*        ENDIF.
*        IF I_INCL_UOM NE SPACE.
*          CONCATENATE LW_ATWRT LS_CABN-MSEH6 INTO LW_ATWRT SEPARATED BY SPACE.
*          CONDENSE LW_ATWRT.
*        ENDIF.

*        <FS>   = LW_ATWRT.
      ENDIF.

    ENDLOOP.

    LOOP AT LT_ALLOCVALUESCURR ASSIGNING <LS_ALLOCVALUESCURR> WHERE CHARACT IN S_VALUESCHAR.
      CONCATENATE 'E' <LS_ALLOCVALUESCURR>-CHARACT INTO LV_FS.
      ASSIGN (LV_FS) TO <FS>.
      <FS> = <LS_ALLOCVALUESCURR>-VALUE_FROM.
    ENDLOOP.



  ENDIF.





ENDFUNCTION.


*Messages
*----------------------------------------------------------
*
* Message class: Hard coded
*   Posting date và Period không đồng nhất
*
* Message class: KX
*001   & & & &

*
*
