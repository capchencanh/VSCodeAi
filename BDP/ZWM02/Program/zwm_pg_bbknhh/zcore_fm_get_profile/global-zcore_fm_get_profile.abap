FUNCTION-POOL ZFG_CORE_GLOBAL.              "MESSAGE-ID ..

* INCLUDE LZFG_CORE_GLOBALD...               " Local class definition
*-----------------------------------------------------------------------
* Type definition
*-----------------------------------------------------------------------
TYPES:
  BEGIN OF GTY_DATA,
    MATNR TYPE MATNR,
    CHARG TYPE CHARG_D,
    WERKS TYPE WERKS_D,
    ATWRT TYPE ATWRT,
    ATFLV TYPE ATFLV,
    ATFOR TYPE ATFOR,
  END OF GTY_DATA,
  BEGIN OF GTY_CABN,
    ATINN TYPE ATINN,
    ADZHL TYPE ADZHL,
    ATNAM TYPE ATNAM,
    ATFOR TYPE ATFOR,
    ANZST TYPE ANZST,
    ANZDZ TYPE ANZDZ,
    ATBEZ TYPE ATBEZ,
  END OF GTY_CABN,
****************(fm ZFM_BATCH_GET_CHAR2
  BEGIN OF GTY_CABN2,
    ATINN TYPE ATINN,
    ADZHL TYPE ADZHL,
    ATNAM TYPE ATNAM,
    ATFOR TYPE ATFOR,
    ANZST TYPE ANZST,
    ANZDZ TYPE ANZDZ,
    ATBEZ TYPE ATBEZ,
    ATSCH TYPE ATSCH,
  END OF GTY_CABN2,
****************)
  BEGIN OF GTY_MCH1,
    MATNR    TYPE MATNR,
    CHARG    TYPE CHARG_D,
    HSDAT    TYPE HSDAT,
    VFDAT    TYPE VFDAT,
    LWEDT    TYPE LWEDT,
    CUOBJ_BM TYPE CUOBN,
    OBJEK    TYPE CUOBN,
  END OF GTY_MCH1,
  BEGIN OF GTY_INOB,
    CUOBJ TYPE CUOBJ,
    KLART TYPE KLASSENART,
    OBTAB TYPE TABELLE,
    OBJEK TYPE CUOBN,
  END OF GTY_INOB,
  BEGIN OF GTY_AUSP2,
    OBJEK TYPE OBJNUM,
    ATINN TYPE ATINN,
    ADZHL TYPE ADZHL,
    ATWRT TYPE ATWRT,
    ATFLV TYPE ATFLV,
    ATZHL TYPE WZAEHL,
  END OF GTY_AUSP2,

  BEGIN OF GTY_MCHA,
    MATNR TYPE MCHA-MATNR,
    CHARG TYPE MCHA-CHARG,
    WERKS TYPE MCHA-WERKS,
    LWEDT TYPE MCHA-LWEDT,
    HSDAT TYPE MCHA-HSDAT,
    VFDAT TYPE MCHA-VFDAT,
    BWTAR TYPE MCHA-BWTAR,
    LIFNR TYPE MCHA-LIFNR,
    LICHA TYPE MCHA-LICHA,
    ERNAM TYPE MCHA-ERNAM,
    ERSDA TYPE MCHA-ERSDA,
    AENAM TYPE MCHA-AENAM,
    LAEDA TYPE MCHA-LAEDA,
  END OF GTY_MCHA.

*-----------------------------------------------------------------------
* Internal Table definition
*-----------------------------------------------------------------------
DATA:
  GT_DATA   TYPE TABLE OF GTY_DATA,
  GT_CABN   TYPE TABLE OF GTY_CABN WITH HEADER LINE,
  GT_MCH1   TYPE HASHED TABLE OF  GTY_MCH1  WITH UNIQUE KEY MATNR CHARG,
  GT_INOB   TYPE HASHED TABLE OF  GTY_INOB  WITH UNIQUE KEY OBJEK,
  GT_AUSP2  TYPE HASHED TABLE OF  GTY_AUSP2 WITH UNIQUE KEY OBJEK ATINN ADZHL WITH HEADER LINE,
  GT_AUSP21 TYPE TABLE OF GTY_AUSP2 WITH HEADER LINE.

*-----------------------------------------------------------------------
* Data definition for create batch characteristic
*-----------------------------------------------------------------------

* Holds data for charcateristics with type NUM
DATA: BEGIN OF NUMTAB OCCURS 0.
        INCLUDE STRUCTURE BAPI1003_ALLOC_VALUES_NUM.
DATA: END OF NUMTAB.
* Golds data for charcateristics with type CHAR/DATE
DATA: BEGIN OF CHATAB OCCURS 0.
        INCLUDE STRUCTURE BAPI1003_ALLOC_VALUES_CHAR.
DATA: END OF CHATAB.
* Golds data for charcateristics with type CURR
DATA: BEGIN OF CURTAB OCCURS 0.
        INCLUDE STRUCTURE BAPI1003_ALLOC_VALUES_CURR.
DATA: END OF CURTAB.
* Error return table
DATA: BEGIN OF RETTAB OCCURS 0.
        INCLUDE STRUCTURE BAPIRET2.
DATA: END OF RETTAB.
DATA: BEGIN OF IT_OBJECT OCCURS 0.
        INCLUDE STRUCTURE BAPI1003_OBJECT_KEYS.
DATA: END OF IT_OBJECT.
* Example of an object key 00000000000730000007505847897897
DATA: W_OBJECT LIKE BAPI1003_KEY-OBJECT.

TABLES: TCURX.
DATA:  T_TCURX  LIKE TCURX OCCURS 0,
       WA_TCURX LIKE TCURX.

