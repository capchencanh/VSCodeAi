*&---------------------------------------------------------------------*
*&  Include           ZIN_SD_TDTHGT_TOP
*&---------------------------------------------------------------------*

TABLES: VBAK, VBAP, VBKD, VBPA.

CONSTANTS:
  GC_VBTYP_CONTRACT TYPE VBAK-VBTYP  VALUE 'G',      " hop dong
  GC_VGTYP_CONTRACT TYPE VBAP-VGTYP  VALUE 'G',      " chung tu tien nhiem la hop dong
  GC_VGTYP_INVOICE  TYPE VBAP-VGTYP  VALUE 'M',      " chung tu tien nhiem la hoa don
  GC_VGTYP_QUOT     TYPE VBAK-VGTYP  VALUE 'B',      " chung tu tien nhiem la bao gia
  GC_VBTYP_INV      TYPE VBRK-VBTYP  VALUE 'M',      " hoa don ban hang
  GC_VBTYP_RET      TYPE VBRK-VBTYP  VALUE 'O',      " hoa don hang ban tra lai
  GC_AUART_L1       TYPE VBAK-AUART  VALUE 'ZCQ1',   " loai chung tu hop dong cap 1
  GC_PARVW_SOLD     TYPE VBPA-PARVW  VALUE 'AG',     " Sold-to party (hien thi SP)
  GC_PARVW_TDV      TYPE VBPA-PARVW  VALUE 'VE',     " Sales employee (hien thi SE)
  GC_PARVW_ASM      TYPE VBPA-PARVW  VALUE 'KM',     " ASM
  GC_POSNR_HDR      TYPE VBPA-POSNR  VALUE '000000', " cap header
  GC_ATNAM_SPCL     TYPE CABN-ATNAM  VALUE 'Z_SPCL', " dac tinh nhom san pham phan tich
  GC_KLART_MAT      TYPE AUSP-KLART  VALUE '001',    " class type vat tu
  GC_MAFID_OBJ      TYPE AUSP-MAFID  VALUE 'O'.      " gia tri gan cho object

TYPES: GTY_YEAR TYPE N LENGTH 4,
       GTY_MM   TYPE N LENGTH 2.

" 1 dong hop dong cap 2 (chua gop so lieu thuc hien)
TYPES: BEGIN OF GTY_ITEM,
         VBELN     TYPE VBAK-VBELN,
         POSNR     TYPE VBAP-POSNR,
         VKORG     TYPE VBAK-VKORG,
         VTWEG     TYPE VBAK-VTWEG,
         SPART     TYPE VBAK-SPART,
         AUART     TYPE VBAK-AUART,
         VKGRP     TYPE VBAK-VKGRP,
         KUNNR     TYPE VBPA-KUNNR,
         GUEBG     TYPE VBAK-GUEBG,
         GUEEN     TYPE VBAK-GUEEN,
         ERDAT     TYPE VBAK-ERDAT,
         BSTNK     TYPE VBAK-BSTNK,
         VGBEL     TYPE VBAK-VGBEL,
         VGTYP     TYPE VBAK-VGTYP,
         WAERK     TYPE VBAK-WAERK,
         MATNR     TYPE VBAP-MATNR,
         ARKTX     TYPE VBAP-ARKTX,
         ZMENG     TYPE VBAP-ZMENG,
         ZIEME     TYPE VBAP-ZIEME,
         VRKME     TYPE VBAP-VRKME,
         NETPR     TYPE VBAP-NETPR,
         KPEIN     TYPE VBAP-KPEIN,
         NETWR     TYPE VBAP-NETWR,
         PRDHA     TYPE MARA-PRDHA,
         VBELN1    TYPE VBAK-VBELN,
         BSTNK1    TYPE VBAK-BSTNK,
         KUNNR1    TYPE VBAK-KUNNR,
         VGBEL1    TYPE VBAK-VGBEL,
         VGTYP1    TYPE VBAK-VGTYP,
         PLTYP     TYPE VBKD-PLTYP,
         KVGR1     TYPE VBAK-KVGR1,
         PERNR_TDV TYPE VBPA-PERNR,
         PERNR_ASM TYPE VBPA-PERNR,
         VKGRP_TX  TYPE TVGRT-BEZEI,
         VKORG_TX  TYPE TVKOT-VTEXT,
         PLTYP_TX  TYPE T189T-PTEXT,
         KVGR1_TX  TYPE TVV1T-BEZEI,
         WGBEZ     TYPE T023T-WGBEZ,
         PRDHA_TX  TYPE T179T-VTEXT,
       END OF GTY_ITEM,
       GTT_ITEM TYPE STANDARD TABLE OF GTY_ITEM WITH EMPTY KEY
                WITH UNIQUE HASHED KEY K_ITEM COMPONENTS VBELN POSNR.

TYPES: BEGIN OF GTY_KEY,
         VBELN TYPE VBAK-VBELN,
         POSNR TYPE VBAP-POSNR,
       END OF GTY_KEY,
       GTT_KEY TYPE STANDARD TABLE OF GTY_KEY WITH EMPTY KEY.

TYPES: BEGIN OF GTY_AUTH,
         VKORG TYPE VBAK-VKORG,
         VTWEG TYPE VBAK-VTWEG,
         SPART TYPE VBAK-SPART,
         AUART TYPE VBAK-AUART,
       END OF GTY_AUTH,
       GTT_AUTH TYPE STANDARD TABLE OF GTY_AUTH WITH EMPTY KEY.

" So lieu hoa don theo dong hop dong + thang (YYYYMM)
TYPES: BEGIN OF GTY_BILL,
         VBELN TYPE VBAK-VBELN,
         POSNR TYPE VBAP-POSNR,
         YM    TYPE C LENGTH 6,
         VRKME TYPE VBRP-VRKME,
         FKIMG TYPE VBRP-FKIMG,
         NETWR TYPE VBRP-NETWR,
       END OF GTY_BILL,
       GTT_BILL TYPE STANDARD TABLE OF GTY_BILL WITH EMPTY KEY.

" So lieu thuc hien da quy doi ve don vi cua hop dong
TYPES: BEGIN OF GTY_MON,
         VBELN TYPE VBAK-VBELN,
         POSNR TYPE VBAP-POSNR,
         YM    TYPE C LENGTH 6,
         QTY   TYPE VBAP-ZMENG,
         VAL   TYPE VBAP-NETWR,
       END OF GTY_MON,
       GTT_MON TYPE SORTED TABLE OF GTY_MON WITH UNIQUE KEY VBELN POSNR YM.

TYPES: BEGIN OF GTY_KUNNR,
         KUNNR TYPE KNA1-KUNNR,
       END OF GTY_KUNNR,
       GTT_KUNNR TYPE SORTED TABLE OF GTY_KUNNR WITH UNIQUE KEY KUNNR.

TYPES: BEGIN OF GTY_CUST,
         KUNNR     TYPE KNA1-KUNNR,
         NAME1     TYPE ADRC-NAME1,
         NAME2     TYPE ADRC-NAME2,
         NAME3     TYPE ADRC-NAME3,
         REGION_TX TYPE T005U-BEZEI,
       END OF GTY_CUST,
       GTT_CUST TYPE HASHED TABLE OF GTY_CUST WITH UNIQUE KEY KUNNR.

TYPES: BEGIN OF GTY_PERNR,
         PERNR TYPE VBPA-PERNR,
       END OF GTY_PERNR,
       GTT_PERNR TYPE SORTED TABLE OF GTY_PERNR WITH UNIQUE KEY PERNR.

TYPES: BEGIN OF GTY_EMP,
         PERNR TYPE PA0001-PERNR,
         ENAME TYPE PA0001-ENAME,
       END OF GTY_EMP,
       GTT_EMP TYPE HASHED TABLE OF GTY_EMP WITH UNIQUE KEY PERNR.

TYPES: BEGIN OF GTY_OBJEK,
         OBJEK TYPE AUSP-OBJEK,
       END OF GTY_OBJEK,
       GTT_OBJEK TYPE SORTED TABLE OF GTY_OBJEK WITH UNIQUE KEY OBJEK.

TYPES: BEGIN OF GTY_SPCL,
         OBJEK TYPE AUSP-OBJEK,
         ATWRT TYPE AUSP-ATWRT,
       END OF GTY_SPCL,
       GTT_SPCL TYPE HASHED TABLE OF GTY_SPCL WITH UNIQUE KEY OBJEK.

TYPES: BEGIN OF GTY_VBELN,
         VBELN TYPE VBAK-VBELN,
       END OF GTY_VBELN,
       GTT_VBELN TYPE SORTED TABLE OF GTY_VBELN WITH UNIQUE KEY VBELN.

TYPES: BEGIN OF GTY_BG,
         VBELN TYPE VBAK-VBELN,
         BSTNK TYPE VBAK-BSTNK,
       END OF GTY_BG,
       GTT_BG TYPE HASHED TABLE OF GTY_BG WITH UNIQUE KEY VBELN.

" Cot co dinh cua ALV; cac cot theo nam/quy/thang duoc sinh dong them vao
TYPES: BEGIN OF GTY_FIX,
         COMBO     TYPE C LENGTH 40,
         VKORG     TYPE VBAK-VKORG,
         VKGRP_TX  TYPE TVGRT-BEZEI,
         VKORG_TX  TYPE TVKOT-VTEXT,
         TINH      TYPE T005U-BEZEI,
         KVGR1_TX  TYPE TVV1T-BEZEI,
         KUNNR1    TYPE VBAK-KUNNR,
         NAME1_L1  TYPE C LENGTH 120,
         KUNNR     TYPE VBPA-KUNNR,
         NAME_KH   TYPE C LENGTH 120,
         PLTYP_TX  TYPE T189T-PTEXT,
         LOAI_CT   TYPE C LENGTH 40,
         VBELN_BG  TYPE VBAK-VBELN,
         VBELN1    TYPE VBAK-VBELN,
         VBELN     TYPE VBAK-VBELN,
         GUEBG     TYPE VBAK-GUEBG,
         GUEEN     TYPE VBAK-GUEEN,
         DAYS_LEFT TYPE I,
         GUEEN_MM  TYPE N LENGTH 2,
         GUEEN_YY  TYPE N LENGTH 4,
         MON_TOTAL TYPE I,
         MON_DONE  TYPE I,
         MON_LEFT  TYPE I,
         REP_DATE  TYPE D,
         MATNR     TYPE VBAP-MATNR,
         ARKTX     TYPE VBAP-ARKTX,
         ZIEME     TYPE VBAP-ZIEME,
         PRICE     TYPE VBAP-NETPR,
         QTY_WIN   TYPE VBAP-ZMENG,
         VAL_WIN   TYPE VBAP-NETWR,
         CUM_Q     TYPE VBAP-ZMENG,
         CUM_V     TYPE VBAP-NETWR,
         REM_Q     TYPE VBAP-ZMENG,
         REM_V     TYPE VBAP-NETWR,
         BSTNK1_BG TYPE VBAK-BSTNK,
         BSTNK     TYPE VBAK-BSTNK,
         ERDAT     TYPE VBAK-ERDAT,
         WGBEZ     TYPE T023T-WGBEZ,
         SPCL      TYPE AUSP-ATWRT,
         PRDHA_TX  TYPE T179T-VTEXT,
         NOTE      TYPE C LENGTH 100,
         PERNR_TDV TYPE VBPA-PERNR,
         NAME_TDV  TYPE PA0001-ENAME,
         PERNR_ASM TYPE VBPA-PERNR,
         NAME_ASM  TYPE PA0001-ENAME,
         POSNR     TYPE VBAP-POSNR,
         VKGRP     TYPE VBAK-VKGRP,
         WAERS     TYPE VBAK-WAERK,
       END OF GTY_FIX.

" Cot sinh dong theo nam/quy/thang. KIND: Q = so luong, V = thanh tien
TYPES: BEGIN OF GTY_DCOL,
         NAME TYPE LVC_FNAME,
         TEXT TYPE SCRTEXT_L,
         KIND TYPE C LENGTH 1,
       END OF GTY_DCOL,
       GTT_DCOL TYPE STANDARD TABLE OF GTY_DCOL WITH EMPTY KEY.

DATA:
  GV_DATE_FR TYPE D,
  GV_DATE_TO TYPE D,
  GV_YEAR    TYPE GTY_YEAR,
  GV_YEAR_PREV TYPE GTY_YEAR,
  GV_MONTH   TYPE GTY_MM,
  GV_SUM_WIN TYPE P LENGTH 15 DECIMALS 2,
  GV_SUM_CUM TYPE P LENGTH 15 DECIMALS 2,
  GV_RATE    TYPE P LENGTH 8 DECIMALS 3.

DATA:
  GT_AUTH TYPE GTT_AUTH,
  GT_ITEM TYPE GTT_ITEM,
  GT_KEY  TYPE GTT_KEY,
  GT_BILL TYPE GTT_BILL,
  GT_MON  TYPE GTT_MON,
  GT_CUST TYPE GTT_CUST,
  GT_EMP  TYPE GTT_EMP,
  GT_SPCL TYPE GTT_SPCL,
  GT_BG   TYPE GTT_BG,
  GT_DCOL TYPE GTT_DCOL.

" Bang ket qua co cau truc dong (cot co dinh + cot nam/quy/thang)
DATA:
  GO_STRUCT TYPE REF TO CL_ABAP_STRUCTDESCR,
  GR_OUT    TYPE REF TO DATA.

FIELD-SYMBOLS <GFS_OUT> TYPE STANDARD TABLE.

DATA:
  GC_SCRFNAME  TYPE SCRFNAME VALUE 'CONTAINER',
  GC_CONTAINER TYPE REF TO CL_GUI_CUSTOM_CONTAINER,
  GO_SPLIT     TYPE REF TO CL_GUI_SPLITTER_CONTAINER,
  GO_TOP       TYPE REF TO CL_GUI_CONTAINER,
  GO_BOT       TYPE REF TO CL_GUI_CONTAINER,
  GO_DOC       TYPE REF TO CL_DD_DOCUMENT,
  GREF_ALV     TYPE REF TO CL_GUI_ALV_GRID.

DATA:
  GS_LAYOUT  TYPE LVC_S_LAYO,
  GT_FLDCAT  TYPE LVC_T_FCAT,
  GS_VARIANT TYPE DISVARIANT.

SELECTION-SCREEN BEGIN OF BLOCK BL1 WITH FRAME TITLE GV_BL1.
PARAMETERS: P_MONTH TYPE C LENGTH 7 OBLIGATORY.
SELECTION-SCREEN END OF BLOCK BL1.

SELECTION-SCREEN BEGIN OF BLOCK BL2 WITH FRAME TITLE GV_BL2.
SELECT-OPTIONS: S_VKORG FOR VBAK-VKORG OBLIGATORY,
                S_VTWEG FOR VBAK-VTWEG,
                S_AUART FOR VBAK-AUART,
                S_VBEL1 FOR VBAK-VBELN,
                S_VBELN FOR VBAK-VBELN,
                S_PLTYP FOR VBKD-PLTYP,
                S_KUNN1 FOR VBAK-KUNNR,
                S_KUNNR FOR VBPA-KUNNR,
                S_MATNR FOR VBAP-MATNR.
SELECTION-SCREEN END OF BLOCK BL2.

SELECTION-SCREEN BEGIN OF BLOCK BL3 WITH FRAME TITLE GV_BL3.
SELECT-OPTIONS: S_VKGRP FOR VBAK-VKGRP,
                S_VKBUR FOR VBAK-VKBUR,
                S_KVGR1 FOR VBAK-KVGR1,
                S_PERNR FOR VBPA-PERNR,
                S_ASM   FOR VBPA-PERNR.
SELECTION-SCREEN END OF BLOCK BL3.

SELECTION-SCREEN BEGIN OF BLOCK BL4 WITH FRAME TITLE GV_BL4.
SELECTION-SCREEN BEGIN OF BLOCK BL5 WITH FRAME TITLE GV_BL5.
PARAMETERS: P_ALL  TYPE CHAR1 RADIOBUTTON GROUP G1 DEFAULT 'X',
            P_REM  TYPE CHAR1 RADIOBUTTON GROUP G1,
            P_DONE TYPE CHAR1 RADIOBUTTON GROUP G1.
SELECTION-SCREEN END OF BLOCK BL5.
SELECTION-SCREEN BEGIN OF BLOCK BL6 WITH FRAME TITLE GV_BL6.
PARAMETERS: P_ALV TYPE CHAR1 RADIOBUTTON GROUP G2 DEFAULT 'X',
            P_XLS TYPE CHAR1 RADIOBUTTON GROUP G2.
SELECTION-SCREEN END OF BLOCK BL6.
SELECTION-SCREEN END OF BLOCK BL4.
