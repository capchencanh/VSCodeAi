*&---------------------------------------------------------------------*
*&  Include           ZWM_IN_PYCVT_TOP
*&---------------------------------------------------------------------*
TABLES RM07M.
TABLES: RESB,
        RKPF,
        AUFK.

* Loại phiếu (nhãn gán trong INIT_SELECTION, không cần Text Elements)
SELECTION-SCREEN BEGIN OF BLOCK B_TYP WITH FRAME TITLE GV_T01.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_T1 RADIOBUTTON GROUP TYP DEFAULT 'X' USER-COMMAND TYP.
SELECTION-SCREEN COMMENT 3(70) GV_C_T1 FOR FIELD P_T1.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_T2 RADIOBUTTON GROUP TYP.
SELECTION-SCREEN COMMENT 3(70) GV_C_T2 FOR FIELD P_T2.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_T3 RADIOBUTTON GROUP TYP.
SELECTION-SCREEN COMMENT 3(70) GV_C_T3 FOR FIELD P_T3.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK B_TYP.

* Điều kiện chọn dữ liệu
SELECTION-SCREEN BEGIN OF BLOCK B_SEL WITH FRAME TITLE GV_T02.
SELECT-OPTIONS:
  S_WERKS FOR RESB-WERKS OBLIGATORY,
  S_RSNUM FOR RM07M-RSNUM,
  S_AUFNR FOR RESB-AUFNR,
  S_AUART FOR AUFK-AUART,
  S_LGORT FOR RESB-LGORT,
  S_BWART FOR RESB-BWART,
  S_BDTER FOR RESB-BDTER,
  S_KOSTL FOR RKPF-KOSTL,
  S_USNAM FOR RKPF-USNAM.
SELECTION-SCREEN END OF BLOCK B_SEL.

* Trạng thái dòng yêu cầu
SELECTION-SCREEN BEGIN OF BLOCK B_STA WITH FRAME TITLE GV_T03.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_OPEN RADIOBUTTON GROUP STA DEFAULT 'X'.
SELECTION-SCREEN COMMENT 3(70) GV_C_OP FOR FIELD P_OPEN.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_DONE RADIOBUTTON GROUP STA.
SELECTION-SCREEN COMMENT 3(70) GV_C_DO FOR FIELD P_DONE.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_ALL RADIOBUTTON GROUP STA.
SELECTION-SCREEN COMMENT 3(70) GV_C_AL FOR FIELD P_ALL.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK B_STA.

* Tùy chọn
SELECTION-SCREEN BEGIN OF BLOCK B_OPT WITH FRAME TITLE GV_T04.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_KTNVL TYPE CHAR1 AS CHECKBOX DEFAULT 'X'.
SELECTION-SCREEN COMMENT 3(70) GV_C_KT FOR FIELD P_KTNVL.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_MPN TYPE CHAR1 AS CHECKBOX DEFAULT 'X'.
SELECTION-SCREEN COMMENT 3(70) GV_C_MP FOR FIELD P_MPN.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS P_INSN TYPE CHAR1 AS CHECKBOX.
SELECTION-SCREEN COMMENT 3(70) GV_C_SN FOR FIELD P_INSN.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK B_OPT.

TYPES:
  BEGIN OF LTY_T001L,
    WERKS TYPE WERKS_D,
    LGORT TYPE LGORT_D,
    LGOBE TYPE LGOBE,
  END OF   LTY_T001L,

  BEGIN OF LTY_EQKT,
    EQUNR TYPE EQUNR,
    EQKTX TYPE KTX01,
  END OF   LTY_EQKT,

  BEGIN OF LTY_ANLA,
    BUKRS TYPE BUKRS,
    ANLN1 TYPE ANLN1,
    TXT50 TYPE TXA50_ANLT,
  END OF   LTY_ANLA,

  BEGIN OF GTY_TOTAL_BATCH,
    BWKEY         LIKE MBEW-BWKEY,
    WERKS         LIKE MSEG-WERKS,
    LGORT         LIKE MSEG-LGORT,
    MATNR         LIKE MSEG-MATNR,
    CHARG         LIKE MSEG-CHARG,
    ENDMENGE(09)  TYPE P DECIMALS 3,    "Bestand zu 'datum-high'
    ANFMENGE(09)  TYPE P DECIMALS 3,   "Bestand zu 'datum-low'
    MEINS         TYPE MEINS,                  "Mengeneinheit
    ENDWERT(09)   TYPE P    DECIMALS 2,
    ANFWERT(09)   TYPE P    DECIMALS 2,

    SOLL(09)      TYPE P DECIMALS 3,
    HABEN(09)     TYPE P DECIMALS 3,
    SOLLWERT(09)  TYPE P    DECIMALS 2,
    HABENWERT(09) TYPE P    DECIMALS 2,
    WAERS         LIKE T001-WAERS,             "Währungsschlüssel
  END OF GTY_TOTAL_BATCH,

  BEGIN OF GTY_PCK,
    MBLNR TYPE MSEG-MBLNR,
    MJAHR TYPE MSEG-MJAHR,
    RSNUM TYPE MSEG-RSNUM,
    RSPOS TYPE MSEG-RSPOS,
    ERFMG TYPE MSEG-ERFMG,
    ERFME TYPE MSEG-ERFME,
    SMBLN TYPE MSEG-SMBLN,
    SJAHR TYPE MSEG-SJAHR,
  END OF GTY_PCK.

CONSTANTS:
  GC_TYPE_PROD  TYPE CHAR1 VALUE '1',   " Yêu cầu vật tư cho Lệnh sản xuất
  GC_TYPE_SUPP  TYPE CHAR1 VALUE '2',   " Yêu cầu vật tư bổ sung cho sản xuất
  GC_TYPE_OTHER TYPE CHAR1 VALUE '3'.   " Yêu cầu vật tư cho bộ phận khác

TYPES:
* Khóa rút gọn để JOIN với internal table thay cho FOR ALL ENTRIES
  BEGIN OF GTY_KEY_EQ,
    EQUNR TYPE EQUNR,
  END OF GTY_KEY_EQ,
  BEGIN OF GTY_KEY_SL,
    WERKS TYPE WERKS_D,
    UMLGO TYPE UMLGO,
  END OF GTY_KEY_SL,
  BEGIN OF GTY_KEY_AN,
    ANLN1 TYPE ANLN1,
  END OF GTY_KEY_AN,
  BEGIN OF GTY_KEY_AU,
    AUFNR TYPE AUFNR,
  END OF GTY_KEY_AU,
  BEGIN OF GTY_KEY_US,
    USNAM TYPE USNAM,
  END OF GTY_KEY_US,
  BEGIN OF GTY_KEY_RS,
    RSNUM TYPE RSNUM,
  END OF GTY_KEY_RS,

* Thành phẩm của lệnh sản xuất
  BEGIN OF GTY_AFPO,
    AUFNR TYPE AFPO-AUFNR,
    MATNR TYPE AFPO-MATNR,
    CHARG TYPE AFPO-CHARG,
    MAKTX TYPE MAKT-MAKTX,
  END OF GTY_AFPO,

* Họ tên người tạo
  BEGIN OF GTY_USER,
    USNAM     TYPE USNAM,
    NAME_TEXT TYPE AD_NAMTEXT,
  END OF GTY_USER,

* Thuộc tính lô: số lô NSX, nhà sản xuất
  BEGIN OF GTY_BATCH,
    MATNR       TYPE MATNR,
    WERKS       TYPE WERKS_D,
    CHARG       TYPE CHARG_D,
    Z_NSX       TYPE ATWRT,
    Z_BATCH_NSX TYPE ATWRT,
  END OF GTY_BATCH,

* Dòng bị loại khỏi phiếu vì chưa có Batch
  BEGIN OF GTY_EXCL,
    RSNUM TYPE RSNUM,
    RSPOS TYPE RSPOS,
    MATNR TYPE MATNR,
    TEXT  TYPE CHAR100,
  END OF GTY_EXCL.

"KHAI BAO INTERNAL TABLE VA WORK AREA
FIELD-SYMBOLS <FS_DATA> TYPE ZWM_ST_PYCVT.

DATA:
  GT_DATA      TYPE TABLE OF ZWM_ST_PYCVT,
  GT_PREDATA   TYPE TABLE OF ZWM_ST_PYCVT,
  GS_DATA      TYPE          ZWM_ST_PYCVT,
  GT_HEADER    TYPE TABLE OF ZWM_ST_PYCVT,
  GS_HEADER    TYPE          ZWM_ST_PYCVT,

  GT_T001L     TYPE TABLE OF LTY_T001L WITH NON-UNIQUE KEY WERKS LGORT,
  GS_T001L     TYPE          LTY_T001L,

  GT_EQKT      TYPE TABLE OF LTY_EQKT,
  GS_EQKT      TYPE          LTY_EQKT,

  GT_ANLA      TYPE TABLE OF LTY_ANLA,
  GS_ANLA      TYPE          LTY_ANLA,

  GS_PARAMETER TYPE          ZCORE_ST_PARAMETER,
  GW_NAME      TYPE          CHAR255,
  GW_NUMBER    TYPE          CHAR10,
  GW_LGOBE     TYPE          LGOBE,
  LW_HILFE     TYPE          CHAR4,
  GT_MB5B      TYPE TABLE OF GTY_TOTAL_BATCH,
  GS_MB5B      TYPE GTY_TOTAL_BATCH,
  GT_PCK       TYPE TABLE OF GTY_PCK.

DATA:
  GV_DOC_TYPE TYPE CHAR1,
  GT_AFPO     TYPE SORTED TABLE OF GTY_AFPO WITH UNIQUE KEY AUFNR,
  GT_USER     TYPE STANDARD TABLE OF GTY_USER,
  GT_BATCH    TYPE SORTED TABLE OF GTY_BATCH WITH UNIQUE KEY MATNR WERKS CHARG,
  GT_EXCL     TYPE STANDARD TABLE OF GTY_EXCL.

CONSTANTS:
  GC_TCODE     TYPE TCODE    VALUE 'ZWM01',
  GC_FORMNAME  TYPE TDSFNAME VALUE 'ZWM_SF_PYCVT',
  GC_CONT_NAME TYPE C LENGTH 30 VALUE 'CC_MAIN',
  GC_PAR_PSA   TYPE C LENGTH 10 VALUE 'PSA_LGTYP',   " Storage Type PSA theo Warehouse
  GC_PAR_FORM  TYPE C LENGTH 10 VALUE 'FORM_CODE'.   " Mã biểu mẫu GMP theo Plant

TYPES:
* Bảng tham số ZTWM01_PARAM
  BEGIN OF GTY_PARAM,
    PARAM_ID TYPE C LENGTH 10,
    KEY1     TYPE C LENGTH 10,
    KEY2     TYPE C LENGTH 10,
    PVALUE   TYPE C LENGTH 40,
  END OF GTY_PARAM,

* Số lần đã in của từng Reservation (theo nhật ký in ZTWM01_PRTLOG)
  BEGIN OF GTY_PRTCNT,
    RSNUM     TYPE RSNUM,
    PRT_COUNT TYPE ZEWM_DE_PRT_COUNT,
  END OF GTY_PRTCNT,
  GTT_PRTCNT TYPE HASHED TABLE OF GTY_PRTCNT WITH UNIQUE KEY RSNUM,
  GTT_R_MATNR TYPE RANGE OF MATNR,
  GTT_R_WERKS TYPE RANGE OF WERKS_D,
  GTT_R_LGNUM TYPE RANGE OF /SCWM/LGNUM,

* Plant/SLoc -> Warehouse EWM
  BEGIN OF GTY_WHS,
    WERKS TYPE WERKS_D,
    LGORT TYPE LGORT_D,
    LGNUM TYPE /SCWM/LGNUM,
  END OF GTY_WHS,

* Party entitled + Stock Type EWM -> Plant/SLoc/loại tồn ERP
  BEGIN OF GTY_MAPL,
    LGNUM    TYPE /SCWM/LGNUM,
    ENTITLED TYPE /SCWM/DE_ENTITLED,
    CAT      TYPE /SCWM/DE_CAT,
    WERKS    TYPE WERKS_D,
    LGORT    TYPE LGORT_D,
    BESTQ    TYPE BESTQ,
  END OF GTY_MAPL,

* Tồn IM theo SLoc (theo Batch nếu có)
  BEGIN OF GTY_IM,
    MATNR TYPE MATNR,
    WERKS TYPE WERKS_D,
    LGORT TYPE LGORT_D,
    CHARG TYPE CHARG_D,
    QUAN  TYPE LABST,
  END OF GTY_IM,

* Quant eWM
  BEGIN OF GTY_EWM,
    LGNUM    TYPE I_EWM_PHYSSTOCKPROD-EWMWAREHOUSE,
    LGTYP    TYPE I_EWM_PHYSSTOCKPROD-EWMSTORAGETYPE,
    LGPLA    TYPE I_EWM_PHYSSTOCKPROD-EWMSTORAGEBIN,
    HUID     TYPE I_EWM_PHYSSTOCKPROD-HANDLINGUNITNUMBER,
    MATNR    TYPE MATNR,
    CHARG    TYPE CHARG_D,
    ENTITLED TYPE I_EWM_PHYSSTOCKPROD-ENTITLEDTODISPOSEPARTY,
    CAT      TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKTYPE,
    CAT_TXT  TYPE I_EWM_STOCKTYPETEXT_2-EWMSTOCKTYPENAME,
    QUAN     TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKQUANTITYINBASEUNIT,
    MEINS    TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKQUANTITYBASEUNIT,
    PICK     TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKQUANTITYINBASEUNIT,
    WERKS    TYPE WERKS_D,
    LGORT    TYPE LGORT_D,
    BESTQ    TYPE BESTQ,
    PSA      TYPE ABAP_BOOL,
  END OF GTY_EWM,

* Warehouse Task chưa xác nhận (lấy hàng từ Bin nguồn)
  BEGIN OF GTY_WT,
    FLG_HU   TYPE I_EWM_OPENWAREHOUSETASKS_2-ISHANDLINGUNITWAREHOUSETASK,
    LGNUM    TYPE I_EWM_OPENWAREHOUSETASKS_2-EWMWAREHOUSE,
    MATNR    TYPE MATNR,
    CHARG    TYPE CHARG_D,
    ENTITLED TYPE I_EWM_OPENWAREHOUSETASKS_2-ENTITLEDTODISPOSEPARTY,
    CAT      TYPE I_EWM_OPENWAREHOUSETASKS_2-EWMSTOCKTYPE,
    SRC_BIN  TYPE I_EWM_OPENWAREHOUSETASKS_2-SOURCESTORAGEBIN,
    SRC_HU   TYPE I_EWM_OPENWAREHOUSETASKS_2-SOURCEHANDLINGUNIT,
    QTY      TYPE I_EWM_OPENWAREHOUSETASKS_2-TARGETQUANTITYINBASEUNIT,
  END OF GTY_WT,

* Dòng Reservation/LSX khác đang giữ tồn
  BEGIN OF GTY_HOLD,
    RSNUM    TYPE RSNUM,
    RSPOS    TYPE RSPOS,
    AUFNR    TYPE AUFNR,
    LOAI     TYPE TEXT30,
    BDTER    TYPE BDTER,
    OPEN_QTY TYPE BDMNG,
    MEINS    TYPE MEINS,
    USNAM    TYPE USNAM,
    MATNR    TYPE MATNR,
    WERKS    TYPE WERKS_D,
    LGORT    TYPE LGORT_D,
    CHARG    TYPE CHARG_D,
    AUTYP    TYPE AUFTYP,
  END OF GTY_HOLD,

* Popup tồn eWM theo Storage Type / Bin
  BEGIN OF GTY_BIN,
    LGNUM   TYPE /SCWM/LGNUM,
    LGTYP   TYPE /SCWM/LGTYP,
    LGPLA   TYPE /SCWM/LGPLA,
    CHARG   TYPE CHARG_D,
    CAT     TYPE /SCWM/DE_CAT,
    CAT_TXT TYPE TEXT60,
    PHYS    TYPE BDMNG,
    AVAIL   TYPE BDMNG,
    MEINS   TYPE MEINS,
  END OF GTY_BIN.

DATA:
  GT_ALV    TYPE STANDARD TABLE OF ZWM_ST_PYCVT,      " Màn hình trung gian
  GT_PRINT  TYPE STANDARD TABLE OF ZWM_ST_PYCVT,      " Dòng đưa vào phiếu in
