  GO_MAP    TYPE REF TO /SCWM/IF_STOCKID_MAPPING,
  GV_NOPSA  TYPE /SCWM/LGNUM,                         " Warehouse chưa khai báo Storage Type PSA
  GV_OK     TYPE SY-UCOMM,
  GV_LOGSYS TYPE LOGSYS,
  GV_FIRST  TYPE ABAP_BOOL VALUE ABAP_TRUE.
