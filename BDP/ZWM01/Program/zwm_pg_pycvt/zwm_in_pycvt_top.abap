  GT_HOLD_D TYPE STANDARD TABLE OF GTY_HOLD,          " Popup chi tiết giữ tồn
  GT_BIN_D  TYPE STANDARD TABLE OF GTY_BIN,           " Popup tồn theo Bin
  GO_CONT   TYPE REF TO CL_GUI_CUSTOM_CONTAINER,
