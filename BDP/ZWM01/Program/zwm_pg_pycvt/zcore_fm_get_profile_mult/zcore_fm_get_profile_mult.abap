FUNCTION ZCORE_FM_GET_PROFILE_MULT.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  EXPORTING
*"     REFERENCE(ES_HEAD) TYPE  ZST_PROFILE
*"  TABLES
*"      IT_DATA TYPE  ZTT_PROFILE OPTIONAL
*"      IT_EMAIL STRUCTURE  ZST_EMAIL OPTIONAL
*"--------------------------------------------------------------------
CONSTANTS:
    BP          VALUE 'B',
    COMPANYCODE VALUE 'C',
    PLANT       VALUE 'P',
    SALEORG     VALUE 'S',
    VENDOR      VALUE 'K',
    CUSTOMER    VALUE 'D',
    PARTNER     VALUE 'F'.

  DATA: LT_DATA   LIKE IT_DATA[],
        LT_DATA_B LIKE LT_DATA[],
        LT_DATA_C LIKE LT_DATA[],
        LT_DATA_P LIKE LT_DATA[],
        LT_DATA_S LIKE LT_DATA[],
        LT_DATA_K LIKE LT_DATA[],
        LT_DATA_D LIKE LT_DATA[],
        LT_DATA_F LIKE LT_DATA[].
  REFRESH:
    LT_DATA,
    LT_DATA_B,
    LT_DATA_C,
    LT_DATA_P,
    LT_DATA_S,
    LT_DATA_K,
    LT_DATA_D,
    LT_DATA_F.

  IF  IT_DATA[] IS INITIAL
  AND ES_HEAD   IS INITIAL.

    RETURN.

  ELSEIF IT_DATA[] IS INITIAL
  AND    ES_HEAD   IS NOT INITIAL.
    APPEND ES_HEAD TO IT_DATA[].

  ENDIF.

  LT_DATA[] = IT_DATA[].
  SORT LT_DATA BY NUMBER.
  DELETE LT_DATA WHERE NUMBER IS INITIAL.
  IF NOT LT_DATA IS INITIAL.
    LOOP AT LT_DATA INTO DATA(LS_DATA).
      CASE LS_DATA-KIND.
        WHEN COMPANYCODE.
          LS_DATA-BUKRS       = LS_DATA-NUMBER.
          LS_DATA-GET_COUNTRY = LS_DATA-GET_COUNTRY.
          APPEND LS_DATA TO LT_DATA_C.
        WHEN PLANT.
          LS_DATA-WERKS = LS_DATA-NUMBER.
          APPEND LS_DATA TO LT_DATA_P.
        WHEN SALEORG.
          LS_DATA-VKORG = LS_DATA-NUMBER.
          APPEND LS_DATA TO LT_DATA_S.
        WHEN VENDOR.
          LS_DATA-LIFNR = LS_DATA-NUMBER.
          LS_DATA-BUKRS = LS_DATA-BUKRS.
          LS_DATA-BELNR = LS_DATA-BELNR.
          LS_DATA-GJAHR = LS_DATA-GJAHR.
          LS_DATA-ADRNR = LS_DATA-ADRNR.
          APPEND LS_DATA TO LT_DATA_K.
        WHEN CUSTOMER.
          LS_DATA-KUNNR = LS_DATA-NUMBER.
          LS_DATA-BUKRS = LS_DATA-BUKRS.
          LS_DATA-BELNR = LS_DATA-BELNR.
          LS_DATA-GJAHR = LS_DATA-GJAHR.
          LS_DATA-ADRNR = LS_DATA-ADRNR.
          APPEND LS_DATA TO LT_DATA_D.
        WHEN PARTNER.
          LS_DATA-VBELN = LS_DATA-NUMBER.
          LS_DATA-PARVW = LS_DATA-PARVW.
          APPEND LS_DATA TO LT_DATA_F.
        WHEN BP.
          LS_DATA-PARTNER = LS_DATA-NUMBER.
          APPEND LS_DATA TO LT_DATA_B.
      ENDCASE.
    ENDLOOP.
  ENDIF.

  REFRESH
  IT_DATA.

  IF NOT LT_DATA_C IS INITIAL.
    PERFORM GET_CC_ADDRESS
     TABLES LT_DATA_C.
    APPEND LINES OF LT_DATA_C TO IT_DATA[].
  ENDIF.

  IF NOT LT_DATA_P IS INITIAL.
    PERFORM GET_PLT_ADDRESS
     TABLES LT_DATA_P.
    APPEND LINES OF LT_DATA_P TO IT_DATA[].
  ENDIF.

  IF NOT LT_DATA_S IS INITIAL.
    PERFORM GET_SALE_ORG_ADDRESS
     TABLES LT_DATA_S.
    APPEND LINES OF LT_DATA_S TO IT_DATA[].
  ENDIF.

  IF NOT LT_DATA_D IS INITIAL.
    PERFORM GET_CUS_ADDRESS
     TABLES LT_DATA_D
            IT_EMAIL.
    APPEND LINES OF LT_DATA_D TO IT_DATA[].
  ENDIF.

  IF NOT LT_DATA_K IS INITIAL.
    PERFORM GET_VEN_ADDRESS
     TABLES LT_DATA_K
            IT_EMAIL.
    APPEND LINES OF LT_DATA_K TO IT_DATA[].
  ENDIF.
  IF NOT LT_DATA_F IS INITIAL.
    PERFORM GET_PARTNER_ADDRESS
     TABLES LT_DATA_F.
    APPEND LINES OF LT_DATA_F TO IT_DATA[].
  ENDIF.

  IF NOT LT_DATA_B IS INITIAL.
    PERFORM GET_BP_ADDRESS
     TABLES LT_DATA_B.
    APPEND LINES OF LT_DATA_B TO IT_DATA[].
  ENDIF.

  READ TABLE IT_DATA INTO ES_HEAD
    WITH KEY NATION = ES_HEAD-NATION.





ENDFUNCTION.


