*&---------------------------------------------------------------------*
*&  Include           ZIN_SD_PDVHMN_TOP
*&---------------------------------------------------------------------*

TABLES: VBAK, KNVV, VBPA, CDHDR.

TYPES: BEGIN OF GTY_ALV,
         STT       TYPE N LENGTH 6,
         VKBUR     TYPE VBAK-VKBUR,
         VKBUR_TX  TYPE TVKBT-BEZEI,
         KUNNR     TYPE VBAK-KUNNR,
         KUNNR_TX  TYPE C LENGTH 160,
         KDGRP     TYPE KNVV-KDGRP,
         KDGRP_TX  TYPE T151T-KTEXT,
         VBELN     TYPE VBAK-VBELN,
         VBELN_VF  TYPE C LENGTH 60,
         CHANGENR  TYPE CDHDR-CHANGENR,
         AUDAT     TYPE VBAK-AUDAT,
         NETWR     TYPE VBAK-NETWR,
         PERNR     TYPE C LENGTH 8,
         PERNR_TX  TYPE PA0001-ENAME,
         REASON    TYPE C LENGTH 30,
         CRLIMIT   TYPE VBAK-NETWR,
         CREXPOS   TYPE VBAK-NETWR,
         OVERDUE   TYPE VBAK-NETWR,
         STATUS    TYPE C LENGTH 20,
         APPROVER  TYPE C LENGTH 60,
         APPDATE   TYPE VBAK-CMFRE,
         AMTBL     TYPE VBAK-AMTBL,
         WAERK     TYPE VBAK-WAERK,
       END OF GTY_ALV,
       GTT_ALV TYPE STANDARD TABLE OF GTY_ALV WITH EMPTY KEY.

TYPES: BEGIN OF GTY_ORDER,
         VBELN        TYPE VBAK-VBELN,
         AUDAT        TYPE VBAK-AUDAT,
         NETWR        TYPE VBAK-NETWR,
         WAERK        TYPE VBAK-WAERK,
         VKBUR        TYPE VBAK-VKBUR,
         KUNNR        TYPE VBAK-KUNNR,
         KKBER        TYPE VBAK-KKBER,
         CMGST        TYPE VBAK-CMGST,
         CMFRE        TYPE VBAK-CMFRE,
         AMTBL        TYPE VBAK-AMTBL,
         VKBUR_TX     TYPE TVKBT-BEZEI,
         KDGRP        TYPE KNVV-KDGRP,
         KDGRP_TX     TYPE T151T-KTEXT,
         PERNR        TYPE VBPA-PERNR,
         PERNR_TX     TYPE PA0001-ENAME,
         NAME1        TYPE ADRC-NAME1,
         NAME2        TYPE ADRC-NAME2,
         NAME3        TYPE ADRC-NAME3,
         NAME4        TYPE ADRC-NAME4,
         CREDIT_SGMNT TYPE UKM_KKBER2SGM-CREDIT_SGMNT,
         CREDIT_LIMIT TYPE UKMBP_CMS_SGM-CREDIT_LIMIT,
         EXPOSURE     TYPE UKM_TOTALS-AMOUNT,
       END OF GTY_ORDER,
       GTT_ORDER TYPE STANDARD TABLE OF GTY_ORDER WITH EMPTY KEY.

TYPES: BEGIN OF GTY_BILL,
         VBELN    TYPE VBAK-VBELN,
         BILLLIST TYPE STRING,
       END OF GTY_BILL,
       GTT_BILL TYPE SORTED TABLE OF GTY_BILL WITH UNIQUE KEY VBELN.

TYPES: BEGIN OF GTY_CHG,
         VBELN    TYPE VBAK-VBELN,
         CHANGENR TYPE CDHDR-CHANGENR,
         APPROVER TYPE C LENGTH 60,
         UDATE    TYPE CDHDR-UDATE,
       END OF GTY_CHG,
       GTT_CHG TYPE SORTED TABLE OF GTY_CHG WITH UNIQUE KEY VBELN.

TYPES: BEGIN OF GTY_OVERDUE,
         KUNNR  TYPE VBAK-KUNNR,
         AMOUNT TYPE VBAK-NETWR,
       END OF GTY_OVERDUE,
       GTT_OVERDUE TYPE SORTED TABLE OF GTY_OVERDUE WITH UNIQUE KEY KUNNR.

DATA: GV_REASON TYPE C LENGTH 30,
      GT_ALV    TYPE GTT_ALV,
      GT_ORDER  TYPE GTT_ORDER.

CONSTANTS:
* VBAK-CMGST: B chan, C duyet mot phan, D da duyet
  GC_CMGST_BLOCK TYPE VBAK-CMGST VALUE 'B',
  GC_CMGST_PART  TYPE VBAK-CMGST VALUE 'C',
  GC_CMGST_REL   TYPE VBAK-CMGST VALUE 'D',
  GC_PARVW_AG    TYPE VBPA-PARVW VALUE 'AG',
  GC_PARVW_VE    TYPE VBPA-PARVW VALUE 'VE',
  GC_POSNR_HD    TYPE VBPA-POSNR VALUE '000000',
  GC_OBJCLAS     TYPE CDHDR-OBJECTCLAS VALUE 'VERKBELEG',
  GC_TABNAME_CD  TYPE CDPOS-TABNAME VALUE 'VBAK',
  GC_FNAME_CD    TYPE CDPOS-FNAME   VALUE 'CMGST',
  GC_WAERK_VND   TYPE VBAK-WAERK VALUE 'VND'.

SELECTION-SCREEN BEGIN OF BLOCK BL1 WITH FRAME TITLE TEXT-B01.
SELECT-OPTIONS: S_VKORG FOR VBAK-VKORG OBLIGATORY,
                S_VTWEG FOR VBAK-VTWEG,
                S_VKBUR FOR VBAK-VKBUR,
                S_AUDAT FOR VBAK-AUDAT OBLIGATORY,
                S_VBELN FOR VBAK-VBELN,
                S_AUART FOR VBAK-AUART.
SELECTION-SCREEN END OF BLOCK BL1.

SELECTION-SCREEN BEGIN OF BLOCK BL2 WITH FRAME TITLE TEXT-B02.
SELECT-OPTIONS: S_KUNNR FOR VBAK-KUNNR,
                S_KDGRP FOR KNVV-KDGRP,
                S_PERNR FOR VBPA-PERNR NO INTERVALS.
SELECTION-SCREEN END OF BLOCK BL2.

SELECTION-SCREEN BEGIN OF BLOCK BL3 WITH FRAME TITLE TEXT-B03.
SELECT-OPTIONS: S_KKBER FOR VBAK-KKBER,
                S_REASON FOR GV_REASON NO INTERVALS,
                S_CMGST FOR VBAK-CMGST NO INTERVALS,
                S_CMFRE FOR VBAK-CMFRE.
SELECTION-SCREEN END OF BLOCK BL3.