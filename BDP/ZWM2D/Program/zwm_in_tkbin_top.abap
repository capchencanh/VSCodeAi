TYPES:
* Cau hinh tach ma Bin theo Storage Type (ZTWM_BIN_LAYOUT)
  GTT_LAY TYPE SORTED TABLE OF ZTWM_BIN_LAYOUT WITH UNIQUE KEY LGNUM LGTYP,

* Storage Bin + toa do tren so do
  BEGIN OF GTY_BIN,
    LGPLA    TYPE /SCWM/LGPLA,
    LGTYP    TYPE /SCWM/LGTYP,
    LGBER    TYPE /SCWM/LGBER,
    LPTYP    TYPE /SCWM/LVS_LPTYP,
    SKZUE    TYPE CHAR1,
    SKZUA    TYPE CHAR1,
    SKZSI    TYPE CHAR1,
    BTANR    TYPE I_EWM_STORAGEBIN_2-EWMSTORAGEBINLASTWAREHOUSETASK,
    MOVED_AT TYPE TIMESTAMPL,
    IDATU    TYPE TIMESTAMPL,
    PI_DOC   TYPE I_EWM_STORAGEBIN_2-PHYSICALINVENTORYDOCNUMBER,
    CHG_USER TYPE I_EWM_STORAGEBIN_2-EWMSTORAGEBINLASTCHANGEDBYUSER,
    CHG_AT   TYPE TIMESTAMPL,
    CAPA     TYPE I_EWM_STORAGEBIN_2-EWMSTORBINAVAILCAPACITYVALUE,
*   Day / Ke / Tang / O / Vi tri doc tu cac truong chuan cua Storage Bin
    AISLE_S  TYPE C LENGTH 18,
    STACK_S  TYPE C LENGTH 18,
    LEVEL_S  TYPE C LENGTH 18,
    CELL_S   TYPE C LENGTH 18,
    SLOT_S   TYPE C LENGTH 18,
    AISLE    TYPE C LENGTH 8,
    STACK    TYPE C LENGTH 8,
    BLOCK    TYPE C LENGTH 16,
    LEVEL    TYPE N LENGTH 3,
    CELL     TYPE N LENGTH 3,
    SLOT     TYPE N LENGTH 3,
    PLACED   TYPE ABAP_BOOL,
    CHG_DATE TYPE DATS,
    CHG_TIME TYPE TIMS,
    LOCK_TXT TYPE C LENGTH 120,
  END OF GTY_BIN,
  GTT_BIN TYPE HASHED TABLE OF GTY_BIN WITH UNIQUE KEY LGPLA,

* Dong ket qua: 1 quant, hoac 1 Bin trong khong co ton
  BEGIN OF GTY_OUT,
    ICON     TYPE ICON_D,
    LGTYP    TYPE /SCWM/LGTYP,
    LGBER    TYPE /SCWM/LGBER,
    LGPLA    TYPE /SCWM/LGPLA,
    AISLE    TYPE C LENGTH 8,
    STACK    TYPE C LENGTH 8,
    LEVEL    TYPE N LENGTH 3,
    CELL     TYPE N LENGTH 3,
    SLOT     TYPE N LENGTH 3,
    LPTYP    TYPE /SCWM/LVS_LPTYP,
    CAPA     TYPE I_EWM_STORAGEBIN_2-EWMSTORBINAVAILCAPACITYVALUE,
    HUID     TYPE I_EWM_PHYSSTOCKPROD-HANDLINGUNITNUMBER,
    HU_TOP   TYPE I_EWM_PHYSSTOCKPROD-EWMHGHSTLVLHANDLINGUNITNUMBER,
    STOCK_ID TYPE I_EWM_PHYSSTOCKPROD-STOCKITEMUUID,
    MATNR    TYPE MATNR,
    MAKTX    TYPE MAKT-MAKTX,
    WERKS    TYPE WERKS_D,
    LGORT    TYPE LGORT_D,
    ENTITLED TYPE I_EWM_PHYSSTOCKPROD-ENTITLEDTODISPOSEPARTY,
    CAT      TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKTYPE,
    CAT_TXT  TYPE I_EWM_STOCKTYPETEXT_2-EWMSTOCKTYPENAME,
    STK_USG  TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKUSAGE,
    STK_NO   TYPE I_EWM_PHYSSTOCKPROD-EXTERNALSTOCKDOCUMENTNUMBER,
    OWNER    TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKOWNER,
    CHARG    TYPE CHARG_D,
    NSX_LOT  TYPE ATWRT,
    NSX      TYPE CHAR60,
    VFDAT    TYPE DATS,
    QNDAT    TYPE DATS,
    WDATU_TS TYPE TIMESTAMPL,
    WDATE    TYPE DATS,
    AGE      TYPE I,
    QUAN     TYPE MENGE_D,
    AVAIL    TYPE MENGE_D,
    WAIT_IN  TYPE MENGE_D,
    PICK_QTY TYPE MENGE_D,
    MEINS    TYPE MEINS,
    QUAN_CV  TYPE MENGE_D,
    MEINS_CV TYPE MEINS,
    SKZUE    TYPE CHAR1,
    SKZUA    TYPE CHAR1,
    SKZSI    TYPE CHAR1,
    LOCK_TXT TYPE C LENGTH 120,
    CHG_USER TYPE I_EWM_STORAGEBIN_2-EWMSTORAGEBINLASTCHANGEDBYUSER,
    CHG_DATE TYPE DATS,
    CHG_TIME TYPE TIMS,
    IDATE    TYPE DATS,
    MV_DATE  TYPE DATS,
    MV_TIME  TYPE TIMS,
    BTANR    TYPE I_EWM_STORAGEBIN_2-EWMSTORAGEBINLASTWAREHOUSETASK,
  END OF GTY_OUT,
  GTT_OUT TYPE STANDARD TABLE OF GTY_OUT WITH EMPTY KEY
          WITH NON-UNIQUE SORTED KEY K_BIN COMPONENTS LGPLA,

* O tren so do (1 Bin)
  BEGIN OF GTY_CELL,
    IDX       TYPE I,
    LGPLA     TYPE /SCWM/LGPLA,
    BLOCK     TYPE C LENGTH 16,
    LEVEL     TYPE I,
    CELL      TYPE I,
    SLOT      TYPE I,
    PLACED    TYPE ABAP_BOOL,
    HAS_STOCK TYPE ABAP_BOOL,
    FOUND     TYPE ABAP_BOOL,
    LINES     TYPE I,
    SKZUE     TYPE CHAR1,
    SKZUA     TYPE CHAR1,
    SKZSI     TYPE CHAR1,
  END OF GTY_CELL,
  GTT_CELL TYPE SORTED TABLE OF GTY_CELL WITH UNIQUE KEY LGPLA
           WITH NON-UNIQUE SORTED KEY K_POS COMPONENTS BLOCK LEVEL SLOT,

* Dong chu thich / thong ke (cot TEXT to mau theo COLTAB)
  BEGIN OF GTY_STAT,
    TEXT   TYPE C LENGTH 60,
    VAL    TYPE C LENGTH 30,
    PCT    TYPE C LENGTH 10,
    COLTAB TYPE LVC_T_SCOL,
  END OF GTY_STAT,
  GTT_STAT TYPE STANDARD TABLE OF GTY_STAT WITH EMPTY KEY,

* Warehouse Task chua xac nhan (Bin nguon / Bin dich, so luong con mo)
  BEGIN OF GTY_WT,
    FLG_HU   TYPE ABAP_BOOL,
    STOCK_ID TYPE I_EWM_OPENWAREHOUSETASKS_2-STOCKITEMUUID,
    MATNR    TYPE MATNR,
    MAKTX    TYPE MAKT-MAKTX,
    CHARG    TYPE CHARG_D,
    ENTITLED TYPE I_EWM_PHYSSTOCKPROD-ENTITLEDTODISPOSEPARTY,
    CAT      TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKTYPE,
    CAT_TXT  TYPE I_EWM_STOCKTYPETEXT_2-EWMSTOCKTYPENAME,
    STK_USG  TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKUSAGE,
    OWNER    TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKOWNER,
    SRC_BIN  TYPE /SCWM/LGPLA,
    SRC_HU   TYPE I_EWM_PHYSSTOCKPROD-HANDLINGUNITNUMBER,
    DST_BIN  TYPE /SCWM/LGPLA,
    DST_HU   TYPE I_EWM_PHYSSTOCKPROD-HANDLINGUNITNUMBER,
    QTY      TYPE MENGE_D,
    MEINS    TYPE MEINS,
  END OF GTY_WT,
  GTT_WT TYPE STANDARD TABLE OF GTY_WT WITH EMPTY KEY,

* Plant / SLoc suy ra tu Party entitled + Stock Type (nho lai de khong goi lai API)
  BEGIN OF GTY_PLSL,
    LGNUM    TYPE /SCWM/LGNUM,
    ENTITLED TYPE I_EWM_PHYSSTOCKPROD-ENTITLEDTODISPOSEPARTY,
    CAT      TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKTYPE,
    WERKS    TYPE WERKS_D,
    LGORT    TYPE LGORT_D,
  END OF GTY_PLSL,
  GTT_PLSL TYPE SORTED TABLE OF GTY_PLSL WITH UNIQUE KEY LGNUM ENTITLED CAT,

* Thuoc tinh lo
  BEGIN OF GTY_BATCH,
    MATNR   TYPE MATNR,
    CHARG   TYPE CHARG_D,
    WERKS   TYPE WERKS_D,
    QNDAT   TYPE DATS,
    LICHA   TYPE MCHA-LICHA,
    NSX_LOT TYPE ATWRT,
    NSX     TYPE CHAR60,
  END OF GTY_BATCH,
  GTT_BATCH TYPE SORTED TABLE OF GTY_BATCH WITH UNIQUE KEY MATNR CHARG,

* Khoa Bin / vat tu / lo dung de noi voi bang noi bo trong ABAP SQL
  BEGIN OF GTY_KEY,
    LGPLA TYPE /SCWM/LGPLA,
  END OF GTY_KEY,
  GTT_KEY TYPE SORTED TABLE OF GTY_KEY WITH UNIQUE KEY LGPLA,

  BEGIN OF GTY_BKEY,
    MATNR TYPE MATNR,
    CHARG TYPE CHARG_D,
  END OF GTY_BKEY,
  GTT_BKEY TYPE SORTED TABLE OF GTY_BKEY WITH UNIQUE KEY MATNR CHARG,

  GTT_LGTYP TYPE RANGE OF /SCWM/LGTYP.

CONSTANTS:
  GC_CONT_NAME TYPE SCRFNAME VALUE 'CC_MAIN'.

DATA:
  GT_LAY       TYPE GTT_LAY,
  GT_BIN       TYPE GTT_BIN,
  GT_LIST      TYPE GTT_OUT,                 " ket qua dang danh sach
  GT_STK       TYPE GTT_OUT,                 " ton cua Storage Type dang xem so do
  GT_VIEW      TYPE GTT_OUT,                 " ton cua o dang chon
  GT_CELL      TYPE GTT_CELL,
  GT_STAT      TYPE GTT_STAT,
  GT_WT        TYPE GTT_WT,                  " WT dang mo trong pham vi
  GT_HUC       TYPE GTT_OUT,                 " noi dung cua cac HU dang ve Bin (WT theo HU)
  GT_PLSL      TYPE GTT_PLSL,
  GT_BATCH     TYPE GTT_BATCH,
  GR_EXCL      TYPE GTT_LGTYP,               " Storage Type trung gian
  GV_TZ        TYPE TZNZONE,                 " mui gio cua Warehouse
  GV_LGTYP_MAP TYPE /SCWM/LGTYP,
  GV_SEL_LGPLA TYPE /SCWM/LGPLA,
  GV_FOUND_QTY TYPE MENGE_D,
  GV_FOUND_UOM TYPE MEINS,
  GV_FOUND_ONE TYPE ABAP_BOOL,               " ket qua tim theo dung 1 vat tu
  GV_UNIT_CV   TYPE MEINS,                   " DVT quy doi dang ap dung
  GV_NOT_CONV  TYPE I,                       " so vat tu khong co DVT quy doi
  GV_NOBIN     TYPE I,                       " so vi tri tren luoi khong co Bin
  GV_MAP_ACTIVE TYPE ABAP_BOOL,
  GV_DIRTY_MAP  TYPE ABAP_BOOL,
  GV_DIRTY_STAT TYPE ABAP_BOOL,
  GV_DIRTY_VIEW TYPE ABAP_BOOL,
  GV_UNIT_VIEW  TYPE MEINS,                    " DVT quy doi dang ap dung cho ALV o chon
  GV_CLICKED    TYPE ABAP_BOOL,                " vua nhap 1 o tren so do (khong chay lai tim)
  GV_OK         TYPE SY-UCOMM.

DATA:
  GO_CONT      TYPE REF TO CL_GUI_CUSTOM_CONTAINER,
  GO_SPLIT_H   TYPE REF TO CL_GUI_SPLITTER_CONTAINER,
  GO_SPLIT_V   TYPE REF TO CL_GUI_SPLITTER_CONTAINER,
  GO_CELL_MAP  TYPE REF TO CL_GUI_CONTAINER,
  GO_CELL_RGT  TYPE REF TO CL_GUI_CONTAINER,
  GO_CELL_STAT TYPE REF TO CL_GUI_CONTAINER,
  GO_CELL_QUAN TYPE REF TO CL_GUI_CONTAINER,
  GO_HTML      TYPE REF TO CL_GUI_HTML_VIEWER,
  GO_SALV_STAT TYPE REF TO CL_SALV_TABLE,
  GO_SALV_QUAN TYPE REF TO CL_SALV_TABLE.

* Bien tham chieu kieu cho select-options
DATA:
  GV_LGTYP TYPE /SCWM/LGTYP,
  GV_LGBER TYPE /SCWM/LGBER,
  GV_LGPLA TYPE /SCWM/LGPLA,
  GV_MATNR TYPE MATNR,
  GV_CHARG TYPE CHARG_D,
  GV_CAT   TYPE I_EWM_PHYSSTOCKPROD-EWMSTOCKTYPE,
  GV_WERKS TYPE WERKS_D,
  GV_LGORT TYPE LGORT_D,
  GV_HUID  TYPE I_EWM_PHYSSTOCKPROD-HANDLINGUNITNUMBER,
  GV_DATE  TYPE DATS.

*----------------------------------------------------------------------*
* Man hinh chon dieu kien
*----------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE GV_T1.
PARAMETERS:     P_LGNUM TYPE /SCWM/LGNUM OBLIGATORY.
SELECT-OPTIONS: S_LGTYP FOR GV_LGTYP,
                S_LGBER FOR GV_LGBER,
                S_LGPLA FOR GV_LGPLA,
                S_MATNR FOR GV_MATNR,
                S_CHARG FOR GV_CHARG,
                S_CAT   FOR GV_CAT,
                S_WERKS FOR GV_WERKS,
                S_LGORT FOR GV_LGORT,
                S_HUID  FOR GV_HUID,
                S_WDATU FOR GV_DATE,
                S_VFDAT FOR GV_DATE.
SELECTION-SCREEN END OF BLOCK B1.

SELECTION-SCREEN BEGIN OF BLOCK B2 WITH FRAME TITLE GV_T2.
PARAMETERS: P_LIST RADIOBUTTON GROUP G1 DEFAULT 'X',
            P_MAP  RADIOBUTTON GROUP G1.
SELECTION-SCREEN END OF BLOCK B2.

SELECTION-SCREEN BEGIN OF BLOCK B3 WITH FRAME TITLE GV_T3.
PARAMETERS: P_EXINT AS CHECKBOX DEFAULT 'X',
            P_EMPTY AS CHECKBOX,
            P_LOCK  AS CHECKBOX,
            P_BATCH AS CHECKBOX DEFAULT 'X',
            P_CONV  AS CHECKBOX USER-COMMAND UC1,
            P_MEINS TYPE MEINS MODIF ID CNV,
            P_VARI  TYPE DISVARIANT-VARIANT.
SELECTION-SCREEN END OF BLOCK B3.

*----------------------------------------------------------------------*
* Subscreen thanh dieu kien tim tren man hinh so do kho
*----------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF SCREEN 0110 AS SUBSCREEN.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 1(79) GV_INFO.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 1(11) TXT_SB FOR FIELD P_SBIN.
SELECTION-SCREEN POSITION 13.
PARAMETERS P_SBIN TYPE /SCWM/LGPLA VISIBLE LENGTH 14.
SELECTION-SCREEN COMMENT 30(8) TXT_SM FOR FIELD P_SMATNR.
SELECTION-SCREEN POSITION 39.
PARAMETERS P_SMATNR TYPE MATNR VISIBLE LENGTH 18.
SELECTION-SCREEN COMMENT 59(3) TXT_SL FOR FIELD P_SCHARG.
SELECTION-SCREEN POSITION 63.
PARAMETERS P_SCHARG TYPE CHARG_D VISIBLE LENGTH 10.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 1(11) TXT_SD FOR FIELD P_SDESC.
SELECTION-SCREEN POSITION 13.
PARAMETERS P_SDESC TYPE MAKT-MAKTX VISIBLE LENGTH 28.
SELECTION-SCREEN COMMENT 45(5) TXT_SS FOR FIELD P_SSTK.
SELECTION-SCREEN POSITION 51.
PARAMETERS P_SSTK TYPE C LENGTH 1.
SELECTION-SCREEN POSITION 53.
PARAMETERS P_SDOC TYPE C LENGTH 20 VISIBLE LENGTH 14.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 1(11) TXT_SU FOR FIELD P_SMEINS.
SELECTION-SCREEN POSITION 13.
PARAMETERS P_SMEINS TYPE MEINS.
SELECTION-SCREEN PUSHBUTTON 20(8) B_FIND USER-COMMAND FIND.
SELECTION-SCREEN PUSHBUTTON 30(10) B_REFR USER-COMMAND REFR.
SELECTION-SCREEN PUSHBUTTON 42(19) B_SWST USER-COMMAND SWST.
SELECTION-SCREEN PUSHBUTTON 63(17) B_LIST USER-COMMAND LIST.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF SCREEN 0110.
