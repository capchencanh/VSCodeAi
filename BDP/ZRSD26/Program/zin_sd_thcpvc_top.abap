*&---------------------------------------------------------------------*
*&  Include           ZIN_SD_THCPVC_TOP
*&---------------------------------------------------------------------*

TABLES: VBRK, VBRP, MARC.

TYPES: BEGIN OF GTY_ALV,
         VKGRP    TYPE VBRP-VKGRP,
         VKGRP_TX TYPE TVGRT-BEZEI,
         VKBUR    TYPE VBRP-VKBUR,
         VKBUR_TX TYPE TVKBT-BEZEI,
         KVGR2    TYPE VBRP-KVGR2,
         KVGR2_TX TYPE TVV2T-BEZEI,
         MFRGR    TYPE MARC-MFRGR,
         MFRGR_TX TYPE TMFGT-BEZEI,
         VTWEG    TYPE VBRK-VTWEG,
         VTWEG_TX TYPE TVTWT-VTEXT,
         DATE_FR  TYPE VBRK-FKDAT,
         DATE_TO  TYPE VBRK-FKDAT,
         NETWR    TYPE VBRP-NETWR,
         FREIGHT1 TYPE VBRP-NETWR,
         RATE1    TYPE C LENGTH 12,
         FREIGHT2 TYPE VBRP-NETWR,
         RATE2    TYPE C LENGTH 12,
         KZWI4    TYPE VBRP-NETWR,
         WAERK    TYPE VBRK-WAERK,
       END OF GTY_ALV,
       GTT_ALV TYPE STANDARD TABLE OF GTY_ALV WITH EMPTY KEY.

DATA GT_ALV TYPE GTT_ALV.

DATA:
  GC_SCRFNAME  TYPE SCRFNAME VALUE 'CONTAINER',
  GREF_ALV     TYPE REF TO CL_GUI_ALV_GRID,
  GC_CONTAINER TYPE REF TO CL_GUI_CUSTOM_CONTAINER.

DATA:
  GS_LAYOUT  TYPE LVC_S_LAYO,
  GT_FLDCAT  TYPE LVC_T_FCAT,
  GS_VARIANT TYPE DISVARIANT.

CONSTANTS:
  GC_KSCHL_FR1 TYPE PRCD_ELEMENTS-KSCHL VALUE 'ZFR1',
  GC_KSCHL_FR2 TYPE PRCD_ELEMENTS-KSCHL VALUE 'ZFR2',
* VBTYP O = hoa don tra hang, lay gia tri am
  GC_VBTYP_RET TYPE VBRK-VBTYP VALUE 'O'.

SELECTION-SCREEN BEGIN OF BLOCK BL1 WITH FRAME TITLE GV_BL1.
SELECT-OPTIONS: S_FKDAT FOR VBRK-FKDAT OBLIGATORY,
                S_FKART FOR VBRK-FKART OBLIGATORY,
                S_VKORG FOR VBRK-VKORG OBLIGATORY,
                S_VTWEG FOR VBRK-VTWEG,
                S_KUNAG FOR VBRK-KUNAG.
SELECTION-SCREEN END OF BLOCK BL1.

SELECTION-SCREEN BEGIN OF BLOCK BL2 WITH FRAME TITLE GV_BL2.
SELECT-OPTIONS: S_VKGRP FOR VBRP-VKGRP,
                S_VKBUR FOR VBRP-VKBUR,
                S_KVGR2 FOR VBRP-KVGR2,
                S_MFRGR FOR MARC-MFRGR.
SELECTION-SCREEN END OF BLOCK BL2.