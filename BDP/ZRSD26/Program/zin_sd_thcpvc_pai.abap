MODULE EXIT_COMMAND_0100 INPUT.

  CASE SY-UCOMM.
    WHEN '&F03' OR '&BACK' OR '&F12' OR '&F15'.
      LEAVE TO SCREEN 0.
  ENDCASE.

ENDMODULE.
