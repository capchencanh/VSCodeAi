{
  "mcpServers": {
    "GUI___KH___DEV__CLIENT__": {
      "command": "C:\\Citek\\vibing-steampunk\\vsp.exe",
      "args": [
        "--mode", "expert",
        "--language", "EN",
        "--keepalive", "5m",
        "--enable-transports",
        "--allow-transportable-edits", "--allowed-transports", "*",
        "--allowed-packages", "Z*,$TMP,$Z*",
        "--allowed-ops", "RSQFCUATLI",
        "--feature-hana", "on", "--feature-abapgit", "on", "--feature-rap", "on",
        "--feature-amdp", "on", "--feature-ui5", "on", "--feature-transport", "on"
      ],
      "env": {
        "SAP_URL": "https://__HOST__:__PORT__",
        "SAP_USER": "__SAP_USER__",
        "SAP_CLIENT": "__CLIENT__",
        "SAP_PASSWORD": ""
      }
    }
  }
}
